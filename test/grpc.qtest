%modern

%requires QUnit

%requires grpc
%requires Grpc

%exec-class GrpcTest

public class GrpcTest inherits QUnit::Test {
    private {
        string test_dir;
    }

    constructor() : Test("GrpcTest", "1.0") {
        # Find the test directory (where test.proto lives)
        test_dir = get_script_dir();

        # ProtobufSchema tests (Phase 3)
        addTestCase("schema loading from file", \testSchemaLoadFile());
        addTestCase("schema loading from string", \testSchemaLoadString());
        addTestCase("schema load invalid file", \testSchemaLoadInvalidFile());
        addTestCase("schema load malformed content", \testSchemaLoadMalformed());
        addTestCase("service discovery", \testServiceDiscovery());
        addTestCase("message type discovery", \testMessageTypeDiscovery());
        addTestCase("encode/decode simple message", \testEncodeDecodeSimple());
        addTestCase("encode/decode all scalar types", \testEncodeDecodeAllTypes());
        addTestCase("encode/decode nested message", \testEncodeDecodeNested());
        addTestCase("encode/decode repeated fields", \testEncodeDecodeRepeated());
        addTestCase("encode/decode map fields", \testEncodeDecodeMap());
        addTestCase("encode/decode oneof fields", \testEncodeDecodeOneof());
        addTestCase("encode/decode enum fields", \testEncodeDecodeEnum());
        addTestCase("encode/decode empty message", \testEncodeDecodeEmpty());
        addTestCase("encode/decode deep nesting", \testEncodeDecodeDeep());
        addTestCase("encode/decode unicode strings", \testEncodeDecodeUnicode());
        addTestCase("encode/decode binary with nulls", \testEncodeDecodeBinaryNulls());
        addTestCase("encode/decode large message", \testEncodeDecodeLarge());
        addTestCase("decode invalid type", \testDecodeInvalidType());
        addTestCase("encode unknown field", \testEncodeUnknownField());
        addTestCase("default message", \testDefaultMessage());
        addTestCase("JSON round-trip", \testJsonRoundTrip());
        addTestCase("JSON invalid input", \testJsonInvalidInput());

        # messageSchema tests
        addTestCase("messageSchema: simple message", \testMessageSchemaSimple());
        addTestCase("messageSchema: all scalar types", \testMessageSchemaAllTypes());
        addTestCase("messageSchema: nested message", \testMessageSchemaNested());
        addTestCase("messageSchema: repeated fields", \testMessageSchemaRepeated());
        addTestCase("messageSchema: map fields", \testMessageSchemaMap());
        addTestCase("messageSchema: enum fields", \testMessageSchemaEnum());
        addTestCase("messageSchema: oneof fields", \testMessageSchemaOneof());
        addTestCase("messageSchema: invalid type", \testMessageSchemaInvalid());

        # enumValues tests
        addTestCase("enumValues: valid enum", \testEnumValues());
        addTestCase("enumValues: missing enum", \testEnumValuesMissing());

        # Descriptor-based constructor tests
        addTestCase("descriptor constructor: valid", \testDescriptorConstructor());
        addTestCase("descriptor constructor: dependencies", \testDescriptorConstructorDeps());
        addTestCase("descriptor constructor: invalid", \testDescriptorConstructorInvalid());

        # GrpcHelper tests (Phase 4)
        addTestCase("framing: frame and unframe", \testFrameUnframe());
        addTestCase("framing: empty message", \testFrameEmpty());
        addTestCase("framing: compressed flag", \testFrameCompressed());
        addTestCase("framing: large message", \testFrameLarge());
        addTestCase("framing: unframe too short", \testUnframeTooShort());
        addTestCase("framing: unframe truncated", \testUnframeTruncated());
        addTestCase("timeout formatting", \testTimeoutFormat());
        addTestCase("timeout parsing", \testTimeoutParse());
        addTestCase("request headers", \testBuildRequestHeaders());

        # GrpcClient tests (Phase 4)
        addTestCase("client: constructor validates service", \testClientConstructor());
        addTestCase("client: invalid service", \testClientInvalidService());
        addTestCase("client: invalid method", \testClientInvalidMethod());

        # GrpcServer tests (Phase 4)
        addTestCase("server: register handler", \testServerRegisterHandler());
        addTestCase("server: invalid handler registration", \testServerInvalidHandler());
        addTestCase("server: bind and port", \testServerBindPort());
        addTestCase("server: double start error", \testServerDoubleStart());

        # Integration tests (Phase 4)
        addTestCase("integration: unary call", \testUnaryCall());
        addTestCase("integration: unary call with metadata", \testUnaryCallMetadata());
        addTestCase("integration: handler exception", \testHandlerException());
        addTestCase("integration: unimplemented method", \testUnimplementedMethod());
        addTestCase("integration: empty request/response", \testEmptyRequestResponse());
        addTestCase("integration: multiple sequential calls", \testMultipleSequentialCalls());
        addTestCase("integration: concurrent calls", \testConcurrentCalls());

        # Streaming tests (Phase 5)
        addTestCase("helper: unframe multiple messages", \testUnframeMessages());
        addTestCase("helper: next frame size", \testNextFrameSize());
        addTestCase("streaming: server stream", \testServerStream());
        addTestCase("streaming: client stream", \testClientStream());
        addTestCase("streaming: bidi stream", \testBidiStream());
        addTestCase("streaming: server stream cancel", \testServerStreamCancel());
        addTestCase("streaming: empty server stream", \testEmptyServerStream());

        # Live streaming tests (Phase 7)
        addTestCase("live streaming: bidi interactive", \testBidiInteractiveLive());
        addTestCase("live streaming: bidi multiple messages", \testBidiLiveMultipleMessages());
        addTestCase("live streaming: client stream", \testClientStreamLive());
        addTestCase("live streaming: bidi timeout", \testBidiLiveTimeout());
        addTestCase("live streaming: server stream after client done",
            \testBidiLiveServerStreamAfterClientDone());
        addTestCase("live streaming: readsDone", \testBidiLiveReadsDone());

        # TLS tests (Phase 6)
        addTestCase("tls: secure server and client", \testTlsSecure());

        # Metadata tests (Phase 6)
        addTestCase("metadata: server trailing metadata (streaming)",
            \testServerTrailingMetadata());
        addTestCase("metadata: server initial metadata (streaming)",
            \testServerInitialMetadata());
        addTestCase("metadata: trailing metadata in unary",
            \testUnaryTrailingMetadata());

        # Timeout/deadline tests (Phase 6)
        addTestCase("timeout: deadline not exceeded", \testDeadlineNotExceeded());
        addTestCase("timeout: deadline exceeded", \testDeadlineExceeded());
        addTestCase("timeout: deadline exceeded streaming",
            \testDeadlineExceededStreaming());
        addTestCase("timeout: grpc-timeout not leaked to handler metadata",
            \testTimeoutNotLeakedToMetadata());

        # API getter tests
        addTestCase("client: getSchema returns schema", \testClientGetSchema());
        addTestCase("channel: target returns URL", \testChannelTarget());
        addTestCase("channel: getConnectionManager", \testChannelGetConnectionManager());
        addTestCase("server stream: clientMetadata", \testServerStreamClientMetadata());

        # Transport error tests
        addTestCase("client: connection refused", \testConnectionRefused());

        set_return_value(main());
    }

    testSchemaLoadFile() {
        ProtobufSchema schema(test_dir, "test.proto");
        list<string> types = schema.messageTypes();
        assertTrue(types.size() > 0, "should have message types");
    }

    testSchemaLoadString() {
        string proto = "syntax = \"proto3\";\nmessage Msg { string text = 1; int32 count = 2; }";
        ProtobufSchema schema(proto);
        list<string> types = schema.messageTypes();
        assertEq(("Msg",), types, "should find Msg type");
    }

    testSchemaLoadInvalidFile() {
        assertThrows("PROTOBUF-SCHEMA-ERROR", sub() {
            ProtobufSchema schema("/nonexistent/path", "missing.proto");
        });
    }

    testSchemaLoadMalformed() {
        assertThrows("PROTOBUF-SCHEMA-ERROR", sub() {
            ProtobufSchema schema("this is not valid proto content");
        });
    }

    testServiceDiscovery() {
        ProtobufSchema schema(test_dir, "test.proto");
        list<hash<GrpcServiceInfo>> services = schema.services();
        assertEq(1, services.size(), "should have 1 service");
        assertEq("TestService", services[0].name, "service name");
        assertEq(4, services[0].methods.size(), "should have 4 methods");

        # Check unary method
        hash<GrpcMethodInfo> unary = services[0].methods[0];
        assertEq("UnaryCall", unary.name, "unary method name");
        assertEq("/test.TestService/UnaryCall", unary.full_path, "unary full path");
        assertEq("test.SimpleRequest", unary.input_type, "unary input type");
        assertEq("test.SimpleResponse", unary.output_type, "unary output type");
        assertFalse(unary.client_streaming, "unary: no client streaming");
        assertFalse(unary.server_streaming, "unary: no server streaming");

        # Check server streaming
        hash<GrpcMethodInfo> server_stream = services[0].methods[1];
        assertFalse(server_stream.client_streaming, "server stream: no client streaming");
        assertTrue(server_stream.server_streaming, "server stream: server streaming");

        # Check client streaming
        hash<GrpcMethodInfo> client_stream = services[0].methods[2];
        assertTrue(client_stream.client_streaming, "client stream: client streaming");
        assertFalse(client_stream.server_streaming, "client stream: no server streaming");

        # Check bidi streaming
        hash<GrpcMethodInfo> bidi = services[0].methods[3];
        assertTrue(bidi.client_streaming, "bidi: client streaming");
        assertTrue(bidi.server_streaming, "bidi: server streaming");
    }

    testMessageTypeDiscovery() {
        ProtobufSchema schema(test_dir, "test.proto");
        list<string> types = schema.messageTypes();
        assertTrue(types.size() >= 10, "should have many message types");
        assertTrue(inlist("test.SimpleRequest", types), "should contain SimpleRequest");
        assertTrue(inlist("test.SimpleResponse", types), "should contain SimpleResponse");
        assertTrue(inlist("test.AllTypesMessage", types), "should contain AllTypesMessage");
    }

    testEncodeDecodeSimple() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {"name": "hello", "id": 42};
        binary data = schema.encode("test.SimpleRequest", original);
        assertTrue(data.size() > 0, "encoded data should be non-empty");

        hash<auto> decoded = schema.decode("test.SimpleRequest", data);
        assertEq("hello", decoded.name, "name field");
        assertEq(42, decoded.id, "id field");
    }

    testEncodeDecodeAllTypes() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {
            "double_val": 3.14159,
            "float_val": 2.5,
            "int32_val": -100,
            "int64_val": -9999999999,
            "uint32_val": 4000000000,
            "uint64_val": 9000000000000000000,
            "sint32_val": -500,
            "sint64_val": -123456789012,
            "fixed32_val": 12345,
            "fixed64_val": 9876543210,
            "sfixed32_val": -12345,
            "sfixed64_val": -9876543210,
            "bool_val": True,
            "string_val": "test string",
            "bytes_val": <deadbeef>,
        };

        binary data = schema.encode("test.AllTypesMessage", original);
        hash<auto> decoded = schema.decode("test.AllTypesMessage", data);

        # Float comparison with tolerance
        assertTrue(abs(decoded.double_val - 3.14159) < 0.0001, "double value");
        assertTrue(abs(decoded.float_val - 2.5) < 0.001, "float value");
        assertEq(-100, decoded.int32_val, "int32 value");
        assertEq(-9999999999, decoded.int64_val, "int64 value");
        assertEq(True, decoded.bool_val, "bool value");
        assertEq("test string", decoded.string_val, "string value");
        assertEq(<deadbeef>, decoded.bytes_val, "bytes value");
    }

    testEncodeDecodeNested() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {
            "outer_field": "outer",
            "inner": {
                "value": "inner_val",
                "count": 99,
            },
        };

        binary data = schema.encode("test.NestedMessage", original);
        hash<auto> decoded = schema.decode("test.NestedMessage", data);

        assertEq("outer", decoded.outer_field, "outer field");
        assertEq("inner_val", decoded.inner.value, "nested value");
        assertEq(99, decoded.inner.count, "nested count");
    }

    testEncodeDecodeRepeated() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {
            "tags": ("tag1", "tag2", "tag3"),
            "numbers": (10, 20, 30),
            "items": (
                {"value": "item1", "count": 1},
                {"value": "item2", "count": 2},
            ),
        };

        binary data = schema.encode("test.RepeatedMessage", original);
        hash<auto> decoded = schema.decode("test.RepeatedMessage", data);

        assertEq(("tag1", "tag2", "tag3"), decoded.tags, "repeated strings");
        assertEq((10, 20, 30), decoded.numbers, "repeated ints");
        assertEq(2, decoded.items.size(), "repeated messages count");
        assertEq("item1", decoded.items[0].value, "repeated message field");
    }

    testEncodeDecodeMap() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {
            "string_map": {"key1": "val1", "key2": "val2"},
            "int_map": {"x": 1, "y": 2},
        };

        binary data = schema.encode("test.MapMessage", original);
        hash<auto> decoded = schema.decode("test.MapMessage", data);

        assertEq("val1", decoded.string_map.key1, "map string value");
        assertEq("val2", decoded.string_map.key2, "map string value 2");
        assertEq(1, decoded.int_map.x, "map int value");
    }

    testEncodeDecodeOneof() {
        ProtobufSchema schema(test_dir, "test.proto");

        # Test with text variant
        hash<auto> with_text = {"name": "test", "text": "hello"};
        binary data = schema.encode("test.OneofMessage", with_text);
        hash<auto> decoded = schema.decode("test.OneofMessage", data);
        assertEq("hello", decoded.text, "oneof text value");

        # Test with number variant
        hash<auto> with_number = {"name": "test", "number": 42};
        data = schema.encode("test.OneofMessage", with_number);
        decoded = schema.decode("test.OneofMessage", data);
        assertEq(42, decoded.number, "oneof number value");
    }

    testEncodeDecodeEnum() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {"name": "test", "status": 1}; # ACTIVE
        binary data = schema.encode("test.EnumMessage", original);
        hash<auto> decoded = schema.decode("test.EnumMessage", data);
        assertEq(1, decoded.status, "enum value");
    }

    testEncodeDecodeEmpty() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {};
        binary data = schema.encode("test.EmptyMessage", original);
        hash<auto> decoded = schema.decode("test.EmptyMessage", data);
        assertEq({}, decoded, "empty message");
    }

    testEncodeDecodeDeep() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {
            "level1": {
                "level2": {
                    "level3": {
                        "deep_value": "found it",
                    },
                },
            },
        };

        binary data = schema.encode("test.DeepMessage", original);
        hash<auto> decoded = schema.decode("test.DeepMessage", data);
        assertEq("found it", decoded.level1.level2.level3.deep_value, "deep nested value");
    }

    testEncodeDecodeUnicode() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {"name": "hello"};
        binary data = schema.encode("test.SimpleRequest", original);
        hash<auto> decoded = schema.decode("test.SimpleRequest", data);
        assertEq("hello", decoded.name, "unicode string");
    }

    testEncodeDecodeBinaryNulls() {
        ProtobufSchema schema(test_dir, "test.proto");
        binary bin_with_nulls = <0001020300050607>;
        hash<auto> original = {"bytes_val": bin_with_nulls};
        binary data = schema.encode("test.AllTypesMessage", original);
        hash<auto> decoded = schema.decode("test.AllTypesMessage", data);
        assertEq(bin_with_nulls, decoded.bytes_val, "binary with null bytes");
    }

    testEncodeDecodeLarge() {
        ProtobufSchema schema(test_dir, "test.proto");
        # Create a large string (>1MB)
        string large = strmul("x", 1048576);
        hash<auto> original = {"name": large};
        binary data = schema.encode("test.SimpleRequest", original);
        hash<auto> decoded = schema.decode("test.SimpleRequest", data);
        assertEq(1048576, decoded.name.size(), "large string size preserved");
    }

    testDecodeInvalidType() {
        ProtobufSchema schema(test_dir, "test.proto");
        assertThrows("PROTOBUF-TYPE-ERROR", sub() {
            schema.decode("test.NonExistentType", <00>);
        });
    }

    testEncodeUnknownField() {
        ProtobufSchema schema(test_dir, "test.proto");
        assertThrows("PROTOBUF-FIELD-ERROR", sub() {
            schema.encode("test.SimpleRequest", {"unknown_field": "value"});
        });
    }

    testDefaultMessage() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> defaults = schema.defaultMessage("test.SimpleRequest");
        assertEq("", defaults.name, "default string is empty");
        assertEq(0, defaults.id, "default int is 0");
    }

    testJsonRoundTrip() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> original = {"name": "json test", "id": 123};
        string json = schema.toJson("test.SimpleRequest", original);
        assertTrue(json.size() > 0, "JSON should be non-empty");

        hash<auto> decoded = schema.fromJson("test.SimpleRequest", json);
        assertEq("json test", decoded.name, "JSON round-trip name");
        assertEq(123, decoded.id, "JSON round-trip id");
    }

    testJsonInvalidInput() {
        ProtobufSchema schema(test_dir, "test.proto");
        assertThrows("PROTOBUF-JSON-ERROR", sub() {
            schema.fromJson("test.SimpleRequest", "not valid json{{{");
        });
    }

    # --- messageSchema tests ---

    testMessageSchemaSimple() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.SimpleRequest");
        assertEq("test.SimpleRequest", info.name, "message name");
        assertEq(2, info.fields.size(), "field count");

        # Check name field
        assertEq("string", info.fields.name.type, "name field type");
        assertEq(1, info.fields.name.number, "name field number");
        assertEq("optional", info.fields.name.label, "name field label");

        # Check id field
        assertEq("int32", info.fields.id.type, "id field type");
        assertEq(2, info.fields.id.number, "id field number");
    }

    testMessageSchemaAllTypes() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.AllTypesMessage");
        assertEq("test.AllTypesMessage", info.name, "message name");
        assertEq(15, info.fields.size(), "field count");

        assertEq("double", info.fields.double_val.type, "double type");
        assertEq("float", info.fields.float_val.type, "float type");
        assertEq("int32", info.fields.int32_val.type, "int32 type");
        assertEq("int64", info.fields.int64_val.type, "int64 type");
        assertEq("uint32", info.fields.uint32_val.type, "uint32 type");
        assertEq("uint64", info.fields.uint64_val.type, "uint64 type");
        assertEq("sint32", info.fields.sint32_val.type, "sint32 type");
        assertEq("sint64", info.fields.sint64_val.type, "sint64 type");
        assertEq("fixed32", info.fields.fixed32_val.type, "fixed32 type");
        assertEq("fixed64", info.fields.fixed64_val.type, "fixed64 type");
        assertEq("sfixed32", info.fields.sfixed32_val.type, "sfixed32 type");
        assertEq("sfixed64", info.fields.sfixed64_val.type, "sfixed64 type");
        assertEq("bool", info.fields.bool_val.type, "bool type");
        assertEq("string", info.fields.string_val.type, "string type");
        assertEq("bytes", info.fields.bytes_val.type, "bytes type");
    }

    testMessageSchemaNested() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.NestedMessage");
        assertEq("test.NestedMessage", info.name, "message name");

        assertEq("string", info.fields.outer_field.type, "outer field type");
        assertEq("message", info.fields.inner.type, "inner field type");
        assertEq("test.NestedMessage.Inner", info.fields.inner.message_type,
            "inner message type");
    }

    testMessageSchemaRepeated() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.RepeatedMessage");

        assertEq("string", info.fields.tags.type, "tags field type");
        assertEq("repeated", info.fields.tags.label, "tags label is repeated");
        assertEq("int32", info.fields.numbers.type, "numbers field type");
        assertEq("repeated", info.fields.numbers.label, "numbers label is repeated");
        assertEq("message", info.fields.items.type, "items field type");
        assertEq("repeated", info.fields.items.label, "items label is repeated");
    }

    testMessageSchemaMap() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.MapMessage");

        assertEq("map", info.fields.string_map.type, "string_map type");
        assertEq("string", info.fields.string_map.key_type, "string_map key type");
        assertEq("string", info.fields.string_map.value_type, "string_map value type");

        assertEq("map", info.fields.int_map.type, "int_map type");
        assertEq("string", info.fields.int_map.key_type, "int_map key type");
        assertEq("int32", info.fields.int_map.value_type, "int_map value type");

        assertEq("map", info.fields.int_key_map.type, "int_key_map type");
        assertEq("int32", info.fields.int_key_map.key_type, "int_key_map key type");
        assertEq("string", info.fields.int_key_map.value_type, "int_key_map value type");
    }

    testMessageSchemaEnum() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.EnumMessage");

        assertEq("enum", info.fields.status.type, "status field type");
        assertEq("test.Status", info.fields.status.enum_type, "enum type name");

        hash<auto> enum_vals = info.fields.status.enum_values;
        assertEq(0, enum_vals.UNKNOWN, "UNKNOWN value");
        assertEq(1, enum_vals.ACTIVE, "ACTIVE value");
        assertEq(2, enum_vals.INACTIVE, "INACTIVE value");
        assertEq(3, enum_vals.DELETED, "DELETED value");
    }

    testMessageSchemaOneof() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<auto> info = schema.messageSchema("test.OneofMessage");

        # name field is not in a oneof
        assertFalse(exists info.fields.name.oneof, "name not in oneof");

        # text, number, flag are in the "value" oneof
        assertEq("value", info.fields.text.oneof, "text in value oneof");
        assertEq("value", info.fields.number.oneof, "number in value oneof");
        assertEq("value", info.fields.flag.oneof, "flag in value oneof");
    }

    testMessageSchemaInvalid() {
        ProtobufSchema schema(test_dir, "test.proto");
        assertThrows("PROTOBUF-TYPE-ERROR", sub() {
            schema.messageSchema("test.NonExistentType");
        });
    }

    # --- enumValues tests ---

    testEnumValues() {
        ProtobufSchema schema(test_dir, "test.proto");
        hash<string, int> values = schema.enumValues("test.Status");
        assertEq(4, values.size(), "enum value count");
        assertEq(0, values.UNKNOWN, "UNKNOWN");
        assertEq(1, values.ACTIVE, "ACTIVE");
        assertEq(2, values.INACTIVE, "INACTIVE");
        assertEq(3, values.DELETED, "DELETED");
    }

    testEnumValuesMissing() {
        ProtobufSchema schema(test_dir, "test.proto");
        assertThrows("PROTOBUF-TYPE-ERROR", sub() {
            schema.enumValues("test.NonExistentEnum");
        });
    }

    # --- Descriptor constructor tests ---

    testDescriptorConstructor() {
        # Build a schema from a .proto file, then serialize its FileDescriptorProto,
        # and construct a new schema from the serialized data
        string proto_content = "syntax = \"proto3\";\n"
            + "package desctest;\n"
            + "message Msg { string text = 1; int32 count = 2; }\n"
            + "service Svc { rpc Call (Msg) returns (Msg); }\n";

        ProtobufSchema original(proto_content);

        # Encode a test message with the original schema
        binary encoded = original.encode("desctest.Msg", {"text": "hello", "count": 42});

        # Get the serialized FileDescriptorProto by encoding the proto content,
        # then building a new schema from it using the proto compiler API.
        # For this test, we use the Qore encode/decode to validate consistency:
        # construct a second schema from the same content and verify they produce
        # identical results
        ProtobufSchema copy(proto_content);
        hash<auto> decoded = copy.decode("desctest.Msg", encoded);
        assertEq("hello", decoded.text, "round-trip text");
        assertEq(42, decoded.count, "round-trip count");
    }

    testDescriptorConstructorDeps() {
        # Test with a schema that has no dependencies (basic case)
        string proto_content = "syntax = \"proto3\";\n"
            + "package deptest;\n"
            + "message Req { string name = 1; }\n"
            + "message Resp { string greeting = 1; }\n"
            + "service Greeter { rpc Hello (Req) returns (Resp); }\n";

        ProtobufSchema schema(proto_content);
        list<hash<GrpcServiceInfo>> services = schema.services();
        assertEq(1, services.size(), "service count");
        assertEq("Greeter", services[0].name, "service name");
    }

    testDescriptorConstructorInvalid() {
        # Empty list should fail
        assertThrows("PROTOBUF-SCHEMA-ERROR", sub() {
            list<binary> empty_list = ();
            ProtobufSchema schema(empty_list);
        });

        # Invalid protobuf data should fail
        assertThrows("PROTOBUF-SCHEMA-ERROR", sub() {
            list<binary> bad_list = (<0102030405>,);
            ProtobufSchema schema(bad_list);
        });
    }

    # --- GrpcHelper tests ---

    testFrameUnframe() {
        binary payload = binary("hello-grpc");
        binary framed = GrpcHelper::frameMessage(payload);

        # 5-byte header + payload
        assertEq(5 + payload.size(), framed.size(), "framed size");

        # First byte is compressed flag (0)
        assertEq(0, framed[0], "compressed flag is 0");

        # Bytes 1-4 are big-endian length
        int len = (framed[1] << 24) | (framed[2] << 16) | (framed[3] << 8) | framed[4];
        assertEq(payload.size(), len, "length field");

        # Round-trip
        hash<auto> result = GrpcHelper::unframeMessage(framed);
        assertFalse(result.compressed, "not compressed");
        assertEq(payload, result.data, "payload round-trip");
    }

    testFrameEmpty() {
        binary empty = binary();
        binary framed = GrpcHelper::frameMessage(empty);
        assertEq(5, framed.size(), "empty frame is 5 bytes");

        hash<auto> result = GrpcHelper::unframeMessage(framed);
        assertFalse(result.compressed, "not compressed");
        assertEq(0, result.data.size(), "empty payload");
    }

    testFrameCompressed() {
        binary payload = binary("data");
        binary framed = GrpcHelper::frameMessage(payload, True);
        assertEq(1, framed[0], "compressed flag is 1");

        hash<auto> result = GrpcHelper::unframeMessage(framed);
        assertTrue(result.compressed, "compressed flag set");
        assertEq(payload, result.data, "payload matches");
    }

    testFrameLarge() {
        # Create a payload > 65535 bytes to test multi-byte length encoding
        binary payload = binary(strmul("x", 100000));
        binary framed = GrpcHelper::frameMessage(payload);

        hash<auto> result = GrpcHelper::unframeMessage(framed);
        assertEq(100000, result.data.size(), "large payload size");
    }

    testUnframeTooShort() {
        assertThrows("GRPC-FRAMING-ERROR", sub() {
            GrpcHelper::unframeMessage(<0001>);
        });
    }

    testUnframeTruncated() {
        # Header says 100 bytes but only 5 available
        assertThrows("GRPC-FRAMING-ERROR", sub() {
            GrpcHelper::unframeMessage(<0000000064AABBCC>);
        });
    }

    testTimeoutFormat() {
        assertEq("5000m", GrpcHelper::formatTimeout(5000), "5s in ms");
        assertEq("100m", GrpcHelper::formatTimeout(100), "100ms");
        assertEq("100000S", GrpcHelper::formatTimeout(100000000), "large timeout in seconds");
    }

    testTimeoutParse() {
        assertEq(5000, GrpcHelper::parseTimeout("5000m"), "5000ms");
        assertEq(5000, GrpcHelper::parseTimeout("5S"), "5 seconds");
        assertEq(60000, GrpcHelper::parseTimeout("1M"), "1 minute");
        assertEq(3600000, GrpcHelper::parseTimeout("1H"), "1 hour");
        assertNothing(GrpcHelper::parseTimeout(""), "empty string");
        assertNothing(GrpcHelper::parseTimeout("X"), "invalid unit");
    }

    testBuildRequestHeaders() {
        hash<string, string> headers = GrpcHelper::buildRequestHeaders("/test.Svc/Method");
        assertEq("application/grpc+proto", headers."content-type", "content-type header");
        assertEq("trailers", headers.te, "te header");

        # With options
        hash<GrpcCallOptions> opts = <GrpcCallOptions>{
            "timeout_ms": 5000,
            "metadata": {"x-custom": "value"},
        };
        headers = GrpcHelper::buildRequestHeaders("/test.Svc/Method", opts);
        assertEq("5000m", headers."grpc-timeout", "grpc-timeout header");
        assertEq("value", headers."x-custom", "custom metadata header");
    }

