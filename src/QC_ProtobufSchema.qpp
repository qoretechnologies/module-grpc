#include "QC_ProtobufSchema.h"
#include "QoreProtobufSchema.h"

/** @defgroup grpc_status_codes gRPC Status Codes
    These constants define the standard gRPC status codes.

    @see https://grpc.github.io/grpc/core/md_doc_statuscodes.html
*/
///@{
//! The operation completed successfully
const GRPC_STATUS_OK = 0;

//! The operation was cancelled (typically by the caller)
const GRPC_STATUS_CANCELLED = 1;

//! Unknown error
const GRPC_STATUS_UNKNOWN = 2;

//! The client specified an invalid argument
const GRPC_STATUS_INVALID_ARGUMENT = 3;

//! The deadline expired before the operation could complete
const GRPC_STATUS_DEADLINE_EXCEEDED = 4;

//! The requested entity was not found
const GRPC_STATUS_NOT_FOUND = 5;

//! The entity already exists
const GRPC_STATUS_ALREADY_EXISTS = 6;

//! The caller does not have permission to execute the operation
const GRPC_STATUS_PERMISSION_DENIED = 7;

//! Some resource has been exhausted
const GRPC_STATUS_RESOURCE_EXHAUSTED = 8;

//! The system is not in a state required for the operation
const GRPC_STATUS_FAILED_PRECONDITION = 9;

//! The operation was aborted
const GRPC_STATUS_ABORTED = 10;

//! The operation was attempted past the valid range
const GRPC_STATUS_OUT_OF_RANGE = 11;

//! The operation is not implemented or not supported
const GRPC_STATUS_UNIMPLEMENTED = 12;

//! Internal error
const GRPC_STATUS_INTERNAL = 13;

//! The service is currently unavailable
const GRPC_STATUS_UNAVAILABLE = 14;

//! Unrecoverable data loss or corruption
const GRPC_STATUS_DATA_LOSS = 15;

//! The request does not have valid authentication credentials
const GRPC_STATUS_UNAUTHENTICATED = 16;
///@}

//! Information about a gRPC method in a service
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcMethodInfo {
    //! The method name (e.g., "SayHello")
    string name;

    //! The full gRPC path (e.g., "/helloworld.Greeter/SayHello")
    string full_path;

    //! The fully-qualified input message type name
    string input_type;

    //! The fully-qualified output message type name
    string output_type;

    //! True if the client sends a stream of messages
    bool client_streaming;

    //! True if the server sends a stream of messages
    bool server_streaming;
}

//! Information about a gRPC service
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcServiceInfo {
    //! The service name (e.g., "Greeter")
    string name;

    //! The methods defined in this service
    list<hash<Qore::Grpc::GrpcMethodInfo>> methods;
}

//! Options for a gRPC call
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcCallOptions {
    //! Timeout in milliseconds
    *int timeout_ms;

    //! Metadata key-value pairs to send with the call
    *hash<string, string> metadata;

    //! Compression algorithm name (e.g., "gzip", "deflate")
    *string compression;
}

//! Result of a gRPC call
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcCallResult {
    //! The response body as a Qore hash
    hash<auto> body;

    //! The gRPC status code (one of @ref grpc_status_codes)
    int status_code;

    //! The gRPC status message
    string status_message;

    //! Trailing metadata from the server
    hash<string, string> trailing_metadata;

    //! Initial metadata from the server
    hash<string, string> initial_metadata;
}

//! SSL/TLS options for gRPC connections
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcSslOptions {
    //! PEM-encoded root CA certificates
    *string root_certs;

    //! PEM-encoded client certificate for mutual TLS
    *string client_cert;

    //! PEM-encoded client private key for mutual TLS
    *string client_key;

    //! PEM-encoded server certificate
    *string server_cert;

    //! PEM-encoded server private key
    *string server_key;

    //! If True, require client certificate for mutual TLS (server-side)
    *bool require_client_auth;
}

//! Options for a gRPC channel
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcChannelOptions {
    //! Maximum message size in bytes (0 = unlimited)
    *int max_message_size;

    //! SSL/TLS options
    *hash<Qore::Grpc::GrpcSslOptions> ssl;

    //! Default compression algorithm
    *string default_compression;

    //! If True, enable keepalive pings
    *bool keepalive;

    //! Keepalive interval in milliseconds
    *int keepalive_time_ms;
}

//! Options for a gRPC server
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcServerOptions {
    //! Maximum message size in bytes (0 = unlimited)
    *int max_message_size;

    //! Enable gRPC server reflection (grpc.reflection.v1) for client service discovery
    /** When True, the server automatically registers the standard gRPC server reflection
        service, allowing clients to discover services without local \c .proto files.

        This is equivalent to calling @ref Grpc::GrpcReflectionService "GrpcReflectionService"
        manually but requires no additional code.

        @par Example:
        @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
GrpcServer server(schema, <GrpcServerOptions>{"enable_reflection": True});
server.registerHandler("MyService", "SayHello",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        return {"message": "Hello, " + request.name};
    });
server.addInsecurePort("localhost:50051");
server.start();
        @endcode

        @since %grpc 1.0
    */
    *bool enable_reflection;
}

//! The ProtobufSchema class provides dynamic protobuf schema loading and message encoding/decoding
/**
    @par Example: Loading a schema and encoding/decoding messages
    @code{.py}
#!/usr/bin/qore

%requires grpc

# Load schema from file
ProtobufSchema schema("./proto/", "service.proto");

# List services and message types
list<hash<GrpcServiceInfo>> services = schema.services();
list<string> types = schema.messageTypes();

# Encode a message
binary data = schema.encode("helloworld.HelloRequest", {"name": "World"});

# Decode a message
hash<auto> msg = schema.decode("helloworld.HelloReply", data);
    @endcode

    @par Example: Loading schema from a string
    @code{.py}
string proto = "syntax = \"proto3\";
message Msg { string text = 1; int32 count = 2; }";

ProtobufSchema schema(proto);
binary data = schema.encode("Msg", {"text": "hello", "count": 42});
hash<auto> result = schema.decode("Msg", data);
    @endcode

    @since %grpc 1.0
*/
qclass ProtobufSchema [arg=QoreProtobufSchema* schema; ns=Qore::Grpc; dom=FILESYSTEM];

//! Creates a ProtobufSchema from a \c .proto file on the filesystem
/** @param path the directory path for \c .proto file imports
    @param proto_file the \c .proto file name to load

    @throw PROTOBUF-SCHEMA-ERROR if the file cannot be loaded or parsed

    @par Example:
    @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
    @endcode

    @since %grpc 1.0
*/
ProtobufSchema::constructor(string path, string proto_file) {
    self->setPrivate(CID_PROTOBUFSCHEMA,
        new QoreProtobufSchema(path->c_str(), proto_file->c_str(), xsink));
}

//! Creates a ProtobufSchema from a proto definition string
/** @param proto_content the \c .proto file content as a string
    @param filename optional filename for error messages (defaults to "input.proto")

    @throw PROTOBUF-SCHEMA-ERROR if the content cannot be parsed

    @par Example:
    @code{.py}
string proto = "syntax = \"proto3\";\nmessage Msg { string text = 1; }";
ProtobufSchema schema(proto);
    @endcode

    @since %grpc 1.0
*/
ProtobufSchema::constructor(string proto_content, *string filename) {
    self->setPrivate(CID_PROTOBUFSCHEMA,
        new QoreProtobufSchema(*proto_content, filename ? filename->c_str() : nullptr, xsink));
}

//! Creates a ProtobufSchema from serialized \c FileDescriptorProto data
/** Used with gRPC server reflection -- the reflection service returns
    serialized \c FileDescriptorProto bytes for discovered services.

    @param serialized_descriptors a list of binary data, each element containing one
        serialized \c FileDescriptorProto message
    @throw PROTOBUF-SCHEMA-ERROR if deserialization or schema building fails

    @par Example:
    @code{.py}
# Build from serialized descriptors (e.g. from gRPC reflection)
list<binary> descriptors = reflection_client.getFileDescriptors();
ProtobufSchema schema(descriptors);
    @endcode

    @since %grpc 1.0
*/
ProtobufSchema::constructor(list<binary> serialized_descriptors) {
    self->setPrivate(CID_PROTOBUFSCHEMA,
        new QoreProtobufSchema(serialized_descriptors, xsink));
}

//! Returns a list of service definitions from the schema
/** @return a list of @ref GrpcServiceInfo hashdecls

    @par Example:
    @code{.py}
list<hash<GrpcServiceInfo>> services = schema.services();
for (hash<GrpcServiceInfo> svc in services) {
    printf("Service: %s\n", svc.name);
    for (hash<GrpcMethodInfo> m in svc.methods) {
        printf("  Method: %s %s -> %s\n", m.name, m.input_type, m.output_type);
    }
}
    @endcode

    @since %grpc 1.0
*/
list<hash<GrpcServiceInfo>> ProtobufSchema::services() {
    return schema->getServices(xsink);
}

//! Returns a list of top-level message type names
/** @return a list of fully-qualified message type names

    @par Example:
    @code{.py}
list<string> types = schema.messageTypes();
    @endcode

    @since %grpc 1.0
*/
list<string> ProtobufSchema::messageTypes() {
    return schema->getMessageTypes(xsink);
}

//! Returns a default (zero-valued) message as a Qore hash
/** @param type the fully-qualified message type name
    @return a hash with all fields set to their default values

    @throw PROTOBUF-TYPE-ERROR if the message type is not found

    @par Example:
    @code{.py}
hash<auto> defaults = schema.defaultMessage("helloworld.HelloRequest");
    @endcode

    @since %grpc 1.0
*/
hash<auto> ProtobufSchema::defaultMessage(string type) {
    return schema->getDefaultMessage(type->c_str(), xsink);
}

//! Encodes a Qore hash as a protobuf binary message
/** @param type the fully-qualified message type name
    @param data the hash to encode

    @return the protobuf-encoded binary data

    @throw PROTOBUF-TYPE-ERROR if the message type is not found
    @throw PROTOBUF-FIELD-ERROR if a hash key doesn't match a field
    @throw PROTOBUF-ENCODE-ERROR if serialization fails

    @par Example:
    @code{.py}
binary data = schema.encode("helloworld.HelloRequest", {"name": "World"});
    @endcode

    @since %grpc 1.0
*/
binary ProtobufSchema::encode(string type, hash<auto> data) {
    return schema->encode(type->c_str(), data, xsink);
}

//! Decodes protobuf binary data to a Qore hash
/** @param type the fully-qualified message type name
    @param data the protobuf-encoded binary data

    @return the decoded message as a hash

    @throw PROTOBUF-TYPE-ERROR if the message type is not found
    @throw PROTOBUF-DECODE-ERROR if parsing fails

    @par Example:
    @code{.py}
hash<auto> msg = schema.decode("helloworld.HelloReply", data);
    @endcode

    @since %grpc 1.0
*/
hash<auto> ProtobufSchema::decode(string type, binary data) {
    return schema->decode(type->c_str(), data, xsink);
}

//! Converts a Qore hash to JSON representation via protobuf
/** @param type the fully-qualified message type name
    @param data the hash to convert

    @return the JSON string representation

    @throw PROTOBUF-TYPE-ERROR if the message type is not found
    @throw PROTOBUF-JSON-ERROR if JSON conversion fails

    @par Example:
    @code{.py}
string json = schema.toJson("helloworld.HelloRequest", {"name": "World"});
    @endcode

    @since %grpc 1.0
*/
string ProtobufSchema::toJson(string type, hash<auto> data) {
    return schema->toJson(type->c_str(), data, xsink);
}

//! Parses a JSON string to a Qore hash via protobuf
/** @param type the fully-qualified message type name
    @param json the JSON string to parse

    @return the parsed message as a hash

    @throw PROTOBUF-TYPE-ERROR if the message type is not found
    @throw PROTOBUF-JSON-ERROR if JSON parsing fails

    @par Example:
    @code{.py}
hash<auto> msg = schema.fromJson("helloworld.HelloRequest", "{\"name\": \"World\"}");
    @endcode

    @since %grpc 1.0
*/
hash<auto> ProtobufSchema::fromJson(string type, string json) {
    return schema->fromJson(type->c_str(), *json, xsink);
}

//! Returns the schema (field-level metadata) for a protobuf message type
/** @param type the fully-qualified or short message type name
    @return a hash describing the message fields with the following structure:
    - \c name: the fully-qualified message type name
    - \c fields: a hash of field name to field info hashes, each containing:
      - \c type: the protobuf type name (e.g., \c "string", \c "int32", \c "message", \c "enum", \c "map")
      - \c number: the field number
      - \c label: the field label (\c "optional", \c "required", \c "repeated")
      - \c message_type: (for message fields) the fully-qualified nested message type name
      - \c enum_type: (for enum fields) the fully-qualified enum type name
      - \c enum_values: (for enum fields) a hash mapping value names to numbers
      - \c key_type: (for map fields) the map key type name
      - \c value_type: (for map fields) the map value type name
      - \c oneof: (for oneof fields) the oneof group name

    @throw PROTOBUF-TYPE-ERROR if the message type is not found

    @par Example:
    @code{.py}
hash<auto> schema_info = schema.messageSchema("test.SimpleRequest");
# schema_info = {"name": "test.SimpleRequest", "fields": {"name": {"type": "string", ...}, ...}}
    @endcode

    @since %grpc 1.0
*/
hash<auto> ProtobufSchema::messageSchema(string type) {
    return schema->getMessageSchema(type->c_str(), xsink);
}

//! Returns enum value names and numbers for a protobuf enum type
/** @param enum_type the fully-qualified or short enum type name
    @return a hash mapping enum value names to their integer numbers

    @throw PROTOBUF-TYPE-ERROR if the enum type is not found

    @par Example:
    @code{.py}
hash<string, int> values = schema.enumValues("test.Status");
# values = {"UNKNOWN": 0, "ACTIVE": 1, "INACTIVE": 2, "DELETED": 3}
    @endcode

    @since %grpc 1.0
*/
hash<string, int> ProtobufSchema::enumValues(string enum_type) {
    return schema->getEnumValues(enum_type->c_str(), xsink);
}

//! Serializes all file descriptors to a list of binary data
/** Returns a list where each element is a serialized \c FileDescriptorProto message.
    Includes all transitive dependencies. This is useful for implementing
    gRPC server reflection or for transferring schema definitions.

    @return a list of binary data, each containing one serialized \c FileDescriptorProto

    @throw PROTOBUF-SCHEMA-ERROR if serialization fails

    @par Example:
    @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
list<binary> descriptors = schema.serializeFileDescriptors();
# Can be used to reconstruct the schema later:
ProtobufSchema schema2(descriptors);
    @endcode

    @since %grpc 1.0
*/
list<binary> ProtobufSchema::serializeFileDescriptors() {
    return schema->serializeFileDescriptors(xsink);
}

//! Serializes the file descriptor containing a given symbol and its transitive dependencies
/** Returns a list where each element is a serialized \c FileDescriptorProto message
    for the file containing the specified symbol and all of its transitive dependencies.
    This is used by the gRPC server reflection protocol to serve
    \c file_containing_symbol requests.

    @param symbol the fully-qualified symbol name (service, message, or enum type name,
    e.g., \c "test.TestService" or \c "test.SimpleRequest")

    @return a list of binary data, each containing one serialized \c FileDescriptorProto

    @throw PROTOBUF-SYMBOL-NOT-FOUND if the symbol is not found in the schema

    @par Example:
    @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
list<binary> fds = schema.serializeFileDescriptorForSymbol("mypackage.MyService");
    @endcode

    @since %grpc 1.0
*/
list<binary> ProtobufSchema::serializeFileDescriptorForSymbol(string symbol) {
    return schema->serializeFileDescriptorForSymbol(symbol->c_str(), xsink);
}

//! Serializes the file descriptor with the given filename and its transitive dependencies
/** Returns a list where each element is a serialized \c FileDescriptorProto message
    for the named file and all of its transitive dependencies.
    This is used by the gRPC server reflection protocol to serve
    \c file_by_filename requests.

    @param filename the proto file name (e.g., \c "test.proto" or \c "input.proto")

    @return a list of binary data, each containing one serialized \c FileDescriptorProto

    @throw PROTOBUF-FILE-NOT-FOUND if the file is not found in the schema

    @par Example:
    @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
list<binary> fds = schema.serializeFileDescriptorByName("service.proto");
    @endcode

    @since %grpc 1.0
*/
list<binary> ProtobufSchema::serializeFileDescriptorByName(string filename) {
    return schema->serializeFileDescriptorByName(filename->c_str(), xsink);
}
