        int port = server.addSecurePort("localhost:0", <GrpcSslOptions>{
            "server_cert": server_cert,
            "server_key": server_key,
        });
        server.start();
        on_exit server.shutdown();

        # Connect with HTTPS (accept all certs since self-signed)
        GrpcChannel channel("https://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        hash<GrpcCallResult> result = client.call("UnaryCall",
            {"name": "World", "id": 1});
        assertEq(GRPC_STATUS_OK, result.status_code, "TLS status code OK");
        assertEq("TLS Hello, World", result.body.message, "TLS response message");
    }

    # --- Metadata tests ---

    testServerTrailingMetadata() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ServerStream",
            sub(hash<auto> request, GrpcServerStream stream,
                    hash<string, string> metadata) {
                # Set custom trailing metadata
                stream.setTrailingMetadata({
                    "x-request-count": "2",
                    "x-server-id": "test-server",
                });
                stream.write({
                    "message": "msg 0",
                    "status": 0,
                });
                stream.write({
                    "message": "msg 1",
                    "status": 1,
                });
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        GrpcClientStream stream = client.serverStream("ServerStream",
            {"name": "meta-test", "id": 1});

        # Drain messages
        list<hash<auto>> messages = ();
        while (*hash<auto> msg = stream.read(60s)) {
            messages += msg;
        }
        assertEq(2, messages.size(), "received 2 messages");

        hash<GrpcCallResult> result = stream.finish();
        assertEq(GRPC_STATUS_OK, result.status_code, "status OK");
        assertEq("2", result.trailing_metadata."x-request-count",
            "custom trailing metadata: request count");
        assertEq("test-server", result.trailing_metadata."x-server-id",
            "custom trailing metadata: server id");
    }

