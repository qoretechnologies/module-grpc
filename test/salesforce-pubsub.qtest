    Salesforce Pub/Sub API event source test suite

    The offline suite runs against a local gRPC server speaking eventbus.v1 from the
    module's own vendored pubsub_api.proto, with Avro payloads produced by the
    builtin avro module, so it needs no Salesforce org and is what CI runs.

    It covers what the CometD building block this replaces provided and what a
    replacement must not lose: the replay position across a reconnect, delivery-driven
    flow-control replenishment, an empty FetchResponse read as liveness rather than
    end-of-stream, recovery from an expired replay ID, and a token refresh on a
    long-lived subscription.

    The tests named "live ..." run against a real org instead, and are skipped unless
    one is reachable.  They prove the things a scripted server cannot: that the org
    answers GetTopic and GetSchema for a real channel, that a real Avro schema decodes,
    and that a record written over REST comes back as a Change Data Capture event that
    a replay ID can resume after.

        qore test/salesforce-pubsub.qtest -c salesforce

    The connection defaults to "salesforce" and may also be named in
    SALESFORCE_CONNECTION; it must be a SalesforceRestConnection.  Given -c explicitly,
    a connection that cannot be loaded is an error rather than a skip.

    The live delivery tests create, update and delete one Account named with the
    LiveAccountPrefix below, and delete it again on the way out even if they fail.
    They change no org configuration: Change Data Capture has to be enabled for Account
    already, and the tests skip with instructions if it is not.
*/

%modern

%requires QUnit
%requires protobuf
%requires grpc
%requires avro
%requires AvroUtil
%requires DataProvider
%requires ConnectionProvider
%requires SalesforceRestClient
%requires RestClientIo
%requires GrpcUtil
%requires SalesforcePubSubDataProvider

%exec-class SalesforcePubSubTest

#! The Avro schema for the synthetic account change event used throughout
const TestSchemaJson = '{
    "type": "record",
    "name": "AccountChangeEvent",
    "namespace": "com.sf.eventbus.test",
    "fields": [
        {"name": "ChangeEventHeader", "type": {
            "type": "record",
            "name": "ChangeEventHeader",
            "fields": [
                {"name": "entityName", "type": "string"},
                {"name": "recordIds", "type": {"type": "array", "items": "string"}},
                {"name": "changeType", "type": "string"},
                {"name": "commitNumber", "type": "long"},
                {"name": "changedFields", "type": {"type": "array", "items": "string"}}
            ]
        }},
        {"name": "Name", "type": ["null", "string"], "default": null},
        {"name": "AnnualRevenue", "type": ["null", "double"], "default": null}
    ]
}';

#! A schema with a compound field, for the nested changed-field bitmap form
const NestedSchemaJson = '{
    "type": "record",
    "name": "NestedChangeEvent",
    "namespace": "com.sf.eventbus.test",
    "fields": [
        {"name": "Name", "type": ["null", "string"], "default": null},
        {"name": "Billing", "type": ["null", {
            "type": "record",
            "name": "Address",
            "fields": [
                {"name": "Street", "type": ["null", "string"], "default": null},
                {"name": "City", "type": ["null", "string"], "default": null}
            ]
        }], "default": null}
    ]
}';

#! The schema ID the test server reports for the test channel
const TestSchemaId = "IeSFsaGYFkarQ8sMLLQrpg";

#! The topic the tests subscribe to
const TestTopic = "/data/AccountChangeEvent";

#! Scripted behaviour and recorded traffic for the test Pub/Sub server
/** Each \c Subscribe connection consumes one script from @ref scripts; a script is a list of
    steps executed in order:
    - <tt>{"send": {"events": list, "pending": int, "latest": binary}}</tt> — write a
      \c FetchResponse; an empty or missing \c events list is a keepalive
    - <tt>{"expect_request": True}</tt> — block until the client sends its next \c FetchRequest
    - <tt>{"throw": {"err": string, "desc": string}}</tt> — fail the RPC with a gRPC status
    - <tt>{"park": True}</tt> — send nothing further and hold the stream open until the test ends

    The step sequence is deterministic because the client only ever writes a \c FetchRequest in
    response to something: the opening request when the stream opens, a replenishment when a
    response reports credit at or below the low-water mark, and a backstop request when the
    flow-control deadline comes due.
*/
class PubSubScript {
    private {
        #! Scripts, one per Subscribe connection, consumed in order
        list<list<hash<auto>>> scripts = ();

        #! The script used once @ref scripts is exhausted
        list<hash<auto>> default_script = ({"park": True},);

        #! FetchRequests received, in order, across all connections
        list<hash<auto>> requests = ();

        #! Call metadata seen on each Subscribe connection, in order
        list<hash<string, string>> metadata = ();

        #! Number of Subscribe connections opened
        int connections = 0;

        #! Number of GetSchema calls served
        int schema_calls = 0;

        #! Number of GetTopic calls served
        int topic_calls = 0;

        #! What GetTopic reports for \c can_subscribe
        bool can_subscribe = True;

        #! State lock
        Mutex m();

        #! Signals recorded traffic
        Condition cond();

        #! Released when the test tears the server down, so parked handlers exit
        Counter release(1);
    }

    #! Appends a script for the next connection
    addScript(list<hash<auto>> script) {
        AutoLock al(m);
        scripts += list(script);
    }

    #! Sets the script used once the explicit scripts are exhausted
    setDefaultScript(list<hash<auto>> script) {
        AutoLock al(m);
        default_script = script;
    }

    #! Returns the script for a new connection and counts it
    list<hash<auto>> nextScript() {
        AutoLock al(m);
        ++connections;
        cond.broadcast();
        if (scripts) {
            return shift scripts;
        }
        return default_script;
    }

    #! Records a FetchRequest
    recordRequest(hash<auto> req) {
        AutoLock al(m);
        requests += req;
        cond.broadcast();
    }

    #! Records the call metadata of a new connection
    recordMetadata(hash<string, string> md) {
        AutoLock al(m);
        metadata += md;
        cond.broadcast();
    }

    #! Counts a GetSchema call
    countSchemaCall() {
        AutoLock al(m);
        ++schema_calls;
    }

    #! Counts a GetTopic call
    countTopicCall() {
        AutoLock al(m);
        ++topic_calls;
    }

    #! Returns every FetchRequest received so far
    list<hash<auto>> getRequests() {
        AutoLock al(m);
        return requests;
    }

    #! Returns the call metadata of the given connection
    *hash<string, string> getMetadata(int index = 0) {
        AutoLock al(m);
        return metadata[index];
    }

    #! Returns the number of Subscribe connections opened
    int getConnectionCount() {
        AutoLock al(m);
        return connections;
    }

    #! Returns the number of GetSchema calls served
    int getSchemaCallCount() {
        AutoLock al(m);
        return schema_calls;
    }

    #! Returns the number of GetTopic calls served
    int getTopicCallCount() {
        AutoLock al(m);
        return topic_calls;
    }

    #! Sets what GetTopic reports for \c can_subscribe
    setCanSubscribe(bool val) {
        AutoLock al(m);
        can_subscribe = val;
    }

    #! Returns what GetTopic should report for \c can_subscribe
    bool getCanSubscribe() {
        AutoLock al(m);
        return can_subscribe;
    }

    #! Blocks until at least \a count FetchRequests have been recorded
    bool waitForRequests(int count, timeout to = 30s) {
        AutoLock al(m);
        date deadline = now_us() + milliseconds(to);
        while (requests.size() < count) {
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                return False;
            }
            cond.wait(m, remaining_ms);
        }
        return True;
    }

    #! Blocks until at least \a count Subscribe connections have been opened
    bool waitForConnections(int count, timeout to = 30s) {
        AutoLock al(m);
        date deadline = now_us() + milliseconds(to);
        while (connections < count) {
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                return False;
            }
            cond.wait(m, remaining_ms);
        }
        return True;
    }

    #! Blocks a parked handler until the test releases it
    park(timeout to = 120s) {
        release.waitForZero(to);
    }

    #! Releases every parked handler
    releaseAll() {
        release.dec();
    }
}

#! A local gRPC server speaking eventbus.v1, plus a Pub/Sub client bound to it
class PubSubTestServer {
    public {
        GrpcServer server;
        int port;
        PubSubScript script();
    }

    private {
        bool stopped = False;
        Mutex m();
    }

    constructor() {
        ProtobufSchema schema = SalesforcePubSubProto::get();
        server = new GrpcServer(schema);

        # bind the shared state directly rather than capturing this object, which would create a
        # reference cycle through the handler closures
        PubSubScript st = script;
        ProtobufSchema sch = schema;

        server.registerHandler("PubSub", "GetSchema",
            hash<auto> sub (hash<auto> request, hash<string, string> metadata) {
                st.countSchemaCall();
                if (request.schema_id != TestSchemaId) {
                    throw "GRPC-NOT-FOUND", sprintf("no such schema ID %y", request.schema_id);
                }
                return {
                    "schema_json": TestSchemaJson,
                    "schema_id": TestSchemaId,
                    "rpc_id": "test-rpc",
                };
            });

        server.registerHandler("PubSub", "GetTopic",
            hash<auto> sub (hash<auto> request, hash<string, string> metadata) {
                st.countTopicCall();
                if (request.topic_name != TestTopic) {
                    throw "GRPC-NOT-FOUND", sprintf("no such topic %y", request.topic_name);
                }
                return {
                    "topic_name": TestTopic,
                    "tenant_guid": "00Dxx0000001gPLEAY",
                    "can_publish": False,
                    "can_subscribe": st.getCanSubscribe(),
                    "schema_id": TestSchemaId,
                    "rpc_id": "test-rpc",
                };
            });

        server.registerHandler("PubSub", "Subscribe",
            sub (GrpcServerStream stream, hash<string, string> metadata) {
                st.recordMetadata(metadata);
                list<hash<auto>> steps = st.nextScript();

                # the opening FetchRequest always arrives on its own; it carries the topic and the
                # replay position, which subsequent requests must not
                *hash<auto> first = stream.read(30s);
                if (!exists first) {
                    return;
                }
                st.recordRequest(first);

                foreach hash<auto> step in (steps) {
                    if (step.park) {
                        st.park();
                        return;
                    }
                    if (step."throw") {
                        throw step."throw".err, step."throw".desc;
                    }
                    if (step.expect_request) {
                        *hash<auto> req = stream.read(30s);
                        if (!exists req) {
                            return;
                        }
                        st.recordRequest(req);
                        continue;
                    }
                    if (step.send) {
                        stream.write({
                            "events": step.send.events ?? (),
                            "latest_replay_id": step.send.latest ?? binary(),
                            "rpc_id": "test-rpc",
                            "pending_num_requested": step.send.pending ?? 0,
                        });
                    }
                }
            });

        port = server.addInsecurePort("localhost:0");
        server.start();
    }

    destructor() {
        stop();
    }

    #! Returns the endpoint URL of this server
    string getUrl() {
        return sprintf("http://localhost:%d", port);
    }

    #! Shuts the server down; safe to call more than once
    stop() {
        {
            AutoLock al(m);
            if (stopped) {
                return;
            }
            stopped = True;
        }
        script.releaseAll();
        server.shutdown();
    }
}

#! Collects what a subscription delivers, with deterministic waits
class EventSink {
    private {
        list<hash<auto>> events = ();
        list<hash<auto>> keepalives = ();
        *hash<auto> failure;
        Mutex m();
        Condition cond();
    }

    onEvent(hash<auto> event) {
        AutoLock al(m);
        events += event;
        cond.broadcast();
    }

    onKeepalive(hash<auto> ka) {
        AutoLock al(m);
        keepalives += ka;
        cond.broadcast();
    }

    onFailure(hash<auto> err) {
        AutoLock al(m);
        failure = err;
        cond.broadcast();
    }

    hash<auto> getOptions() {
        return {
            "on_event": \onEvent(),
            "on_keepalive": \onKeepalive(),
            "on_failure": \onFailure(),
        };
    }

    list<hash<auto>> getEvents() {
        AutoLock al(m);
        return events;
    }

    list<hash<auto>> getKeepalives() {
        AutoLock al(m);
        return keepalives;
    }

    *hash<auto> getFailure() {
        AutoLock al(m);
        return failure;
    }

    bool waitForEvents(int count, timeout to = 30s) {
        AutoLock al(m);
        date deadline = now_us() + milliseconds(to);
        while (events.size() < count) {
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                return False;
            }
            cond.wait(m, remaining_ms);
        }
        return True;
    }

    bool waitForKeepalives(int count, timeout to = 30s) {
        AutoLock al(m);
        date deadline = now_us() + milliseconds(to);
        while (keepalives.size() < count) {
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                return False;
            }
            cond.wait(m, remaining_ms);
        }
        return True;
    }

    bool waitForFailure(timeout to = 30s) {
        AutoLock al(m);
        date deadline = now_us() + milliseconds(to);
        while (!failure) {
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                return False;
            }
            cond.wait(m, remaining_ms);
        }
        return True;
    }

    #! Returns the events whose ChangeEventHeader names the given record, in arrival order
    /** A live org channel carries every change to the entity, not only the ones a test caused, so
        a live assertion has to be made on the record it wrote rather than on the whole stream.
    */
    list<hash<auto>> getEventsForRecord(string record_id) {
        AutoLock al(m);
        return getEventsForRecordIntern(record_id);
    }

    #! Waits until at least \a count events naming the given record have been delivered
    bool waitForRecordEvents(string record_id, int count, timeout to = 60s) {
        AutoLock al(m);
        date deadline = now_us() + milliseconds(to);
        while (getEventsForRecordIntern(record_id).size() < count) {
            int remaining_ms = (deadline - now_us()).durationMilliseconds();
            if (remaining_ms <= 0) {
                return False;
            }
            cond.wait(m, remaining_ms);
        }
        return True;
    }

    #! Returns the change types of the events naming the given record, in arrival order
    list<auto> getRecordChangeTypes(string record_id) {
        AutoLock al(m);
        return map $1.payload.ChangeEventHeader.changeType, getEventsForRecordIntern(record_id);
    }

    #! Caller must hold @ref m
    private list<hash<auto>> getEventsForRecordIntern(string record_id) {
        return map $1, events, inlist(record_id, $1.payload.ChangeEventHeader.recordIds);
    }
}

#! A Pub/Sub client that records token refreshes instead of performing them
/** The token acquisition itself belongs to \c RestClientIo and is covered by the
    \c SalesforceRestClient suite in the Qore repository; what has to be proven here is that the
    reconnect path asks for a refresh when, and only when, the server reports
    @ref GRPC_STATUS_UNAUTHENTICATED.
*/
class TestPubSubClient inherits SalesforcePubSubClient {
    private {
        Sequence refreshes();
    }

    constructor(hash<string, string> metadata, *hash<auto> opts)
            : SalesforcePubSubClient(metadata, opts) {
    }

    bool refreshToken() {
        refreshes.next();
        return True;
    }

    int getRefreshCount() {
        return refreshes.getCurrent();
    }
}

#! An events container with a scripted describeGlobal response
/** Substitutes for the REST round trip only: everything below it — the channel filter, the child
    names, the summary info and the child providers — is the real implementation.
*/
class TestEventsProvider inherits SalesforcePubSubDataProvider::SalesforcePubSubEventsDataProvider {
    private {
        list<auto> sobjects;
    }

    constructor(SalesforceRestClient::SalesforceRestClientIo rest, list<auto> sobjects)
            : SalesforcePubSubEventsDataProvider(rest) {
        self.sobjects = sobjects;
    }

    private *list<auto> getChannelObjects() {
        return sobjects;
    }
}

#! A channel provider with an injected Pub/Sub client
/** Substitutes for the connection-derived client only: the change type filter, the option checks,
    the can-subscribe check and the subscription itself are all the real implementation.
*/
class TestChannelProvider inherits SalesforcePubSubDataProvider::SalesforcePubSubEventDataProvider {
    private {
        SalesforcePubSubClient test_client;
    }

    constructor(SalesforceRestClient::SalesforceRestClientIo rest, string channel,
            SalesforcePubSubClient client) : SalesforcePubSubEventDataProvider(rest, channel) {
        test_client = client;
    }

    constructor(SalesforceRestClient::SalesforceRestClientIo rest, string channel,
            SalesforcePubSubClient client, string preset)
            : SalesforcePubSubEventDataProvider(rest, channel, NOTHING, preset) {
        test_client = client;
    }

    SalesforcePubSubClient getPubSubClient() {
        return test_client;
    }
}

#! Collects the events an observable data provider raises
class ChangeEventCollector inherits DataProvider::Observer {
    private {
        list<hash<auto>> events();
        Mutex m();
        Condition cond();
    }

    update(string event_id, hash<auto> data_) {
        AutoLock al(m);
        events += {"event_id": event_id, "data": data_};
        cond.broadcast();
    }

    #! Returns every event raised so far
    list<hash<auto>> getEvents() {
        AutoLock al(m);
        return events;
    }

    #! Returns the change types of the events raised so far, in order
    list<auto> getChangeTypes() {
        AutoLock al(m);
        return map $1.data.payload.ChangeEventHeader.changeType, events;
    }
}

public class SalesforcePubSubTest inherits QUnit::Test {
    public {
        #! Call metadata for a client that manages no authentication of its own
        const TestMetadata = {
            MetadataAccessToken: "an-access-token",
            MetadataInstanceUrl: "https://acme.my.salesforce.com",
            MetadataTenantId: "00Dxx0000001gPLEAY",
        };

        #! Options for a REST client that is never actually used to reach an org
        const TestRestOptions = {
            "oauth2_client_id": "id",
            "oauth2_client_secret": "secret",
            # RestClientIo validates the OAuth2 option set in the constructor; the token below
            # means no login is performed, but the authorization-code grant still requires this
            "oauth2_redirect_url": "https://localhost:8080/callback",
            "token": "a-token",
            "instance_url": "https://acme.my.salesforce.com",
            "id_service_url": "https://login.salesforce.com/id/00Dxx0000001gPLEAY/005xx000001Svog",
        };

        #! The replay preset wire values, as the server decodes them
        const PresetLatest = 0;
        const PresetEarliest = 1;
        const PresetCustom = 2;

        #! Command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 25;

        #! The connection used for the live tests unless one is named
        const DefaultConnectionName = "salesforce";

        #! The entity the live Change Data Capture tests write to and watch
        /** Account is the entity most likely to be enabled in a developer org, and the one the
            REST suite in the Qore repository also exercises.
        */
        const LiveEntity = "Account";
        const LiveChannel = LiveEntity + "ChangeEvent";

        #! Live test records are named so that anything left behind by a killed run is identifiable
        const LiveAccountPrefix = "DEL_TEST_PUBSUB_";

        #! How long a live subscription is given to deliver an event the test caused
        /** Change Data Capture delivery is normally sub-second; this is a bound on a failure, not
            an expected wait, and nothing is polled while it elapses.
        */
        const LiveEventTimeout = 120s;
    }

    private {
        #! The live Salesforce connection, if one is available
        *SalesforceRestClient::SalesforceRestConnection sfconn;

        #! Why the live tests are being skipped, if they are
        *string live_skip_reason;
    }

    constructor() : Test("SalesforcePubSubTest", "1.0", \ARGV, MyOpts) {
        addTestCase("vendored proto", \testVendoredProto());
        addTestCase("changed field bitmap decode", \testChangeEventFieldDecode());
        addTestCase("channel name mapping", \testChannelNameMapping());
        addTestCase("call metadata", \testCallMetadata());
        addTestCase("schema cache", \testSchemaCache());
        addTestCase("avro decode round trip", \testAvroDecode());
        addTestCase("opening fetch request", \testOpeningFetchRequest());
        addTestCase("replay preset wire values", \testReplayPresetWireValues());
        addTestCase("keepalive is not end of stream", \testKeepalive());
        addTestCase("delivery-driven flow control", \testFlowControlReplenishment());
        addTestCase("flow control backstop", \testFlowControlBackstop());
        addTestCase("manual replenishment", \testManualReplenishment());
        addTestCase("replay resume on reconnect", \testReplayResumeOnReconnect());
        addTestCase("corrupt replay ID recovery", \testCorruptReplayIdRecovery());
        addTestCase("token refresh on unauthenticated", \testTokenRefresh());
        addTestCase("no refresh on other failures", \testNoRefreshOnOtherFailure());
        addTestCase("idle timeout detects a dead stream", \testIdleTimeout());
        addTestCase("reconnect disabled", \testReconnectDisabled());
        addTestCase("reconnect attempt limit", \testReconnectAttemptLimit());
        addTestCase("stop is idempotent and terminal", \testStop());
        addTestCase("subscription option validation", \testSubscriptionOptions());
        addTestCase("client option validation", \testClientOptions());
        addTestCase("channel enumeration", \testChannelEnumeration());
        addTestCase("event provider types", \testEventProviderTypes());
        addTestCase("event provider registration", \testProviderRegistration());
        addTestCase("change type matching", \testChangeTypeMatching());
        addTestCase("change type preset children", \testChangeTypePresetChildren());
        addTestCase("change type option rejections", \testChangeTypeOptionRejections());
        addTestCase("named change event actions", \testNamedChangeEventActions());
        addTestCase("change type filtering", \testChangeTypeFiltering());
        addTestCase("gap events reach the base type", \testGapChangeTypeDelivery());
        addTestCase("can-subscribe check", \testCanSubscribeCheck());
        addTestCase("cdc entity naming", \testCdcEntityNaming());
        addTestCase("cdc enablement registration", \testCdcEnablementRegistration());

        addTestCase("live org identity and call metadata", \testLiveOrgIdentity());
        addTestCase("live channel enumeration", \testLiveChannelEnumeration());
        addTestCase("live topic and Avro schema", \testLiveTopicAndSchema());
        addTestCase("live subscription health", \testLiveSubscriptionHealth());
        addTestCase("live event delivery and replay resume", \testLiveEventDelivery());

        setupConnection();

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", sprintf("Salesforce connection to run the live tests "
            "against (default: %y)", DefaultConnectionName), OptionColumn);
    }

    #! Resolves the connection for the live tests, or records why there is none
    /** A connection named explicitly with -c is a request to run the live tests, so failing to
        load it is an error.  Falling back to the default is not, so anything that goes wrong there
        is recorded as a skip reason: the offline suite is what CI runs and it must not depend on
        an org being reachable.
    */
    private setupConnection() {
        bool explicit = m_options.conn.val() || ENV.SALESFORCE_CONNECTION.val();
        string conn_name = m_options.conn ?? ENV.SALESFORCE_CONNECTION ?? DefaultConnectionName;

        AbstractConnection conn;
        try {
            conn = get_connection(conn_name);
        } catch (hash<ExceptionInfo> ex) {
            if (explicit) {
                rethrow;
            }
            live_skip_reason = sprintf("no connection %y (%s); name one with --connection to run "
                "the live tests", conn_name, ex.err);
            return;
        }

        if (!(conn instanceof SalesforceRestClient::SalesforceRestConnection)) {
            string desc = sprintf("connection %y is a %s; the live tests need a "
                "SalesforceRestConnection", conn_name, conn.className());
            if (explicit) {
                throw "OPTION-ERROR", desc;
            }
            live_skip_reason = desc;
            return;
        }
        sfconn = cast<SalesforceRestClient::SalesforceRestConnection>(conn);
    }

    #! The vendored proto is loaded from disk and describes the whole service
    testVendoredProto() {
        ProtobufSchema schema = SalesforcePubSubProto::get();
        assertEq(schema, SalesforcePubSubProto::get(), "the schema is cached, not reparsed");

        list<auto> services = schema.services();
        assertEq(1, services.size(), "the proto declares exactly one service");
        assertEq("PubSub", services[0].name);

        hash<string, hash<auto>> methods;
        map methods{$1.name} = $1, services[0].methods;
        assertTrue(methods.hasKey("Subscribe"));
        assertTrue(methods.Subscribe.client_streaming, "Subscribe is client-streaming");
        assertTrue(methods.Subscribe.server_streaming, "Subscribe is server-streaming");
        assertEq("/eventbus.v1.PubSub/Subscribe", methods.Subscribe.full_path);
        assertEq("eventbus.v1.FetchRequest", methods.Subscribe.input_type);
        assertEq("eventbus.v1.FetchResponse", methods.Subscribe.output_type);
        assertFalse(methods.GetSchema.server_streaming, "GetSchema is unary");

        # the proto must be a resource file that ships with the module, not a string constant: this
        # is what the *.proto resource glob in QoreMacros.cmake exists for
        string proto = get_script_dir() + "/../qlib/SalesforcePubSubDataProvider/"
            + SalesforcePubSubProto::ProtoFileName;
        assertTrue(is_file(proto), sprintf("%y is a file in the module directory", proto));

        # the flow-control cap is the API's, so it has to match what the module enforces
        assertEq(100, MaxNumRequested);
        assertLt(MaxNumRequested + 1, DefaultNumRequested, "the default window is within the cap");
    }

    #! Changed-field bitmaps decode to the field names they select
    /** The Pub/Sub API reports changed, nulled and diff fields as bitmaps over the channel's Avro
        schema field order, unlike the CometD API, which sent names.  Getting the bit order wrong
        yields plausible names for the wrong fields, so the ordering is pinned here against the
        value a real org sent for a known change.
    */
    testChangeEventFieldDecode() {
        AvroSchema schema(TestSchemaJson);

        # bit N selects top-level field N: 0 ChangeEventHeader, 1 Name, 2 AnnualRevenue
        assertEq(("Name",), decode_change_event_fields(schema, ("0x2",)));
        assertEq(("Name", "AnnualRevenue"), decode_change_event_fields(schema, ("0x6",)));
        assertEq(("ChangeEventHeader",), decode_change_event_fields(schema, ("0x1",)));
        assertEq((), decode_change_event_fields(schema, ("0x0",)), "an empty bitmap selects none");
        assertEq((), decode_change_event_fields(schema, NOTHING), "no bitmaps select none");
        assertEq(("Name",), decode_change_event_fields(schema, "0x2"), "a bare string is a list");

        # a multi-byte bitmap is one big-endian integer, not a sequence of per-byte bitmaps: this
        # is the value a live org sent for an Account whose Name, AnnualRevenue and
        # LastModifiedDate changed, at field positions 1, 12 and 22
        list<string> wide_fields = ();
        for (int i = 0; i < 24; ++i) {
            wide_fields += sprintf('{"name": "f%d", "type": ["null", "string"], "default": null}',
                i);
        }
        AvroSchema wide(sprintf('{"type": "record", "name": "Wide", "fields": [%s]}',
            join(", ", wide_fields)));
        assertEq(("f1", "f12", "f22"), decode_change_event_fields(wide, ("0x401002",)));

        # a compound field names its parent by position and indexes the nested record
        AvroSchema nested(NestedSchemaJson);
        assertEq(("Billing.City",), decode_change_event_fields(nested, ("1-0x2",)));
        assertEq(("Name", "Billing.Street", "Billing.City"),
            decode_change_event_fields(nested, ("0x1", "1-0x3")));

        # nothing is dropped when a bitmap cannot be decoded: a header reporting "0x40000" is worth
        # more than one that silently claims nothing changed
        assertEq(("0x40000",), decode_change_event_fields(schema, ("0x40000",)),
            "a bit with no field behind it passes the whole entry through");
        assertEq(("not-a-bitmap",), decode_change_event_fields(schema, ("not-a-bitmap",)));
        assertEq(("99-0x2",), decode_change_event_fields(nested, ("99-0x2",)),
            "a compound entry naming a field position that does not exist passes through");
        assertEq(("0-0x2",), decode_change_event_fields(nested, ("0-0x2",)),
            "a compound entry naming a field that is not a record passes through");
        assertEq(("1-0x40",), decode_change_event_fields(nested, ("1-0x40",)),
            "a compound entry whose child bitmap overruns the nested record passes through");
        assertEq((), decode_change_event_fields(schema, (42,)), "a non-string entry is ignored");
    }

    #! An event entity name maps to its topic name; anything else is rejected
    testChannelNameMapping() {
        assertEq("/data/AccountChangeEvent", get_topic_name("AccountChangeEvent"));
        assertEq("/data/ContactChangeEvent", get_topic_name("ContactChangeEvent"));
        assertEq("/event/Order_Shipped__e", get_topic_name("Order_Shipped__e"));

        # a topic name is passed through, which is how a custom channel is reached
        assertEq("/event/MyChannel__chn", get_topic_name("/event/MyChannel__chn"));
        assertEq("/data/ChangeEvents", get_topic_name("/data/ChangeEvents"));

        assertThrows("SALESFORCE-PUBSUB-CHANNEL-ERROR", \get_topic_name(), "Account");
        assertThrows("SALESFORCE-PUBSUB-CHANNEL-ERROR", \get_topic_name(), "");

        assertTrue(is_pubsub_channel("AccountChangeEvent"));
        assertTrue(is_pubsub_channel("Order_Shipped__e"));
        assertFalse(is_pubsub_channel("Account"), "a plain sobject is not a channel");
        assertFalse(is_pubsub_channel("AccountHistory"));
    }

    #! The three Salesforce metadata headers are sent on every call
    testCallMetadata() {
        PubSubTestServer srv();
        on_exit srv.stop();

        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        assertEq(srv.getUrl(), client.getUrl());
        assertEq(TestMetadata, client.getCallMetadata());

        # the metadata reaches the server as gRPC call metadata, which is how the org is
        # identified: the endpoint is the same global host for every org
        client.getTopic(TestTopic);
        srv.script.addScript(({"park": True},));
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, {});
        subscr.start();
        on_exit subscr.stop();
        assertTrue(srv.script.waitForRequests(1), "the opening FetchRequest arrived");

        *hash<string, string> md = srv.script.getMetadata();
        assertEq("an-access-token", md{MetadataAccessToken});
        assertEq("https://acme.my.salesforce.com", md{MetadataInstanceUrl});
        assertEq("00Dxx0000001gPLEAY", md{MetadataTenantId});

        # a client built from explicit metadata must reject an incomplete org identity rather than
        # opening a subscription that the server will reject
        assertThrows("SALESFORCE-PUBSUB-ERROR", sub () {
            new SalesforcePubSubClient(cast<hash<string, string>>(
                TestMetadata - MetadataTenantId));
        });
        assertThrows("SALESFORCE-PUBSUB-ERROR", sub () {
            new SalesforcePubSubClient(cast<hash<string, string>>(
                TestMetadata + {MetadataInstanceUrl: ""}));
        });

        # no REST client to refresh with, so a refresh is a no-op rather than an error
        assertFalse(client.refreshToken());
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.getRestClient());
    }

    #! Schema IDs repeat for every event, so a second lookup must not hit the server
    testSchemaCache() {
        PubSubTestServer srv();
        on_exit srv.stop();

        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        assertEq(0, client.getSchemaCacheSize());

        AvroSchema s1 = client.getSchema(TestSchemaId);
        assertEq(1, srv.script.getSchemaCallCount());
        assertEq(1, client.getSchemaCacheSize());

        AvroSchema s2 = client.getSchema(TestSchemaId);
        assertEq(s1, s2, "the cached schema object is returned");
        assertEq(1, srv.script.getSchemaCallCount(), "a cache hit issues no round trip");

        assertEq("record", s1.getType());
        assertEq("com.sf.eventbus.test.AccountChangeEvent", s1.getName(),
            "AvroSchema::getName() reports the fullname");

        # an unknown schema ID is an error from the server, and must not poison the cache
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.getSchema(), "no-such-schema");
        assertEq(1, client.getSchemaCacheSize());

        # the cache is bounded so a long-lived process subscribing to many channels cannot grow
        # without limit
        SalesforcePubSubClient small(TestMetadata, {"url": srv.getUrl(), "schema_cache_size": 1});
        small.getSchema(TestSchemaId);
        assertEq(1, small.getSchemaCacheSize());
        assertThrows("SALESFORCE-PUBSUB-ERROR", sub () {
            new SalesforcePubSubClient(TestMetadata, {"schema_cache_size": 0});
        });
    }

    #! An event encoded by the server round-trips through the delivery path unchanged
    testAvroDecode() {
        PubSubTestServer srv();
        on_exit srv.stop();

        hash<auto> payload = {
            "ChangeEventHeader": {
                "entityName": "Account",
                "recordIds": ("001xx000003DGb2AAG", "001xx000003DGb3AAG"),
                "changeType": "UPDATE",
                "commitNumber": 11223344556677,
                "changedFields": ("0x2",),
            },
            "Name": "Acme Corporation",
            "AnnualRevenue": NOTHING,
        };
        binary replay_id = binary("replay-0001");
        srv.script.addScript((
            {"send": {"events": (makeEvent(payload, replay_id),), "pending": 99}},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions());
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(1), "the event was delivered");
        # the replay position advances only after the consumer callback returns, so the state this
        # test asserts is observable a moment after delivery
        assertTrue(subscr.waitForEvents(1), "the event was fully processed");
        hash<auto> event = sink.getEvents()[0];

        assertEq(TestTopic, event.channel);
        assertEq(TestSchemaId, event.event.schemaId);
        assertEq(make_base64_string(replay_id), event.event.replayId);
        assertEq("test-event-id", event.event.id);

        # the decoded payload is the record the server encoded, including the nullable union
        # branch, which is what the ["null", T] shape has to produce
        assertEq("Account", event.payload.ChangeEventHeader.entityName);
        assertEq(("001xx000003DGb2AAG", "001xx000003DGb3AAG"),
            event.payload.ChangeEventHeader.recordIds);
        assertEq("UPDATE", event.payload.ChangeEventHeader.changeType);
        assertEq(11223344556677, event.payload.ChangeEventHeader.commitNumber);
        assertEq("Acme Corporation", event.payload.Name);
        assertNothing(event.payload.AnnualRevenue, "a null union branch decodes to NOTHING");

        # the API sent "0x2", a bitmap over the schema's field order; a consumer must never see one
        assertEq(("Name",), event.payload.ChangeEventHeader.changedFields,
            "the changed-field bitmap was decoded to field names before delivery");

        # the replay position advances to the delivered event
        assertEq(make_base64_string(replay_id), subscr.getLastReplayId());
        hash<auto> stats = subscr.getStats();
        assertEq(1, stats.events);
        assertEq(0, stats.keepalives);
        assertTrue(stats.connected);
    }

    #! The first FetchRequest carries the topic and the replay position; later ones do not
    testOpeningFetchRequest() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.addScript((
            # credit at zero forces the client to replenish, which is what produces the second
            # request this test inspects
            {"send": {"events": (), "pending": 0, "latest": binary("keep-1")}},
            {"expect_request": True},
            {"park": True},
        ));

        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, {
            "num_requested": 50,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(srv.script.waitForRequests(2), "the opening and replenishing requests arrived");
        list<hash<auto>> reqs = srv.script.getRequests();

        assertEq(TestTopic, reqs[0].topic_name, "the opening request names the topic");
        assertEq(PresetLatest, reqs[0].replay_preset, "LATEST is the default starting position");
        assertEq(50, reqs[0].num_requested);
        assertEq(0, reqs[0].replay_id.size(), "no replay ID without the CUSTOM preset");

        # the topic cannot change within a stream, so subsequent requests carry only credit;
        # sending it again would be redundant and sending a different one is an API error
        assertEq("", reqs[1].topic_name, "a replenishing request carries no topic");
        assertEq(50, reqs[1].num_requested, "credit is topped back up to the window");
    }

    #! Each replay preset is sent as its enum wire value, not its name
    testReplayPresetWireValues() {
        # the protobuf encoder takes only integers for an enum field and silently encodes 0 for
        # anything else, so a preset sent by name would arrive as LATEST and quietly lose the
        # replay position
        assertEq(PresetLatest, SalesforcePubSubProto::getReplayPresetValue(ReplayLatest));
        assertEq(PresetEarliest, SalesforcePubSubProto::getReplayPresetValue(ReplayEarliest));
        assertEq(PresetCustom, SalesforcePubSubProto::getReplayPresetValue(ReplayCustom));
        assertThrows("SALESFORCE-PUBSUB-ERROR",
            \SalesforcePubSubProto::getReplayPresetValue(), "NOPE");

        # and the value has to survive the round trip to the server
        PubSubTestServer srv();
        on_exit srv.stop();

        binary start = binary("resume-here");
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, {
            "replay_preset": ReplayCustom,
            "replay_id": make_base64_string(start),
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(srv.script.waitForRequests(1));
        hash<auto> req = srv.script.getRequests()[0];
        assertEq(PresetCustom, req.replay_preset, "CUSTOM reaches the server as CUSTOM");
        assertEq(start, req.replay_id, "the caller's replay ID is sent verbatim");

        # a replay ID on its own implies CUSTOM; leaving the preset at LATEST would silently start
        # at the tip and ignore the caller's stored position
        PubSubTestServer srv2();
        on_exit srv2.stop();
        SalesforcePubSubClient c2(TestMetadata, {"url": srv2.getUrl()});
        SalesforcePubSubSubscription s2 = c2.subscribe(TestTopic, {
            "replay_id": make_base64_string(start),
        });
        s2.start();
        on_exit s2.stop();
        assertTrue(srv2.script.waitForRequests(1));
        assertEq(PresetCustom, srv2.script.getRequests()[0].replay_preset);

        # EARLIEST needs no ID
        PubSubTestServer srv3();
        on_exit srv3.stop();
        SalesforcePubSubClient c3(TestMetadata, {"url": srv3.getUrl()});
        SalesforcePubSubSubscription s3 = c3.subscribe(TestTopic, {
            "replay_preset": ReplayEarliest,
        });
        s3.start();
        on_exit s3.stop();
        assertTrue(srv3.script.waitForRequests(1));
        assertEq(PresetEarliest, srv3.script.getRequests()[0].replay_preset);
    }

    #! An empty FetchResponse is liveness and a replay-ID update, never end-of-stream
    testKeepalive() {
        PubSubTestServer srv();
        on_exit srv.stop();

        binary keep1 = binary("bus-latest-1");
        binary keep2 = binary("bus-latest-2");
        srv.script.addScript((
            {"send": {"events": (), "pending": 90, "latest": keep1}},
            {"send": {"events": (), "pending": 90, "latest": keep2}},
            {"send": {"events": (makeEvent(makePayload(), binary("ev-1")),), "pending": 89}},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions());
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForKeepalives(2), "both keepalives were seen");
        assertTrue(sink.waitForEvents(1),
            "the stream stayed open across the keepalives and delivered the event after them");
        assertTrue(subscr.waitForKeepalives(2));
        assertTrue(subscr.waitForEvents(1));

        assertEq(0, sink.getEvents().size() - 1, "an empty batch raises no event");
        assertNothing(sink.getFailure(), "a keepalive is not a failure");
        assertTrue(subscr.isConnected(), "an empty batch does not end the stream");

        # the keepalive advances the replay position: this is what lets a resubscribe skip ground
        # already covered rather than replaying from an old ID
        assertEq(make_base64_string(keep2), sink.getKeepalives()[1].replayId);
        assertEq(TestTopic, sink.getKeepalives()[0].channel);

        hash<auto> stats = subscr.getStats();
        assertEq(2, stats.keepalives);
        assertEq(1, stats.events);
        # credit stayed above the low-water mark throughout, so nothing was replenished and no
        # backstop deadline was ever armed
        assertEq(1, stats.fetch_requests, "only the opening request was sent");
        assertFalse(stats.backstop_armed);
        assertEq(0, stats.backstops);
    }

    #! Credit is replenished from the delivery path as events are consumed
    testFlowControlReplenishment() {
        PubSubTestServer srv();
        on_exit srv.stop();

        # 10 events against a window of 10 with a low-water mark of 4: the first batch leaves the
        # server holding 5, which is above the mark, so nothing is replenished; the second leaves
        # 3, which is at or below it, so a request goes out
        srv.script.addScript((
            {"send": {"events": makeEvents(5, 1), "pending": 5}},
            {"send": {"events": makeEvents(2, 6), "pending": 3}},
            {"expect_request": True},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "num_requested": 10,
            "low_water_mark": 4,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(7), "all events were delivered");
        assertTrue(subscr.waitForEvents(7));
        assertTrue(srv.script.waitForRequests(2), "credit was replenished");

        list<hash<auto>> reqs = srv.script.getRequests();
        assertEq(2, reqs.size(), "exactly one replenishment, driven by consumption");
        assertEq(7, reqs[1].num_requested, "the window is topped up by the deficit, not refilled");

        # replenishment is driven by delivery, not by a clock: the request is already in by the
        # time the events have been consumed, with no deadline having come due
        hash<auto> stats = subscr.getStats();
        assertEq(0, stats.backstops, "the 60s window was never the mechanism");
        assertEq(7, stats.events);
    }

    #! With automatic replenishment off, the backstop deadline holds the stream open
    testFlowControlBackstop() {
        PubSubTestServer srv();
        on_exit srv.stop();

        # a consumer driving flow control itself can leave the server with no credit; the API then
        # closes the stream unless a FetchRequest arrives within 60 seconds, so the deadline armed
        # on the controller's timeout heap has to produce one
        srv.script.addScript((
            {"send": {"events": makeEvents(1, 1), "pending": 0}},
            {"expect_request": True},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "num_requested": 10,
            "auto_replenish": False,
            "flow_control_backstop_ms": 1000,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(1));
        assertTrue(srv.script.waitForRequests(2, 20s),
            "the backstop deadline produced a FetchRequest");

        assertEq(10, srv.script.getRequests()[1].num_requested);
        assertEq(1, srv.script.getConnectionCount(),
            "the stream was held open rather than being re-established");
        hash<auto> stats = subscr.getStats();
        assertEq(1, stats.backstops, "the backstop fired exactly once");
        assertFalse(stats.backstop_armed, "the request discharged the deadline");
    }

    #! A consumer can drive flow control itself
    testManualReplenishment() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.addScript((
            {"send": {"events": makeEvents(1, 1), "pending": 2}},
            {"expect_request": True},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "num_requested": 10,
            "low_water_mark": 1,
            "auto_replenish": False,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(1));
        assertTrue(subscr.replenish(5), "an explicit count is granted");
        assertTrue(srv.script.waitForRequests(2));
        assertEq(5, srv.script.getRequests()[1].num_requested);

        assertThrows("SALESFORCE-PUBSUB-ERROR", \subscr.replenish(), 0);
        assertThrows("SALESFORCE-PUBSUB-ERROR", \subscr.replenish(), MaxNumRequested + 1);

        # with no count, the window is topped back up to num_requested: the server reported 2 and
        # 5 more were granted, so 3 remain
        assertTrue(subscr.replenish(), "the window is topped up by the deficit");
        assertEq(10, subscr.getStats().outstanding);
        # and once it is full there is nothing left to grant
        assertFalse(subscr.replenish(), "a full window sends nothing");
    }

    #! A failed stream is re-established from the last event delivered, not restarted
    testReplayResumeOnReconnect() {
        PubSubTestServer srv();
        on_exit srv.stop();

        binary last = binary("replay-0002");
        srv.script.addScript((
            {"send": {"events": (
                makeEvent(makePayload(), binary("replay-0001")),
                makeEvent(makePayload(), last),
            ), "pending": 90}},
            {"throw": {"err": "GRPC-INTERNAL", "desc": "the server went away"}},
        ));
        srv.script.addScript((
            {"send": {"events": (makeEvent(makePayload(), binary("replay-0003")),), "pending": 90}},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "reconnect_delay_ms": 100,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(3, 30s), "delivery continued after the reconnect");
        assertTrue(subscr.waitForEvents(3, 30s));
        assertTrue(srv.script.waitForConnections(2), "the stream was re-established");

        list<hash<auto>> reqs = srv.script.getRequests();
        # this is the whole point of the replacement: the second subscription resumes after the
        # last event actually delivered rather than starting again at the tip
        assertEq(PresetCustom, reqs[1].replay_preset,
            "the reconnect resumes from the stored position");
        assertEq(last, reqs[1].replay_id, "resumed after the last delivered event");
        assertEq(TestTopic, reqs[1].topic_name);

        assertNothing(sink.getFailure(), "a recovered failure is not reported to the consumer");
        hash<auto> stats = subscr.getStats();
        assertEq(3, stats.events);
        assertGt(0, stats.reconnects);
        assertEq(make_base64_string(binary("replay-0003")), stats.replay_id);
    }

    #! An expired replay ID is recovered from by falling back to a preset
    testCorruptReplayIdRecovery() {
        PubSubTestServer srv();
        on_exit srv.stop();

        # replay IDs are retained for 72 hours; past that the only recovery is a preset, and
        # retrying with the same stored ID would fail identically forever
        srv.script.addScript((
            {"send": {"events": (makeEvent(makePayload(), binary("stale-id")),), "pending": 90}},
            {"throw": {"err": "GRPC-INVALID-ARGUMENT", "desc": ReplayIdCorruptedError}},
        ));
        srv.script.addScript(({"park": True},));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "replay_preset": ReplayEarliest,
            "reconnect_delay_ms": 100,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(1));
        assertTrue(srv.script.waitForConnections(2), "the subscription was restarted");
        # the stale ID is cleared on the terminal event, which follows the last delivery
        assertTrue(srv.script.waitForRequests(2));

        list<hash<auto>> reqs = srv.script.getRequests();
        assertEq(PresetEarliest, reqs[1].replay_preset,
            "the unusable ID was dropped for the configured preset");
        assertEq(0, reqs[1].replay_id.size(), "the stale replay ID is not sent again");
        assertNothing(subscr.getLastReplayId(), "the stored position was cleared");
        assertTrue(subscr.getStats().last_error.desc.find(ReplayIdCorruptedError) != -1);
    }

    #! An UNAUTHENTICATED failure refreshes the token before reconnecting
    testTokenRefresh() {
        PubSubTestServer srv();
        on_exit srv.stop();

        binary last = binary("replay-9001");
        srv.script.addScript((
            {"send": {"events": (makeEvent(makePayload(), last),), "pending": 90}},
            {"throw": {"err": "GRPC-UNAUTHENTICATED", "desc": "the access token has expired"}},
        ));
        srv.script.addScript(({"park": True},));

        EventSink sink();
        TestPubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "reconnect_delay_ms": 100,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForEvents(1));
        assertTrue(subscr.waitForEvents(1));
        assertTrue(srv.script.waitForConnections(2), "the subscription was re-established");
        assertTrue(srv.script.waitForRequests(2));

        assertEq(1, client.getRefreshCount(), "the token was refreshed once before reconnecting");
        # the replay position survives the token refresh, which is the requirement a long-lived
        # subscription has: re-authenticating must not cost events
        assertEq(PresetCustom, srv.script.getRequests()[1].replay_preset);
        assertEq(last, srv.script.getRequests()[1].replay_id);
    }

    #! A failure that is not an auth failure does not refresh the token
    testNoRefreshOnOtherFailure() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.addScript((
            {"throw": {"err": "GRPC-INTERNAL", "desc": "transient server fault"}},
        ));
        srv.script.addScript(({"park": True},));

        TestPubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, {
            "reconnect_delay_ms": 100,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(srv.script.waitForConnections(2));
        assertEq(0, client.getRefreshCount(),
            "a transport fault is not an authentication failure");
    }

    #! Silence past the keepalive bound is a dead stream, and is detected
    testIdleTimeout() {
        PubSubTestServer srv();
        on_exit srv.stop();

        # the server contracts to send an empty FetchResponse within 270 seconds; a stream that
        # goes quiet past that bound is dead even though the transport has not noticed
        srv.script.addScript(({"park": True},));
        srv.script.addScript((
            {"send": {"events": (makeEvent(makePayload(), binary("after-idle")),), "pending": 90}},
            {"park": True},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            # long enough that the reconnected stream cannot also be declared idle before its
            # event is delivered on a loaded machine, short enough to keep the suite quick
            "idle_timeout_ms": 3000,
            "reconnect_delay_ms": 100,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(srv.script.waitForConnections(2, 30s),
            "the idle bound ended the dead stream and a new one was opened");
        assertTrue(sink.waitForEvents(1, 30s), "delivery resumed on the new stream");
        assertNothing(sink.getFailure());
    }

    #! With reconnection disabled, a failed stream is reported to the consumer
    testReconnectDisabled() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.addScript((
            {"throw": {"err": "GRPC-INTERNAL", "desc": "no more service"}},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "reconnect": False,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForFailure(), "the failure reached the consumer");
        assertEq(1, srv.script.getConnectionCount(), "no reconnect was attempted");
        assertFalse(subscr.isActive(), "the subscription is finished");
        assertTrue(sink.getFailure().desc.find("no more service") != -1);
        assertTrue(subscr.waitForDone(10s));
    }

    #! Reconnection gives up after the configured number of consecutive failures
    testReconnectAttemptLimit() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.setDefaultScript((
            {"throw": {"err": "GRPC-INTERNAL", "desc": "always failing"}},
        ));

        EventSink sink();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, sink.getOptions() + {
            "reconnect_delay_ms": 100,
            "max_reconnect_delay_ms": 100,
            "max_reconnect_attempts": 2,
        });
        subscr.start();
        on_exit subscr.stop();

        assertTrue(sink.waitForFailure(30s), "the subscription gave up and said so");
        assertFalse(subscr.isActive());
        # the initial connection plus two reconnect attempts
        assertEq(3, srv.script.getConnectionCount());
    }

    #! stop() is terminal and safe to call more than once
    testStop() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.setDefaultScript(({"park": True},));

        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        SalesforcePubSubSubscription subscr = client.subscribe(TestTopic, {});
        assertFalse(subscr.isActive(), "a subscription is inert until started");
        subscr.start();
        assertTrue(subscr.waitForConnected(10s));
        # the client is connected once the stream is submitted, which is before the server handler
        # has run; the assertion below counts connections server-side, so wait for that too
        assertTrue(srv.script.waitForConnections(1, 10s));
        assertThrows("SALESFORCE-PUBSUB-ERROR", \subscr.start());

        subscr.stop();
        subscr.stop();
        assertFalse(subscr.isActive());
        assertFalse(subscr.isConnected());
        assertTrue(subscr.waitForDone(10s));
        assertEq(1, srv.script.getConnectionCount(), "a stopped subscription does not reconnect");
    }

    #! Subscription options are validated up front rather than failing on the wire
    testSubscriptionOptions() {
        PubSubTestServer srv();
        on_exit srv.stop();
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});

        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.subscribe(), (TestTopic,
            {"replay_preset": "SOMETIME"}));
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.subscribe(), (TestTopic,
            {"replay_preset": ReplayCustom}));
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.subscribe(), (TestTopic,
            {"num_requested": 0}));
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.subscribe(), (TestTopic,
            {"num_requested": MaxNumRequested + 1}));
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.subscribe(), (TestTopic,
            {"num_requested": 10, "low_water_mark": 10}));
        assertThrows("SALESFORCE-PUBSUB-ERROR", \client.subscribe(), (TestTopic,
            {"num_requested": 10, "low_water_mark": -1}));

        # a small window must still leave room for a low-water mark below it
        SalesforcePubSubSubscription tiny = client.subscribe(TestTopic, {"num_requested": 1});
        assertEq(TestTopic, tiny.getTopicName());
        assertNothing(tiny.getLastReplayId());
        assertEq(0, tiny.getStats().events);
    }

    #! Client options are validated and the endpoint defaults to the global Pub/Sub host
    testClientOptions() {
        # the endpoint is one global host for production orgs and sandboxes alike; only the OAuth2
        # URLs are org-specific and the REST connection owns those
        assertEq("https://api.pubsub.salesforce.com:7443", PubSubUrl);
        SalesforcePubSubClient client(TestMetadata);
        assertEq(PubSubUrl, client.getUrl(), "the endpoint defaults to the global host");
        assertEq("eventbus.v1.PubSub", SalesforcePubSubProto::ServiceName);
        assertEq("PubSub", client.getGrpcClient().getServiceInfo().name);
    }

    #! Channels come from describeGlobal, since the Pub/Sub API cannot list topics
    testChannelEnumeration() {
        SalesforceRestClient::SalesforceRestClientIo rest({
            "oauth2_client_id": "id",
            "oauth2_client_secret": "secret",
            # RestClientIo validates the OAuth2 option set in the constructor, so the
            # authorization-code grant needs a redirect URL even though the token below means no
            # login is ever performed
            "oauth2_redirect_url": "https://localhost:8080/callback",
            "token": "a-token",
            "instance_url": "https://acme.my.salesforce.com",
            "id_service_url": "https://login.salesforce.com/id/00Dxx0000001gPLEAY/005xx000001Svog",
        });

        TestEventsProvider events(rest, (
            {"name": "Account", "queryable": True},
            {"name": "AccountChangeEvent", "queryable": False},
            {"name": "ContactChangeEvent", "queryable": False},
            {"name": "Order_Shipped__e", "queryable": False},
            {"name": "AccountHistory", "queryable": True},
            {"name": "Case", "queryable": True},
        ));

        assertEq(PubSubChildName, events.getName());
        # only the event entities are subscribable; a plain sobject and a history object are not
        assertEq(("AccountChangeEvent", "ContactChangeEvent", "Order_Shipped__e"),
            events.getChildProviderNames());

        hash<DataProviderInfo> info = events.getInfo();
        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_observers,
            "the events container advertises observable children");
        assertFalse(info.children_can_support_records);

        *list<hash<DataProviderSummaryInfo>> summary = events.getChildProviderSummaryInfo();
        assertEq(3, summary.size());
        assertEq("AccountChangeEvent", summary[0].name);
        assertTrue(summary[0].supports_observable);
        assertTrue(summary[0].desc.find("Change Data Capture") != -1);

        AbstractDataProvider child = events.getChildProviderEx("AccountChangeEvent");
        assertEq("AccountChangeEvent", child.getName());
        assertTrue(child instanceof SalesforcePubSubEventDataProvider);
        assertTrue(child instanceof DelayedObservable);
        assertEq("/data/AccountChangeEvent",
            cast<SalesforcePubSubEventDataProvider>(child).getTopicName());
        assertEq("/event/Order_Shipped__e", cast<SalesforcePubSubEventDataProvider>(
            events.getChildProviderEx("Order_Shipped__e")).getTopicName());

        assertNothing(events.getChildProvider("Account"),
            "a non-channel sobject is not a child even if describeGlobal lists it");
        assertThrows("INVALID-CHILD-PROVIDER", \events.getChildProviderEx(), "Account");

        # a provider built from a REST client rather than a connection can subscribe just as one
        # built from a connection can: its client is a SalesforceRestClientIo, which carries the
        # access token and the instance URL that are the whole of the Pub/Sub call metadata.  This
        # threw while the provider held a blocking SalesforceRestClient, which supplied neither
        SalesforcePubSubClient psc =
            cast<SalesforcePubSubEventDataProvider>(child).getPubSubClient();
        assertEq(PubSubUrl, psc.getUrl(), "a REST-client-built provider reaches the Pub/Sub host");
    }

    #! An event provider reports its event types and example data without subscribing
    testEventProviderTypes() {
        SalesforceRestClient::SalesforceRestClientIo rest({
            "oauth2_client_id": "id",
            "oauth2_client_secret": "secret",
            # RestClientIo validates the OAuth2 option set in the constructor, so the
            # authorization-code grant needs a redirect URL even though the token below means no
            # login is ever performed
            "oauth2_redirect_url": "https://localhost:8080/callback",
            "token": "a-token",
            "instance_url": "https://acme.my.salesforce.com",
            "id_service_url": "https://login.salesforce.com/id/00Dxx0000001gPLEAY/005xx000001Svog",
        });

        SalesforcePubSubEventDataProvider prov(rest, "AccountChangeEvent");
        assertEq("AccountChangeEvent", prov.getName());
        assertTrue(prov.getDesc().find("Change Data Capture") != -1);
        assertTrue(prov.getInfo().supports_observable);
        assertNothing(prov.getSubscription(), "no subscription before observersReady()");

        hash<string, hash<DataProviderMessageInfo>> types = prov.getEventTypes();
        assertEq(2, types.size());
        assertTrue(types.hasKey(EVENT_SALESFORCE_PUBSUB_EVENT));
        assertTrue(types.hasKey(EVENT_SALESFORCE_PUBSUB_ERROR));

        # the org is unreachable here, so the payload falls back to an untyped hash while the
        # envelope stays fully described
        AbstractDataProviderType t = types{EVENT_SALESFORCE_PUBSUB_EVENT}.type;
        hash<string, AbstractDataField> fields = t.getFields();
        assertEq(("channel", "event", "payload"), keys fields);
        assertEq(("replayId", "id", "schemaId"), keys fields.event.getType().getFields());

        # getExampleEventDataImpl() must be implemented, not inherited, and must produce
        # resource-specific data rather than a generic stub
        auto ex = prov.getExampleEventData(EVENT_SALESFORCE_PUBSUB_EVENT);
        assertEq(NT_HASH, ex.typeCode());
        assertTrue(ex.hasKey("channel"));
        assertTrue(ex.payload.hasKey("ChangeEventHeader"),
            "the example is a change event, not a generic id/created_time stub");
        assertEq("Account", ex.payload.ChangeEventHeader.entityName);

        auto err = prov.getExampleEventData(EVENT_SALESFORCE_PUBSUB_ERROR);
        assertTrue(err.hasKey("err"));
        assertTrue(err.hasKey("desc"));

        # a platform event gets a platform-event example, not a change-event one
        SalesforcePubSubEventDataProvider pe(rest, "Order_Shipped__e");
        assertTrue(pe.getDesc().find("platform event") != -1);
        assertFalse(pe.getExampleEventData(EVENT_SALESFORCE_PUBSUB_EVENT)
            .payload.hasKey("ChangeEventHeader"));

        # the Pub/Sub client is available without a connection, so a provider built from a REST
        # client is subscribable; no network I/O is performed until observersReady() is called
        assertTrue(prov.getPubSubClient() instanceof SalesforcePubSubClient,
            "a REST-client-built provider has a Pub/Sub client");
        # stopEvents() on a provider that never started is a no-op, not an error
        prov.stopEvents();
    }

    #! The module registers the events container and the event action on the Salesforce app
    testProviderRegistration() {
        # the child is attached to the Salesforce data provider rather than published as its own
        # app: Pub/Sub events are Salesforce events
        assertEq(PubSubChildName, "pubsub");
        assertTrue(SalesforceRestDataProvider::SalesforceRestDataProvider::ProviderInfo
            .children_can_support_observers);

        list<hash<DataProviderActionInfo>> actions =
            DataProviderActionCatalog::getActions(SalesforceRestDataProvider::AppName);
        *hash<DataProviderActionInfo> action;
        foreach hash<DataProviderActionInfo> a in (actions) {
            if (a.action == "pubsub-event") {
                action = a;
                break;
            }
        }
        assertTrue(exists action, "the Pub/Sub event action is registered on the Salesforce app");
        assertEq(DPAT_EVENT, action.action_code);
        assertEq(EVENT_SALESFORCE_PUBSUB_EVENT, action.action_val);
        assertEq("/pubsub/{channel}", action.path);
        assertEq(("channel",), keys action.path_vars);

        # the action carries a typed output so a Qog form is usable before a channel is chosen; the
        # per-channel provider then refines the payload from that channel's Avro schema
        assertTrue(exists action.output_type, "the event action declares an output type");
        hash<string, AbstractDataField> out = action.output_type.getFields();
        assertEq(("channel", "event", "payload"), keys out);
        assertEq(("replayId", "id", "schemaId"), keys out.event.getType().getFields());
        map assertTrue($1.getDescription().val(),
            sprintf("output field %y has a description", $1.getName())), out.iterator();
        assertLt(81, action.short_desc.size(), "short_desc is within the 80 character bound");

        # every option the provider reads from context is offered by the action, and each one
        # carries the display metadata the UI needs
        assertEq(keys SalesforcePubSubEventDataProvider::LocalOptions, keys action.options);
        foreach hash<auto> i in (action.options.pairIterator()) {
            assertTrue(i.value.display_name.val(), sprintf("option %y has a display_name", i.key));
            assertTrue(i.value.short_desc.val(), sprintf("option %y has a short_desc", i.key));
            assertTrue(exists i.value.type, sprintf("option %y has a type", i.key));
        }
        # the replay preset is a closed set, so it must be declared as allowed values rather than
        # described in prose
        assertEq(3, action.options.replay_preset.allowed_values.size());
        assertEq((ReplayLatest, ReplayEarliest, ReplayCustom),
            (map $1.value, action.options.replay_preset.allowed_values));
    }

    #! The mapping between a channel, its change event entity and the Setup developer name
    /** These names are a Salesforce convention rather than anything this module invents, so they
        are pinned: a member created with the wrong \c DeveloperName would be invisible to Setup
        and could be created twice.
    */
    testCdcEntityNaming() {
        # a topic name, a bare entity name and a preset child path all yield the same entity
        assertEq("AccountChangeEvent", get_change_event_entity("/data/AccountChangeEvent"));
        assertEq("AccountChangeEvent", get_change_event_entity("AccountChangeEvent"));
        # a custom object keeps its "__ChangeEvent" spelling
        assertEq("MyObject__ChangeEvent", get_change_event_entity("/data/MyObject__ChangeEvent"));
        # platform events and custom channels are not change events
        assertNothing(get_change_event_entity("/event/Order_Shipped__e"));
        assertNothing(get_change_event_entity("Order_Shipped__e"));
        assertNothing(get_change_event_entity("/event/MyChannel__chn"));

        # Setup names the member after the *object*, not after the event
        assertEq("CM_ChangeEvents_Account",
            SalesforcePubSubCdc::getDeveloperName("AccountChangeEvent"));
        assertEq("CM_ChangeEvents_Case", SalesforcePubSubCdc::getDeveloperName("CaseChangeEvent"));
        assertEq("CM_ChangeEvents_MyObject__",
            SalesforcePubSubCdc::getDeveloperName("MyObject__ChangeEvent"));
        assertEq("ChangeEvents", SalesforcePubSubCdc::StandardEventChannel);
        assertEq("PlatformEventChannelMember", SalesforcePubSubCdc::ChannelMemberSobject);
    }

    #! Change Data Capture enablement is offered explicitly, and is never implicit
    testCdcEnablementRegistration() {
        # the option that lets a subscription enable the entity defaults to off: subscribing to
        # events must not quietly change org configuration
        *hash<auto> opt = SalesforcePubSubEventDataProvider::LocalOptions.enable_cdc;
        assertTrue(exists opt, "the enable_cdc option exists");
        assertEq(False, opt.default_value, "enable_cdc is off unless asked for");
        assertTrue(opt.display_name.val());
        assertTrue(opt.short_desc.val());
        assertLt(81, opt.short_desc.size(), "short_desc is within the 80 character bound");
        # the description has to warn about the side effects, since this mutates the org
        assertTrue(opt.desc =~ /72-hour/, "the description names the retention side effect");
        assertTrue(opt.desc =~ /enable-change-data-capture/,
            "the description points at the explicit action");

        # the explicit action, for enabling once rather than as part of a subscription
        list<hash<DataProviderActionInfo>> actions =
            DataProviderActionCatalog::getActions(SalesforceRestDataProvider::AppName);
        *hash<DataProviderActionInfo> action =
            (select actions, $1.action == "enable-change-data-capture")[0];
        assertTrue(exists action, "the enablement action is registered on the Salesforce app");
        assertEq(DPAT_API, action.action_code);
        assertEq(("Events",), action.groups,
            "the enablement action sits with the event actions it exists to make work");
        assertEq("/" + SalesforcePubSubEnableCdcDataProvider::ProviderName, action.path);
        assertNothing(action.path_vars, "the entity is an option, not a path variable");
        assertLt(81, action.short_desc.size(), "short_desc is within the 80 character bound");
        assertTrue(action.desc =~ /72-hour/, "the description names the retention side effect");

        # the request option is offered with the metadata a form needs
        assertEq(("entity",), keys action.options);
        assertTrue(action.options.entity.display_name.val());
        assertTrue(action.options.entity.short_desc.val());
        assertTrue(exists action.options.entity.type);
        assertTrue(action.options.entity.example_value.val());

        # a typed output, so the result is usable in a flow rather than opaque
        assertTrue(exists action.output_type, "the action declares an output type");
        hash<string, AbstractDataField> out = action.output_type.getFields();
        assertEq(("entity", "developer_name", "event_channel", "id", "already_enabled"), keys out);
        map assertTrue($1.getDescription().val(),
            sprintf("output field %y has a description", $1.getName())), out.iterator();
    }

    #! Returns the standard test payload
    #! The change type filter is pure logic, so its rules are pinned directly
    testChangeTypeMatching() {
        # no filter delivers everything, including an event with no ChangeEventHeader
        assertTrue(change_type_matches(NOTHING, "UPDATE"));
        assertTrue(change_type_matches(NOTHING, NOTHING));
        assertTrue(change_type_matches((), "DELETE"), "an empty filter is no filter");

        assertTrue(change_type_matches((ChangeTypeCreate,), ChangeTypeCreate));
        assertFalse(change_type_matches((ChangeTypeCreate,), ChangeTypeUpdate));
        assertTrue(change_type_matches((ChangeTypeCreate, ChangeTypeUpdate), ChangeTypeUpdate),
            "multi-select");

        # a gap event stands in for the change it could not carry: dropping it would turn a
        # visible "we missed something" into silent data loss
        assertTrue(change_type_matches((ChangeTypeCreate,), ChangeTypeGapCreate));
        assertFalse(change_type_matches((ChangeTypeCreate,), ChangeTypeGapUpdate));
        assertTrue(change_type_matches((ChangeTypeGapCreate,), ChangeTypeGapCreate),
            "a gap type can be selected explicitly");
        assertFalse(change_type_matches((ChangeTypeGapCreate,), ChangeTypeCreate),
            "selecting only the gap type does not select the base type");

        # GAP_OVERFLOW reports an unknown number of lost changes and is never filtered out
        assertTrue(change_type_matches((ChangeTypeCreate,), ChangeTypeGapOverflow));
        assertTrue(change_type_matches((ChangeTypeDelete,), ChangeTypeGapOverflow));

        # a platform event carries no ChangeEventHeader, so it cannot satisfy a change filter
        assertFalse(change_type_matches((ChangeTypeCreate,), NOTHING));
    }

    #! A CDC channel exposes one child per change type; a platform event channel exposes none
    testChangeTypePresetChildren() {
        SalesforceRestClient::SalesforceRestClientIo rest(TestRestOptions);

        SalesforcePubSubEventDataProvider cdc(rest, "AccountChangeEvent");
        assertTrue(cdc.getInfo().supports_children);
        assertTrue(cdc.getInfo().children_can_support_observers);
        assertEq(("created", "updated", "deleted", "undeleted"), cdc.getChildProviderNames());

        AbstractDataProvider kid = cdc.getChildProviderEx("created");
        assertEq("created", kid.getName());
        assertTrue(kid.getInfo().supports_observable, "a preset child is still observable");
        assertFalse(kid.getInfo().supports_children, "a preset child has no children of its own");
        assertNothing(kid.getChildProviderNames());
        assertTrue(kid.getDesc().find("CREATE") != -1,
            "the description names the change type the child selects");

        assertNothing(cdc.getChildProvider("bogus"), "an unknown preset is not a child");

        # platform events carry no ChangeEventHeader, so there is nothing to filter on
        SalesforcePubSubEventDataProvider pe(rest, "Order_Shipped__e");
        assertNothing(pe.getChildProviderNames());
        assertNothing(pe.getChildProvider("created"));
    }

    #! A change type filter that could never match is rejected rather than delivering silence
    testChangeTypeOptionRejections() {
        SalesforceRestClient::SalesforceRestClientIo rest(TestRestOptions);

        # the preset child takes its filter from the provider path, so an explicit option is
        # either redundant or a contradiction
        SalesforcePubSubEventDataProvider preset(rest, "AccountChangeEvent", NOTHING, "created");
        assertThrows("SALESFORCE-PUBSUB-OPTION-ERROR", "cannot be set on the",
            sub () {
                DataProviderDataContextHelper ctx({"change_type": (ChangeTypeUpdate,)});
                preset.observersReady();
            });

        # a filter on a platform event channel would drop every event
        SalesforcePubSubEventDataProvider pe(rest, "Order_Shipped__e");
        assertThrows("SALESFORCE-PUBSUB-OPTION-ERROR", "platform event channel",
            sub () {
                DataProviderDataContextHelper ctx({"change_type": (ChangeTypeCreate,)});
                pe.observersReady();
            });
    }

    #! The named CDC actions carry the filter in the path rather than in a preset option
    testNamedChangeEventActions() {
        hash<string, string> expected = {
            "new-record": "/pubsub/{channel}/created",
            "updated-record": "/pubsub/{channel}/updated",
            "new-contact": "/pubsub/ContactChangeEvent/created",
            "new-lead": "/pubsub/LeadChangeEvent/created",
        };

        foreach hash<auto> i in (expected.pairIterator()) {
            hash<DataProviderActionInfo> act =
                DataProviderActionCatalog::getAppActionEx(SalesforceRestDataProvider::AppName,
                    i.key);
            assertEq(i.value, act.path, sprintf("%y resolves to a preset child", i.key));
            assertEq(DPAT_EVENT, act.action_code);
            assertEq(EVENT_SALESFORCE_PUBSUB_EVENT, act.action_val);
            # the path carries the filter, so the option must not be offered as well: an action
            # that let the user widen "New Record" to "any change" would misname itself
            assertFalse(act.options.hasKey("change_type"),
                sprintf("%y does not expose the change_type option", i.key));
            assertTrue(act.options.hasKey("replay_preset"),
                sprintf("%y keeps the replay options", i.key));
        }

        # the generic action remains, and is the only one that exposes the filter
        hash<DataProviderActionInfo> generic =
            DataProviderActionCatalog::getAppActionEx(SalesforceRestDataProvider::AppName,
                "pubsub-event");
        assertEq("/pubsub/{channel}", generic.path);
        assertTrue(generic.options.hasKey("change_type"));
    }

    #! Only events matching the preset reach observers, and the rest do not stall the stream
    testChangeTypeFiltering() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.addScript((
            {"send": {"events": (
                makeEvent(makePayload(ChangeTypeCreate), binary("ev-1")),
                makeEvent(makePayload(ChangeTypeUpdate), binary("ev-2")),
                makeEvent(makePayload(ChangeTypeCreate), binary("ev-3")),
            ), "pending": 90}},
            {"park": True},
        ));

        SalesforceRestClient::SalesforceRestClientIo rest(TestRestOptions);
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        TestChannelProvider prov(rest, "AccountChangeEvent", client, "created");

        ChangeEventCollector collector();
        cast<Observable>(prov).registerObserver(collector);
        prov.observersReady();
        on_exit prov.stopEvents();

        # the subscription counts every event it decoded, filtered or not, so this is a
        # deterministic barrier: once it reports 3, the filter has run on all of them
        *SalesforcePubSubSubscription subscr = prov.getSubscription();
        assertTrue(exists subscr, "observersReady() opened the subscription");
        assertTrue(subscr.waitForEvents(3, 30s), "all three events reached the subscription");

        assertEq((ChangeTypeCreate, ChangeTypeCreate), collector.getChangeTypes(),
            "only the creates were raised to observers");

        # the replay position must advance over filtered events too, or a reconnect would
        # re-deliver everything the filter dropped
        assertEq(make_base64_string(binary("ev-3")), subscr.getLastReplayId(),
            "the replay position advanced past the filtered event");
    }

    #! A gap event reaches the subscriber that asked for the change it stands in for
    testGapChangeTypeDelivery() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.addScript((
            {"send": {"events": (
                makeEvent(makePayload(ChangeTypeGapCreate), binary("gap-1")),
                makeEvent(makePayload(ChangeTypeGapUpdate), binary("gap-2")),
                makeEvent(makePayload(ChangeTypeGapOverflow), binary("gap-3")),
            ), "pending": 90}},
            {"park": True},
        ));

        SalesforceRestClient::SalesforceRestClientIo rest(TestRestOptions);
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        TestChannelProvider prov(rest, "AccountChangeEvent", client, "created");

        ChangeEventCollector collector();
        cast<Observable>(prov).registerObserver(collector);
        prov.observersReady();
        on_exit prov.stopEvents();

        *SalesforcePubSubSubscription subscr = prov.getSubscription();
        assertTrue(exists subscr, "observersReady() opened the subscription");
        assertTrue(subscr.waitForEvents(3, 30s));

        # GAP_CREATE stands in for the create that was asked for; GAP_OVERFLOW is always
        # delivered because it reports an unknown number of lost changes; GAP_UPDATE is not
        # a create and is dropped
        assertEq((ChangeTypeGapCreate, ChangeTypeGapOverflow), collector.getChangeTypes());
    }

    #! A channel the org will not let us subscribe to fails loudly instead of delivering nothing
    testCanSubscribeCheck() {
        PubSubTestServer srv();
        on_exit srv.stop();

        srv.script.setCanSubscribe(False);
        srv.script.addScript(({"park": True},));

        SalesforceRestClient::SalesforceRestClientIo rest(TestRestOptions);
        SalesforcePubSubClient client(TestMetadata, {"url": srv.getUrl()});
        TestChannelProvider prov(rest, "AccountChangeEvent", client);

        ChangeEventCollector collector();
        cast<Observable>(prov).registerObserver(collector);

        # a CDC entity that has not been selected in Setup accepts the subscription and then
        # delivers nothing, which is indistinguishable from an idle org; the error names the
        # entity and where to enable it
        hash<ExceptionInfo> ex;
        try {
            prov.observersReady();
            fail("observersReady() must reject a topic the org cannot subscribe to");
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("SALESFORCE-PUBSUB-SUBSCRIBE-ERROR", ex.err);
        assertTrue(ex.desc.find("Change Data Capture") != -1,
            "the error says how to enable the channel");
        assertTrue(ex.desc.find("Account") != -1, "the error names the entity");
        assertNothing(prov.getSubscription(), "no subscription was opened");

        # the check is a diagnostic aid, not a gate: once the org allows it, the subscription
        # proceeds normally
        srv.script.setCanSubscribe(True);
        prov.observersReady();
        on_exit prov.stopEvents();
        assertTrue(srv.script.waitForRequests(1), "the subscription opened once permitted");
    }

    #! Builds a test payload with the given Change Data Capture change type
    private static hash<auto> makePayload(string change_type) {
        hash<auto> rv = SalesforcePubSubTest::makePayload();
        rv.ChangeEventHeader.changeType = change_type;
        return rv;
    }

    private static hash<auto> makePayload() {
        return {
            "ChangeEventHeader": {
                "entityName": "Account",
                "recordIds": ("001xx000003DGb2AAG",),
                "changeType": "UPDATE",
                "commitNumber": 42,
                # as the API sends it: bits 1 and 2 of the schema's field order, so Name and
                # AnnualRevenue.  Consumers see the decoded names
                "changedFields": ("0x6",),
            },
            "Name": "Acme Corporation",
            "AnnualRevenue": 1234.5,
        };
    }

    #! Builds a ConsumerEvent with an Avro-encoded payload
    private static hash<auto> makeEvent(hash<auto> payload, binary replay_id,
            string id = "test-event-id") {
        AvroSchema schema(TestSchemaJson);
        return {
            "event": {
                "id": id,
                "schema_id": TestSchemaId,
                "payload": schema.encode(payload),
                "headers": (),
            },
            "replay_id": replay_id,
        };
    }

    #! Builds \a count ConsumerEvents with sequential replay IDs
    private static list<auto> makeEvents(int count, int first) {
        list<auto> rv = ();
        for (int i = 0; i < count; ++i) {
            rv += SalesforcePubSubTest::makeEvent(SalesforcePubSubTest::makePayload(),
                binary(sprintf("replay-%04d", first + i)), sprintf("event-%d", first + i));
        }
        return rv;
    }

    #
    # Live org tests; skipped unless a Salesforce connection is available
    #

    #! The org identity the whole Pub/Sub layer depends on comes from the connection
    /** The endpoint is one global host for every org, so an org that is not correctly identified
        by the call metadata does not fail to connect -- it connects and answers about the wrong
        org, or about none.  Everything else here rests on these three values.
    */
    private testLiveOrgIdentity() {
        requireLiveConnection();

        hash<PingInfo> ping = sfconn.ping(True);
        assertTrue(ping.ok, sprintf("the connection pings: %s", ping.info));

        SalesforceRestClient::SalesforceRestClientIo rest =
            cast<SalesforceRestClient::SalesforceRestClientIo>(sfconn.getAsync());
        # forces the login if one has not happened yet; the org identity is captured from it
        rest.getApiClient();

        assertTrue(rest.getInstanceUrl().val(), "the org instance URL is known after login");
        assertTrue(rest.getOrgId().val(), "the org ID is known after login");

        SalesforcePubSubClient client(sfconn);
        assertEq(PubSubUrl, client.getUrl(), "the client reaches the global Pub/Sub endpoint");

        hash<string, string> md = client.getCallMetadata();
        assertTrue(md{MetadataAccessToken}.val(), "the access token is in the call metadata");
        assertEq(rest.getInstanceUrl(), md{MetadataInstanceUrl},
            "the instance URL in the call metadata is the org's");
        assertEq(rest.getOrgId(), md{MetadataTenantId},
            "the tenant ID in the call metadata is the org's");
    }

    #! The org's real channel list reaches the provider tree through describeGlobal
    private testLiveChannelEnumeration() {
        requireLiveConnection();

        AbstractDataProvider events = sfconn.getDataProvider().getChildProviderEx(PubSubChildName);
        assertEq(PubSubChildName, events.getName());

        *list<string> names = events.getChildProviderNames();
        assertTrue(names.size() > 0, "the org exposes at least one Pub/Sub channel");
        # describeGlobal lists every sobject; only the event entities may appear as children
        assertEq((), (map $1, names, !is_pubsub_channel($1)),
            "every child is a subscribable channel");

        *list<hash<DataProviderSummaryInfo>> summary = events.getChildProviderSummaryInfo();
        assertEq(names.size(), summary.size(), "the summary covers every channel");
        assertEq(names, (map $1.name, summary), "the summary names match the child names");

        AbstractDataProvider child = events.getChildProviderEx(names[0]);
        assertTrue(child instanceof SalesforcePubSubEventDataProvider);
        assertEq(get_topic_name(names[0]),
            cast<SalesforcePubSubEventDataProvider>(child).getTopicName());

        assertThrows("INVALID-CHILD-PROVIDER", \events.getChildProviderEx(),
            "NotAChannel__nonexistent");
    }

    #! GetTopic and GetSchema answer for a real channel, and the schema decodes as Avro
    private testLiveTopicAndSchema() {
        requireLiveConnection();

        SalesforcePubSubClient client(sfconn);
        string topic = requireLiveCdcChannel(client);

        hash<auto> info = client.getTopic(topic);
        assertEq(topic, info.topic_name);
        assertTrue(info.schema_id.val(), "the org reports a schema ID for the channel");
        # the tenant GUID identifies the org to the Pub/Sub service and must name this org
        assertTrue(info.tenant_guid.val(), "the org reports a tenant GUID");

        AvroSchema schema = client.getSchema(info.schema_id);
        assertEq(schema, client.getSchema(info.schema_id),
            "a second lookup is served from the cache, not a second GetSchema");
        assertEq(1, client.getSchemaCacheSize());

        # a Change Data Capture payload always leads with ChangeEventHeader; this is the real
        # schema from the org, so it is also the proof that the builtin avro module parses it
        AbstractDataProviderType t = AvroUtil::AvroTypeHelper::schemaToDataType(schema);
        *hash<string, AbstractDataField> fields = t.getFields();
        assertTrue(fields.hasKey("ChangeEventHeader"),
            "the derived type carries the change event header");
        assertTrue(fields.size() > 1, "the derived type carries the entity's own fields");

        # the provider derives its event type from that same schema, so a Qog bound to this
        # channel shows the org's real field names rather than an untyped hash
        AbstractDataProvider chan = sfconn.getDataProvider()
            .getChildProviderEx(PubSubChildName).getChildProviderEx(LiveChannel);
        hash<string, hash<DataProviderMessageInfo>> event_types = chan.getEventTypes();
        *hash<string, AbstractDataField> payload_fields =
            event_types{EVENT_SALESFORCE_PUBSUB_EVENT}.type.getFields().payload.getType().getFields();
        assertTrue(payload_fields.hasKey("ChangeEventHeader"),
            "the event type's payload came from the channel's Avro schema");
    }

    #! A subscription to a real channel establishes over TLS and arms nothing while healthy
    private testLiveSubscriptionHealth() {
        requireLiveConnection();

        SalesforcePubSubClient client(sfconn);
        string topic = requireLiveCdcChannel(client);

        EventSink sink();
        SalesforcePubSubSubscription subscr = client.subscribe(topic, sink.getOptions());
        subscr.start();
        on_exit subscr.stop();

        assertTrue(subscr.waitForConnected(60s), "the subscription established a stream");
        assertTrue(subscr.isActive());
        assertEq(topic, subscr.getTopicName());
        assertNothing(sink.getFailure(), "no failure was reported");

        hash<auto> stats = subscr.getStats();
        assertEq(1, stats.fetch_requests, "only the opening FetchRequest was sent");
        assertEq(0, stats.reconnects, "a healthy subscription does not reconnect");
        assertEq(0, stats.backstops, "the flow-control backstop did not fire");
        assertFalse(stats.backstop_armed, "a healthy subscription arms no timer");
        assertEq(DefaultNumRequested, stats.outstanding, "the opening request granted the window");

        subscr.stop();
        assertFalse(subscr.isActive(), "stop() is terminal");
    }

    #! A record written over REST arrives as a CDC event, and a replay ID resumes after it
    /** This is the end-to-end path a scripted server cannot prove: the org's own Avro encoding,
        its change types, and a replay ID that Salesforce -- not the test -- issued.
    */
    private testLiveEventDelivery() {
        requireLiveConnection();

        SalesforcePubSubClient client(sfconn);
        string topic = requireLiveCdcChannel(client);
        RestClientIo::RestClientIo api =
            cast<SalesforceRestClient::SalesforceRestClientIo>(sfconn.getAsync()).getApiClient();

        # subscribe at the tip before writing anything, so every event this test sees is one it
        # caused; LATEST is the default preset
        EventSink sink();
        SalesforcePubSubSubscription subscr = client.subscribe(topic, sink.getOptions());
        subscr.start();
        on_exit subscr.stop();
        assertTrue(subscr.waitForConnected(60s), "the subscription established a stream");

        string name = LiveAccountPrefix + get_random_string(8);
        string id = api.restPost("sobjects/" + LiveEntity, {"Name": name}).body.id;
        # the delete below is the last step of the test, but it must also happen if an assertion
        # above it throws, or the org keeps the record
        on_exit deleteLiveRecordQuietly(api, id);

        string updated_name = name + "_UPD";
        api.restPatch(sprintf("sobjects/%s/%s", LiveEntity, id), {"Name": updated_name});
        api.restDel(sprintf("sobjects/%s/%s", LiveEntity, id));

        assertTrue(sink.waitForRecordEvents(id, 3, LiveEventTimeout),
            sprintf("the create, update and delete of %y were all delivered", name));

        list<hash<auto>> evs = sink.getEventsForRecord(id);
        assertEq((ChangeTypeCreate, ChangeTypeUpdate, ChangeTypeDelete),
            (map $1.payload.ChangeEventHeader.changeType, evs)[0..2],
            "the change types arrived in the order the changes were made");
        assertEq(topic, evs[0].channel);
        # the value read back came out of the org's Avro encoding, so this is the round trip
        assertEq(name, evs[0].payload.Name, "the created name survived the Avro decode");
        assertEq(updated_name, evs[1].payload.Name, "the update carried the new name");

        # the org sent a bitmap over its own schema's field order, not the field names the CometD
        # API sent; the module decodes it against that schema before delivery, and this is the
        # only place the two can be checked against each other on real data
        *softlist<auto> changed = evs[1].payload.ChangeEventHeader.changedFields;
        assertTrue(inlist("Name", changed),
            sprintf("the update reports Name as a changed field; got %y", changed));
        assertEq((), (map $1, changed, $1 =~ /^0x/),
            "no raw bitmap reached the consumer");

        # the Pub/Sub replay ID is opaque bytes reported base64, unlike the CometD API's
        # monotonic integer; resuming from the create must deliver what followed it and no more
        string create_replay_id = evs[0].event.replayId;
        assertTrue(create_replay_id.val(), "the delivered event carries a replay ID");
        subscr.stop();

        EventSink resumed();
        SalesforcePubSubSubscription resub = client.subscribe(topic, resumed.getOptions() + {
            "replay_id": create_replay_id,
        });
        resub.start();
        on_exit resub.stop();

        assertTrue(resumed.waitForRecordEvents(id, 2, LiveEventTimeout),
            "resuming after the create delivered the update and the delete");
        assertEq((ChangeTypeUpdate, ChangeTypeDelete), resumed.getRecordChangeTypes(id)[0..1],
            "the resumed subscription started after the create rather than at the tip");
        assertFalse(inlist(ChangeTypeCreate, resumed.getRecordChangeTypes(id)),
            "the event the replay ID names was not re-delivered");
    }

    #! Skips the calling test unless a live Salesforce connection is available
    private requireLiveConnection() {
        if (!sfconn) {
            testSkip(live_skip_reason ?? "no Salesforce connection");
        }
    }

    #! Returns the live CDC topic name, skipping the calling test if the org will not serve it
    /** A Change Data Capture entity that was never selected in Setup produces no \c TopicInfo at
        all -- \c GetTopic answers \c NOT_FOUND -- so that is what "not enabled" looks like here.
        Enabling it is not done: it changes org configuration and starts a 72-hour retention
        stream, which a test suite has no business doing on someone's org.
    */
    private string requireLiveCdcChannel(SalesforcePubSubClient client) {
        string topic = get_topic_name(LiveChannel);
        try {
            hash<auto> info = client.getTopic(topic);
            if (exists info.can_subscribe && !info.can_subscribe) {
                testSkip(sprintf("the org reports that %y cannot be subscribed to; check that the "
                    "connection's user has the \"View All Data\" or \"View All Records\" "
                    "permission for %y", topic, LiveEntity));
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.arg.status_code != GRPC_STATUS_NOT_FOUND) {
                rethrow;
            }
            testSkip(sprintf("Change Data Capture is not enabled for %y in this org, so %y carries "
                "nothing; enable it in Setup -> Integrations -> Change Data Capture, or with the "
                "\"enable-change-data-capture\" action, to run the live tests", LiveEntity, topic));
        }
        return topic;
    }

    #! Deletes a live test record, ignoring the failure if it is already gone
    private deleteLiveRecordQuietly(RestClientIo::RestClientIo api, string id) {
        try {
            api.restDel(sprintf("sobjects/%s/%s", LiveEntity, id));
        } catch (hash<ExceptionInfo> ex) {
            # the test deletes the record itself on the happy path, so this is the expected case
        }
    }
}
