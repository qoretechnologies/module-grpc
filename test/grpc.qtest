    testMultipleSequentialCalls() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                return {
                    "message": "Hello, " + request.name,
                    "status": request.id,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        # Make 5 sequential calls on the same client/channel
        for (int i = 0; i < 5; ++i) {
            hash<GrpcCallResult> result = client.call("UnaryCall",
                {"name": sprintf("User%d", i), "id": i});
            assertEq(GRPC_STATUS_OK, result.status_code,
                sprintf("call %d: status OK", i));
            assertEq(sprintf("Hello, User%d", i), result.body.message,
                sprintf("call %d: response message", i));
            assertEq(i, result.body.status,
                sprintf("call %d: response status", i));
        }
    }

    testConcurrentCalls() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                return {
                    "message": "Hello, " + request.name,
                    "status": 0,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        # Launch multiple concurrent calls
        int num_calls = 4;
        Counter done(num_calls);
        list<hash<auto>> results();
        Mutex results_mutex();

        for (int i = 0; i < num_calls; ++i) {
            int idx = i;
            background sub() {
                on_exit done.dec();
                try {
                    GrpcChannel ch("http://localhost:" + string(port));
                    on_exit ch.shutdown();
                    GrpcClient cl(ch, schema, "TestService");
                    hash<GrpcCallResult> r = cl.call("UnaryCall",
                        {"name": sprintf("Concurrent%d", idx), "id": idx});
                    {
                        AutoLock al(results_mutex);
                        results += {"idx": idx, "result": r};
                    }
                } catch (hash<ExceptionInfo> ex) {
                    {
                        AutoLock al(results_mutex);
                        results += {"idx": idx, "error": sprintf("%s: %s", ex.err, ex.desc)};
                    }
                }
            }();
        }

        done.waitForZero(30s);
        assertEq(num_calls, results.size(), "all concurrent calls completed");
        for (int i = 0; i < results.size(); ++i) {
            assertNothing(results[i].error,
                sprintf("concurrent call %d: no error", results[i].idx));
            assertEq(GRPC_STATUS_OK, results[i].result.status_code,
                sprintf("concurrent call %d: status OK", results[i].idx));
        }
    }

    # --- GrpcHelper multi-frame tests ---

    testUnframeMessages() {
        # Frame two messages
        binary msg1 = binary("hello");
        binary msg2 = binary("world");
        binary framed = GrpcHelper::frameMessage(msg1) + GrpcHelper::frameMessage(msg2);

        list<hash<auto>> messages = GrpcHelper::unframeMessages(framed);
        assertEq(2, messages.size(), "two messages");
        assertEq(msg1, messages[0].data, "first message data");
        assertEq(msg2, messages[1].data, "second message data");
        assertFalse(messages[0].compressed, "first not compressed");
    }

    testNextFrameSize() {
        binary payload = binary("test");
        binary framed = GrpcHelper::frameMessage(payload);

        assertEq(9, GrpcHelper::nextFrameSize(framed), "complete frame size");
        assertEq(-1, GrpcHelper::nextFrameSize(<00>), "incomplete header");
        assertEq(-1, GrpcHelper::nextFrameSize(binary()), "empty buffer");
    }

    # --- Streaming integration tests ---

    testServerStream() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ServerStream",
            sub(hash<auto> request, GrpcServerStream stream,
                    hash<string, string> metadata) {
                # Send multiple response messages
                for (int i = 0; i < 3; ++i) {
                    stream.write({
                        "message": sprintf("msg %d for %s", i, request.name),
                        "status": i,
                    });
                }
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        GrpcClientStream stream = client.serverStream("ServerStream",
            {"name": "World", "id": 1});

        # Read all messages
        list<hash<auto>> messages = ();
        while (*hash<auto> msg = stream.read(60s)) {
            messages += msg;
        }

        assertEq(3, messages.size(), "received 3 messages");
        assertEq("msg 0 for World", messages[0].message, "first message");
        assertEq("msg 1 for World", messages[1].message, "second message");
        assertEq("msg 2 for World", messages[2].message, "third message");
        assertEq(0, messages[0].status, "first status");
        assertEq(2, messages[2].status, "third status");

        hash<GrpcCallResult> result = stream.finish();
        assertEq(GRPC_STATUS_OK, result.status_code, "stream status OK");
    }

    testClientStream() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ClientStream",
            hash<auto> sub(GrpcServerStream stream, hash<string, string> metadata) {
                # Read all client messages and aggregate
                list<string> names = ();
                while (*hash<auto> msg = stream.read()) {
                    names += msg.name;
                }
                return {
                    "message": names.join(", "),
                    "status": names.size(),
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        GrpcClientStream stream = client.clientStream("ClientStream");
        stream.write({"name": "Alice", "id": 1});
        stream.write({"name": "Bob", "id": 2});
        stream.write({"name": "Charlie", "id": 3});

        hash<GrpcCallResult> result = stream.finish();
        assertEq(GRPC_STATUS_OK, result.status_code, "stream status OK");
        # The response should contain the aggregated names
        # Note: client-streaming returns a single response via finish()
    }

    testBidiStream() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "BidiStream",
            sub(GrpcServerStream stream, hash<string, string> metadata) {
                # Echo each client message back with a prefix
                while (*hash<auto> msg = stream.read()) {
                    stream.write({
                        "message": "echo: " + msg.name,
                        "status": msg.id,
                    });
                }
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        GrpcClientStream stream = client.bidiStream("BidiStream");

        # Send messages
        stream.write({"name": "one", "id": 1});
        stream.write({"name": "two", "id": 2});
        stream.writesDone();

        # Read responses
        list<hash<auto>> messages = ();
        while (*hash<auto> msg = stream.read(60s)) {
            messages += msg;
        }

        assertEq(2, messages.size(), "received 2 echo messages");
        assertEq("echo: one", messages[0].message, "first echo");
        assertEq("echo: two", messages[1].message, "second echo");

        hash<GrpcCallResult> result = stream.finish();
        assertEq(GRPC_STATUS_OK, result.status_code, "bidi stream status OK");
    }

    testServerStreamCancel() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ServerStream",
            sub(hash<auto> request, GrpcServerStream stream,
                    hash<string, string> metadata) {
