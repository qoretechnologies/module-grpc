    # --- Integration tests ---

    testUnaryCall() {
        ProtobufSchema schema(test_dir, "test.proto");

        # Set up server
        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                return {
                    "message": "Hello, " + request.name,
                    "status": 0,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        # Set up client
        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        # Make unary call with timeout
        hash<GrpcCallOptions> call_opts = <GrpcCallOptions>{
            "timeout_ms": 10000,
        };
        hash<GrpcCallResult> result = client.call("UnaryCall", {"name": "World", "id": 1}, call_opts);
        assertEq(GRPC_STATUS_OK, result.status_code, "status code OK");
        assertEq("OK", result.status_message, "status message OK");
        assertEq("Hello, World", result.body.message, "response message");
        assertEq(0, result.body.status, "response status");
    }

    testUnaryCallMetadata() {
        ProtobufSchema schema(test_dir, "test.proto");

        # Server that echoes metadata
        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
