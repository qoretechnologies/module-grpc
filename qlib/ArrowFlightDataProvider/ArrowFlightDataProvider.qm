%modern
%allow-weak-references

%requires(reexport) DataProvider
%requires(reexport) ConnectionProvider
%requires grpc
%requires GrpcUtil

module ArrowFlightDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for Arrow Flight services";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-grpc";
    license = "MIT";
    init = sub () {
        # Register data provider factory
        DataProvider::registerFactory(new ArrowFlightDataProviderFactory());

        # Register connection schemes
        ConnectionSchemeCache::registerScheme("flight", ArrowFlightConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("flights", ArrowFlightConnection::ConnectionScheme);

        # Path variable shared by all dataset-level actions
        hash<string, hash<DataProviderPathVarInfo>> dataset_path_var = {
            "dataset": <DataProviderPathVarInfo>{
                "display_name": "Dataset",
                "short_desc": "The Flight dataset name",
                "desc": "The Arrow Flight dataset name as registered on the server",
                "example_value": "my-dataset",
            },
        };

        # Register app in action catalog
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ArrowFlightDataProvider::AppName,
            "display_name": "Arrow Flight",
            "short_desc": "Arrow Flight columnar data service",
            "desc": "Connect to [Apache Arrow Flight](https://arrow.apache.org/docs/format/"
                "Flight.html) services for high-performance columnar data exchange using "
                "Apache Arrow IPC format.\n\n"
                "**Supported operations**:\n"
                "- **DoGet**: streaming read of columnar data\n"
                "- **DoPut**: streaming write of columnar data\n"
                "- **DoExchange**: bidirectional streaming data transformation\n"
                "- **DoAction**: execute custom server actions\n"
                "- **ListFlights / GetFlightInfo**: dataset discovery and metadata",
            "scheme": "flight",
            "groups": (DataProvider::AppGroup::ApiIntegration,),
            "logo": ArrowFlightLogo,
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "arrow-flight-logo.svg",
        });

        # ---- DPAT_API actions: Data Operations ----

        # Get Flight Data (DoGet)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/{dataset}/get",
            "path_vars": dataset_path_var,
            "action": "get-flight-data",
            "groups": "Data Operations",
            "display_name": "Get Flight Data",
            "short_desc": "Retrieve data from an Arrow Flight dataset",
            "desc": "Retrieves columnar data from an Arrow Flight service via the DoGet "
                "streaming RPC; returns all record batches as a list of row hashes",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DoGetRequestFields),
            "output_type": AbstractDataProviderType::get(SoftListType),
        });

        # Put Flight Data (DoPut)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/{dataset}/put",
            "path_vars": dataset_path_var,
            "action": "put-flight-data",
            "groups": "Data Operations",
            "display_name": "Put Flight Data",
            "short_desc": "Send data to an Arrow Flight dataset",
            "desc": "Sends columnar data to an Arrow Flight service via the DoPut streaming "
                "RPC; the data is sent as one or more Arrow record batches",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DoPutRequestFields),
            "output_type": AbstractDataProviderType::get(AutoHashType),
        });

        # Exchange Flight Data (DoExchange)
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/{dataset}/exchange",
            "path_vars": dataset_path_var,
            "action": "exchange-flight-data",
            "groups": "Data Operations",
            "display_name": "Exchange Flight Data",
            "short_desc": "Bidirectional data exchange on an Arrow Flight dataset",
            "desc": "Performs a bidirectional data exchange via the DoExchange streaming RPC; "
                "sends input rows and receives transformed output rows",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DoExchangeRequestFields),
            "output_type": AbstractDataProviderType::get(SoftListType),
        });

        # ---- DPAT_API actions: Discovery ----

        # List Flights
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/list-flights",
            "action": "list-flights",
            "groups": "Discovery",
            "display_name": "List Flights",
            "short_desc": "List available Arrow Flight datasets",
            "desc": "Discovers available datasets on the Arrow Flight server via the "
                "ListFlights RPC; returns a list of FlightInfo hashes with dataset metadata",
            "action_code": DPAT_API,
            "options": {},
            "output_type": new SoftListDataType("FlightInfoList",
                new FlightInfoListResponseDataType()),
        });

        # Get Flight Info
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/get-flight-info",
            "action": "get-flight-info",
            "groups": "Discovery",
            "display_name": "Get Flight Info",
            "short_desc": "Get metadata for an Arrow Flight dataset",
            "desc": "Retrieves metadata for a specific dataset via the GetFlightInfo RPC, "
                "including schema, record count, and endpoint information",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                GetFlightInfoRequestDataType::Fields),
            "output_type": new FlightInfoListResponseDataType(),
        });

        # ---- DPAT_API actions: Actions ----

        # Do Action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/do-action",
            "action": "do-action",
            "groups": "Actions",
            "display_name": "Execute Flight Action",
            "short_desc": "Execute a custom action on the Arrow Flight server",
            "desc": "Executes a custom server-side action via the DoAction RPC; the action "
                "type and optional binary body are sent to the server, which returns a list "
                "of binary results",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                DoActionRequestDataType::Fields),
            "output_type": new SoftListDataType("DoActionResultList",
                new DoActionResponseDataType()),
        });

        # List Actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ArrowFlightDataProvider::AppName,
            "path": "/list-actions",
            "action": "list-actions",
            "groups": "Actions",
            "display_name": "List Flight Actions",
            "short_desc": "List available actions on the Arrow Flight server",
            "desc": "Lists custom actions available on the Arrow Flight server via the "
                "ListActions RPC; each action has a type identifier and description",
            "action_code": DPAT_API,
            "options": {},
            "output_type": new SoftListDataType("ActionTypeList",
                new ActionTypeResponseDataType()),
        });

        # NOTE: DPAT_EVENT actions for DoGet/DoExchange stream events are not
        # registered here because they require persistent streaming connections,
        # which are not yet supported in the action catalog framework.  The event
        # infrastructure (ArrowFlightStreamEventDataProvider) is fully functional
        # and can be used programmatically via the data provider observer API.
    };
}

/** @mainpage ArrowFlightDataProvider Module

    @tableofcontents

    @section arrowflightdataproviderintro ArrowFlightDataProvider Module Introduction

    The %ArrowFlightDataProvider module integrates Apache Arrow Flight services into Qore's
    data provider framework, enabling high-performance columnar data exchange alongside
    REST, SOAP, gRPC, and other protocols through a uniform API.

    Key capabilities:
    - <b>Columnar data exchange</b>: Arrow Flight transfers data in columnar Apache Arrow
      IPC format for zero-copy, high-throughput data access
    - <b>Dynamic dataset discovery</b>: datasets are discovered automatically via the
      Flight \c ListFlights RPC
    - <b>Three data patterns</b>: DoGet (read), DoPut (write), and DoExchange
      (bidirectional transformation)
    - <b>Observable streams</b>: DoGet and DoExchange methods expose an \c events child
      provider for event-driven batch consumption via the DataProvider observer pattern
    - <b>Connection management</b>: \c flight:// and \c flights:// URL schemes integrate
      with Qore's connection framework

    @subsection arrowflightdataprovider_hierarchy Provider Hierarchy

    Arrow Flight datasets are navigated as a three-level hierarchy:

    @verbatim
<root>
  └── <DatasetName>      (ArrowFlightDatasetDataProvider)
        ├── get           (ArrowFlightMethodDataProvider — DoGet)
        │   └── events    (ArrowFlightStreamEventDataProvider)
        ├── put           (ArrowFlightMethodDataProvider — DoPut)
        └── exchange      (ArrowFlightMethodDataProvider — DoExchange)
              └── events  (ArrowFlightStreamEventDataProvider)
    @endverbatim

    @subsection arrowflightdataprovider_classes Provided Classes

    - @ref ArrowFlightDataProvider::ArrowFlightDataProvider "ArrowFlightDataProvider":
      root provider with dataset discovery via ListFlights
    - @ref ArrowFlightDataProvider::ArrowFlightDataProviderFactory "ArrowFlightDataProviderFactory":
      factory for creating providers from constructor options
    - @ref ArrowFlightDataProvider::ArrowFlightDatasetDataProvider "ArrowFlightDatasetDataProvider":
      dataset-level container provider
    - @ref ArrowFlightDataProvider::ArrowFlightMethodDataProvider "ArrowFlightMethodDataProvider":
      method-level provider supporting DoGet, DoPut, and DoExchange
    - @ref ArrowFlightDataProvider::ArrowFlightStreamEventDataProvider "ArrowFlightStreamEventDataProvider":
      observable event provider for DoGet and DoExchange streaming;
      DoExchange also supports sending batches
    - @ref ArrowFlightDataProvider::ArrowFlightConnection "ArrowFlightConnection":
      connection provider with \c flight:// and \c flights:// URL schemes
    - @ref ArrowFlightDataProvider::ArrowFlightTypeHelper "ArrowFlightTypeHelper":
      Arrow-to-DataProvider type mapping

    @section arrowflightdataprovider_factory ArrowFlightDataProvider Factory

    The name of the Arrow Flight data provider factory is <b><tt>flight</tt></b>.

    @subsection arrowflightdataprovider_factory_options Factory Options

    The factory supports the following constructor options:

    | Option | Type | Description |
    |--------|------|-------------|
    | \c url | string | Arrow Flight server URL (\c http://host:port or \c https://host:port) |
    | \c timeout_ms | int | Default call timeout in milliseconds (default: \c 30000) |

    @section arrowflightdataprovider_examples ArrowFlightDataProvider Examples

    @subsection arrowflightdataprovider_examples_doget DoGet with qdp

    @par Example: read all data from a dataset
    @verbatim qdp 'flight{url=http://localhost:8815}/sales/get' dor
    @endverbatim

    @subsection arrowflightdataprovider_examples_connection Named Connection

    @par Example: read data via a named connection
    @verbatim qdp myflight/sales/get dor
    @endverbatim

    @subsection arrowflightdataprovider_examples_events Observable Events

    @par Example: subscribe to streaming DoGet events
    @verbatim qdp -s myflight myflight/sales/get/events listen
    @endverbatim

    @section arrowflightdataprovider_programmatic Programmatic Usage

    @code{.py}
%modern
%requires ArrowFlightDataProvider

ArrowFlightDataProvider provider({"url": "http://localhost:8815"});

# List available datasets
map printf("Dataset: %s\n", $1), provider.getChildProviderNames();

# Read data from a dataset
auto rows = provider.getChildProvider("sales")
    .getChildProvider("get")
    .doRequest(NOTHING);
printf("Got %d rows\n", rows.size());
    @endcode

    @section arrowflightdataprovider_connections Connection Schemes

    The module registers two connection URL schemes:
    - \c flight://host:port — plaintext HTTP/2 (h2c)
    - \c flights://host:port — TLS-encrypted HTTP/2

    @section arrowflightdataprovider_relnotes Release Notes

    @subsection arrowflightdataprovider_v1_0 ArrowFlightDataProvider v1.0
    - initial release
    - @ref ArrowFlightDataProvider::ArrowFlightDataProvider "ArrowFlightDataProvider": root
      provider with dataset discovery via ListFlights
    - @ref ArrowFlightDataProvider::ArrowFlightDatasetDataProvider "ArrowFlightDatasetDataProvider":
      dataset-level container provider
    - @ref ArrowFlightDataProvider::ArrowFlightMethodDataProvider "ArrowFlightMethodDataProvider":
      method-level provider supporting DoGet, DoPut, and DoExchange
    - @ref ArrowFlightDataProvider::ArrowFlightStreamEventDataProvider "ArrowFlightStreamEventDataProvider":
      observable event provider for streaming methods
    - @ref ArrowFlightDataProvider::ArrowFlightConnection "ArrowFlightConnection": connection
      provider with \c flight:// and \c flights:// URL schemes
*/

#! Contains all public definitions in the ArrowFlightDataProvider module
public namespace ArrowFlightDataProvider {
    #! MIME type for SVG images
    public const MimeTypeSvg = "image/svg+xml";

    #! Static request fields for DoGet action registration
    public const DoGetRequestFields = {
        "ticket": {
            "display_name": "Ticket",
            "short_desc": "Flight ticket as binary data",
            "type": AbstractDataProviderType::get(SoftBinaryOrNothingType),
            "desc": "Optional flight ticket; defaults to the dataset path if not provided",
        },
    };

    #! Static request fields for DoPut action registration
    public const DoPutRequestFields = {
        "rows": {
            "display_name": "Rows",
            "short_desc": "Row data to send",
            "type": AbstractDataProviderType::get(SoftListType),
            "desc": "List of row hashes to send as Arrow record batches",
            "required": True,
        },
    };

    #! Static request fields for DoExchange action registration
    public const DoExchangeRequestFields = {
        "rows": {
            "display_name": "Rows",
            "short_desc": "Input row data to send",
            "type": AbstractDataProviderType::get(SoftListType),
            "desc": "List of input row hashes to send for bidirectional exchange",
            "required": True,
        },
    };

    #! Arrow Flight logo in SVG format for the action catalog
    public const ArrowFlightLogo = File::readTextFile(get_script_dir()
        + "/arrow-flight-logo.svg");
}
