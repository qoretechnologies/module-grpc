%modern

%requires protobuf
%requires grpc
%requires HttpClientIo
%requires AsyncSocketIo
%requires HttpServerAsyncIo

module GrpcUtil {
    version = "1.0";
    desc = "Qore gRPC protocol module";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-grpc";
    license = "MIT";
}

#! Main Grpc namespace
/** All public declarations in the %GrpcUtil module are defined in this namespace.
*/
public namespace Grpc {
}

/** @mainpage GrpcUtil Module

    @tableofcontents

    @section grpcutilintro GrpcUtil Module Introduction

    The %GrpcUtil module provides a pure-Qore implementation of the gRPC protocol
    built on top of Qore's HTTP/2 infrastructure. gRPC is the standard protocol
    for high-performance microservice communication used by organizations such as
    Google, Netflix, and Square, and is the default transport for many cloud-native
    APIs including Kubernetes, Envoy, and etcd.

    This module enables Qore applications to act as both gRPC clients and servers
    without any external gRPC library dependency (only \c libprotobuf is required
    for message serialization). All four gRPC call patterns are supported:
    - <b>Unary</b>: single request, single response (like a REST call)
    - <b>Server streaming</b>: single request, stream of responses (e.g., live
      data feeds, paginated results)
    - <b>Client streaming</b>: stream of requests, single response (e.g., file
      upload, batch ingestion)
    - <b>Bidirectional streaming</b>: concurrent request and response streams
      (e.g., chat, real-time sync)

    The following classes are provided by this module:
    - @ref Grpc::GrpcClient "GrpcClient": makes gRPC calls to a remote service
    - @ref Grpc::GrpcServer "GrpcServer": serves gRPC requests with registered
      handlers
    - @ref Grpc::GrpcChannel "GrpcChannel": manages HTTP/2 connections with
      pooling via \c HttpClientConnectionManager
    - @ref Grpc::GrpcClientStream "GrpcClientStream": client-side streaming
      handle with read/write/cancel
    - @ref Grpc::GrpcServerStream "GrpcServerStream": server-side streaming
      handle with read/write and metadata support
    - @ref Grpc::GrpcHelper "GrpcHelper": gRPC framing, header utilities, and
      timeout formatting
    - @ref Grpc::GrpcReflectionService "GrpcReflectionService": built-in gRPC
      server reflection (grpc.reflection.v1) enabling clients to discover
      services without local \c .proto files

    For the data provider API integration (factory, connections, action catalog),
    see the @ref grpcdataproviderintro "GrpcDataProvider module".

    @section grpcutil_client_usage Client Usage

    @subsection grpcutil_client_unary Unary Calls

    A unary call sends a single request and receives a single response:

    @code{.py}
%modern
%requires grpc
%requires GrpcUtil

ProtobufSchema schema("./proto/", "helloworld.proto");
GrpcChannel channel("http://localhost:50051");
GrpcClient client(channel, schema, "Greeter");

hash<GrpcCallResult> result = client.call("SayHello", {"name": "World"});
printf("Response: %y\n", result.body);
printf("Status: %d %s\n", result.status_code, result.status_message);

channel.shutdown();
    @endcode

    @subsection grpcutil_client_serverstream Server Streaming

    Server streaming sends a single request and receives a stream of responses:

    @code{.py}
GrpcClientStream stream = client.serverStream("ListItems", {"category": "books"});
while (*hash<auto> item = stream.read(5s)) {
    printf("Item: %y\n", item);
}
hash<GrpcCallResult> result = stream.finish();
    @endcode

    @subsection grpcutil_client_clientstream Client Streaming

    Client streaming sends a stream of requests and receives a single response:

    @code{.py}
GrpcClientStream stream = client.clientStream("Upload");
stream.write({"chunk": "data1"});
stream.write({"chunk": "data2"});
stream.writesDone();
hash<GrpcCallResult> result = stream.finish();
printf("Uploaded %d chunks\n", result.body.total);
    @endcode

    @subsection grpcutil_client_bidi Bidirectional Streaming

    Bidirectional streaming supports concurrent request and response streams.
    The client can interleave reads and writes for interactive communication:

    @code{.py}
GrpcClientStream stream = client.bidiStream("Chat");
# Send a message and read the response before sending the next
stream.write({"text": "Hello"});
*hash<auto> reply1 = stream.read(5s);
printf("Reply: %s\n", reply1.text);

stream.write({"text": "World"});
*hash<auto> reply2 = stream.read(5s);
printf("Reply: %s\n", reply2.text);

stream.writesDone();
hash<GrpcCallResult> result = stream.finish();
    @endcode

    Use @ref Grpc::GrpcClientStream::readsDone() "readsDone()" to distinguish
    a read timeout from the server closing its side of the stream:

    @code{.py}
GrpcClientStream stream = client.bidiStream("Chat");
stream.write({"text": "Hello"});
stream.write({"text": "World"});
stream.writesDone();
while (*hash<auto> msg = stream.read(5s)) {
    printf("Reply: %s\n", msg.text);
}
# readsDone() returns True when the server has closed its side
printf("Stream ended: %y\n", stream.readsDone());
hash<GrpcCallResult> result = stream.finish();
    @endcode

    @subsection grpcutil_client_metadata Metadata and Timeouts

    Custom metadata and timeouts can be set on any call:

    @code{.py}
hash<GrpcCallOptions> opts = <GrpcCallOptions>{
    "timeout_ms": 5000,
    "metadata": {"x-request-id": "abc-123"},
};
hash<GrpcCallResult> result = client.call("GetOrder", {"id": 42}, opts);
# Access trailing metadata from the response
*string trace_id = result.trailing_metadata."x-trace-id";
    @endcode

    @section grpcutil_server_usage Server Usage

    @subsection grpcutil_server_basic Basic Server

    @code{.py}
%modern
%requires grpc
%requires GrpcUtil

ProtobufSchema schema("./proto/", "helloworld.proto");
GrpcServer server(schema);

# Register a unary handler
server.registerHandler("Greeter", "SayHello",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        return {"message": "Hello, " + request.name};
    });

int port = server.addInsecurePort("localhost:0");
printf("Server listening on port %d\n", port);
server.start();
server.wait();
    @endcode

    @subsection grpcutil_server_streaming Server-Streaming Handler

    @code{.py}
server.registerHandler("Items", "ListItems",
    sub(hash<auto> request, GrpcServerStream stream, hash<string, string> metadata) {
        for (int i = 0; i < 10; ++i) {
            stream.write({"name": sprintf("item-%d", i), "category": request.category});
        }
        stream.setTrailingMetadata({"x-count": "10"});
    });
    @endcode

    @subsection grpcutil_server_bidi Bidirectional Streaming Handler

    Bidirectional streaming handlers receive a @ref Grpc::GrpcServerStream "GrpcServerStream"
    for interactive communication. The handler reads client messages incrementally
    and writes responses immediately -- no pre-buffering of the client stream:

    @code{.py}
server.registerHandler("Chat", "Send",
    sub(GrpcServerStream stream, hash<string, string> metadata) {
        while (*hash<auto> msg = stream.read(30s)) {
            # Process each message and respond immediately
            stream.write({"text": "Echo: " + msg.text});
        }
    });
    @endcode

    @subsection grpcutil_server_clientstream Client Streaming Handler

    Client streaming handlers also use @ref Grpc::GrpcServerStream "GrpcServerStream"
    but return a response hash instead of writing to the stream:

    @code{.py}
server.registerHandler("Upload", "Send",
    hash<auto> sub(GrpcServerStream stream, hash<string, string> metadata) {
        int count = 0;
        while (*hash<auto> msg = stream.read()) {
            ++count;
        }
        return {"total": count};
    });
    @endcode

    @subsection grpcutil_server_tls TLS Support

    @code{.py}
string cert = ReadOnlyFile::readTextFile("server.crt");
string key = ReadOnlyFile::readTextFile("server.key");
int port = server.addSecurePort("localhost:0", <GrpcSslOptions>{
    "server_cert": cert,
    "server_key": key,
});
server.start();

# Client connects via HTTPS
GrpcChannel channel("https://localhost:" + port);
    @endcode

    @section grpcutil_protobuf Standalone Protobuf Usage

    The \c protobuf built-in module provides \c ProtobufSchema for protobuf
    encoding/decoding independent of gRPC:

    @code{.py}
%modern
%requires protobuf

ProtobufSchema schema("./proto/", "messages.proto");

# Binary encoding/decoding
binary data = schema.encode("MyMessage", {"field": "value", "count": 42});
hash<auto> msg = schema.decode("MyMessage", data);

# JSON conversion
string json = schema.toJson("MyMessage", {"field": "value"});
hash<auto> parsed = schema.fromJson("MyMessage", json);

# Schema introspection
hash<auto> msg_schema = schema.messageSchema("MyMessage");
printf("Fields: %y\n", keys msg_schema.fields);
    @endcode

    @section grpcutilrelnotes Release Notes

    @subsection grpcutil_v1_0 GrpcUtil Module Version 1.0

    - initial release
    - @ref Grpc::GrpcReflectionService "GrpcReflectionService": built-in gRPC server
      reflection (grpc.reflection.v1) enabling client discovery of services via
      \c list_services, \c file_containing_symbol, and \c file_by_filename requests;
      also available via the \c enable_reflection
      @ref Qore::Grpc::GrpcServerOptions "GrpcServerOptions" flag
    - @ref Grpc::GrpcServer "GrpcServer": handler exceptions with \c GRPC-* prefixes
      (e.g. \c GRPC-NOT-FOUND, \c GRPC-UNIMPLEMENTED, \c GRPC-DEADLINE-EXCEEDED) map
      to the appropriate gRPC status code; all other exceptions return \c GRPC_STATUS_INTERNAL
    - @ref Grpc::GrpcClient "GrpcClient": unary, server streaming, client streaming, bidirectional streaming
    - @ref Grpc::GrpcServer "GrpcServer": handler registration, async I/O, TLS support
    - true interactive bidirectional streaming: server handlers process client messages
      incrementally via @ref Grpc::GrpcServerStream "GrpcServerStream" (headers-only dispatch
      with live HTTP/2 stream reading, no pre-buffering)
    - @ref Grpc::GrpcChannel "GrpcChannel": connection pooling via HttpClientConnectionManager
    - @ref Grpc::GrpcClientStream "GrpcClientStream": client-side streaming with read/write/cancel/readsDone
    - @ref Grpc::GrpcServerStream "GrpcServerStream": server-side streaming with
      read/write, metadata support, and both buffered and live reading modes
    - @ref Grpc::GrpcHelper "GrpcHelper": gRPC framing, header utilities, timeout formatting
    - custom metadata passing (request, initial response, trailing)
    - timeout/deadline enforcement via \c grpc-timeout header
    - gRPC status codes and error handling
    - <b>Arrow Flight protocol</b> (optional, requires Apache Arrow):
      - @ref Grpc::FlightProto "FlightProto": embedded Arrow Flight protocol schema
      - @ref Grpc::ArrowFlightClient "ArrowFlightClient": typed Flight RPCs (ListFlights,
        GetFlightInfo, DoGet, DoPut, DoExchange, DoAction)
      - @ref Grpc::ArrowFlightServer "ArrowFlightServer": Flight server with dataset and
        action registration
      - @ref Grpc::ArrowFlightStreamReader "ArrowFlightStreamReader": DoGet stream reader
      - @ref Grpc::ArrowFlightStreamWriter "ArrowFlightStreamWriter": DoPut stream writer
      - @ref Grpc::ArrowFlightExchangeStream "ArrowFlightExchangeStream": bidirectional
        DoExchange stream
      - @ref Grpc::ArrowFlightDatasetHandler "ArrowFlightDatasetHandler": abstract base for
        user-implemented Flight datasets
      - @ref Grpc::ArrowFlightHelper "ArrowFlightHelper": FlightData to/from Arrow object
        conversion
      - incoming Flight IPC \c data_header and \c data_body buffers are wrapped without copying
        when decoding record batches
*/
