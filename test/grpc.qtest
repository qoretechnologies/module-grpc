    # --- TLS tests ---

    testTlsSecure() {
        ProtobufSchema schema(test_dir, "test.proto");

        # Read test certificates
        string cert_dir = test_dir + "/certs";
        string server_cert = ReadOnlyFile::readTextFile(cert_dir + "/server.crt");
        string server_key = ReadOnlyFile::readTextFile(cert_dir + "/server.key");

        # Set up server with TLS
        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                return {
                    "message": "TLS Hello, " + request.name,
                    "status": 0,
                };
            });
        int port = server.addSecurePort("localhost:0", <GrpcSslOptions>{
            "server_cert": server_cert,
            "server_key": server_key,
        });
        server.start();
        on_exit server.shutdown();

        # Connect with HTTPS (accept all certs since self-signed)
        GrpcChannel channel("https://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        hash<GrpcCallResult> result = client.call("UnaryCall",
            {"name": "World", "id": 1});
        assertEq(GRPC_STATUS_OK, result.status_code, "TLS status code OK");
        assertEq("TLS Hello, World", result.body.message, "TLS response message");
    }

    # --- Metadata tests ---

    testServerTrailingMetadata() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ServerStream",
            sub(hash<auto> request, GrpcServerStream stream,
                    hash<string, string> metadata) {
                # Set custom trailing metadata
                stream.setTrailingMetadata({
                    "x-request-count": "2",
                    "x-server-id": "test-server",
                });
                stream.write({
                    "message": "msg 0",
                    "status": 0,
                });
                stream.write({
                    "message": "msg 1",
                    "status": 1,
                });
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        GrpcClientStream stream = client.serverStream("ServerStream",
            {"name": "meta-test", "id": 1});

        # Drain messages
        list<hash<auto>> messages = ();
        while (*hash<auto> msg = stream.read(5s)) {
            messages += msg;
        }
        assertEq(2, messages.size(), "received 2 messages");

        hash<GrpcCallResult> result = stream.finish();
        assertEq(GRPC_STATUS_OK, result.status_code, "status OK");
        assertEq("2", result.trailing_metadata."x-request-count",
            "custom trailing metadata: request count");
        assertEq("test-server", result.trailing_metadata."x-server-id",
            "custom trailing metadata: server id");
    }

    testServerInitialMetadata() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ServerStream",
            sub(hash<auto> request, GrpcServerStream stream,
                    hash<string, string> metadata) {
                # Send initial metadata before writing messages
                stream.sendInitialMetadata({
                    "x-server-version": "1.0",
                });
                stream.write({
                    "message": "with initial metadata",
                    "status": 0,
                });
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        GrpcClientStream cstream = client.serverStream("ServerStream",
            {"name": "init-meta", "id": 1});

        *hash<auto> msg = cstream.read(5s);
        assertTrue(exists msg, "got message with initial metadata");
        assertEq("with initial metadata", msg.message, "message content");

        hash<GrpcCallResult> result = cstream.finish();
        assertEq(GRPC_STATUS_OK, result.status_code, "status OK");
    }

    testUnaryTrailingMetadata() {
        ProtobufSchema schema(test_dir, "test.proto");

        # Unary calls always return trailing metadata from trailers
        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                return {
                    "message": "Hello, " + request.name,
                    "status": 0,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        hash<GrpcCallResult> result = client.call("UnaryCall",
            {"name": "test", "id": 1});
        assertEq(GRPC_STATUS_OK, result.status_code, "status OK");
        # Trailing metadata should have grpc-status/message filtered out
        # but should be a valid (possibly empty) hash
        assertTrue(result.trailing_metadata.typeCode() == NT_HASH,
            "trailing_metadata is a hash");
    }

    # --- Timeout/deadline tests ---

    testDeadlineNotExceeded() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                # Fast handler — should not exceed deadline
                return {
                    "message": "fast response",
                    "status": 0,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        # Call with generous timeout
        hash<GrpcCallOptions> opts = <GrpcCallOptions>{
            "timeout_ms": 30000,
        };
        hash<GrpcCallResult> result = client.call("UnaryCall",
            {"name": "test", "id": 1}, opts);
        assertEq(GRPC_STATUS_OK, result.status_code,
            "deadline not exceeded: status OK");
        assertEq("fast response", result.body.message, "response message");
    }

    testDeadlineExceeded() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                # Slow handler — will exceed a very short deadline
                usleep(500ms);
                return {
                    "message": "slow response",
                    "status": 0,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        # Call with very short timeout (1ms)
        hash<GrpcCallOptions> opts = <GrpcCallOptions>{
            "timeout_ms": 1,
        };
        hash<GrpcCallResult> result = client.call("UnaryCall",
            {"name": "test", "id": 1}, opts);
        assertEq(GRPC_STATUS_DEADLINE_EXCEEDED, result.status_code,
            "deadline exceeded: status DEADLINE_EXCEEDED");
    }

    testTimeoutNotLeakedToMetadata() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "UnaryCall",
            hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
                # grpc-timeout should NOT appear in handler metadata
                return {
                    "message": exists metadata."grpc-timeout" ? "leaked" : "clean",
                    "status": 0,
                };
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        hash<GrpcCallOptions> opts = <GrpcCallOptions>{
            "timeout_ms": 30000,
        };
        hash<GrpcCallResult> result = client.call("UnaryCall",
            {"name": "test", "id": 1}, opts);
        assertEq(GRPC_STATUS_OK, result.status_code, "status OK");
        assertEq("clean", result.body.message,
            "grpc-timeout not leaked to handler metadata");
    }

    testDeadlineExceededStreaming() {
        ProtobufSchema schema(test_dir, "test.proto");

        GrpcServer server(schema);
        server.registerHandler("TestService", "ServerStream",
            sub(hash<auto> request, GrpcServerStream stream,
                    hash<string, string> metadata) {
                # Slow streaming handler — will exceed a short deadline
                usleep(500ms);
                stream.write({
                    "message": "late message",
                    "status": 0,
                });
            });
        int port = server.addInsecurePort("localhost:0");
        server.start();
        on_exit server.shutdown();

        GrpcChannel channel("http://localhost:" + string(port));
        on_exit channel.shutdown();
        GrpcClient client(channel, schema, "TestService");

        hash<GrpcCallOptions> opts = <GrpcCallOptions>{
            "timeout_ms": 1,
        };
        GrpcClientStream stream = client.serverStream("ServerStream",
            {"name": "deadline-test", "id": 1}, opts);

        # Drain messages
        while (stream.read(5s)) {
            # May or may not receive messages depending on timing
        }

        hash<GrpcCallResult> result = stream.finish();
        assertEq(GRPC_STATUS_DEADLINE_EXCEEDED, result.status_code,
            "streaming deadline exceeded: status DEADLINE_EXCEEDED");
    }

