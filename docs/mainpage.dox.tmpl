/** @mainpage Qore grpc Module

    @tableofcontents

    @section grpcintro grpc Module Introduction

    The \c grpc module provides gRPC client/server and protobuf support for %Qore using dynamic
    protobuf schema loading — users load \c .proto files at runtime and work with %Qore hashes,
    with no code generation required.

    The module is built natively on %Qore's HTTP/2 infrastructure, not wrapping libgrpc++. The
    only C++ dependency is \c libprotobuf.

    To use this module, use \c "%requires grpc" in your code for the binary protobuf support and
    \c "%requires GrpcUtil" for the gRPC protocol layer.

    @section grpcarch Architecture

    The module has two layers:

    - <b>Binary module (\c grpc.so)</b>: C++ QPP wrapping \c libprotobuf for schema loading
      and message encoding/decoding. Provides the @ref Qore::Grpc::ProtobufSchema class.
    - <b>Qore module (\c GrpcUtil)</b>: Pure %Qore implementing the gRPC protocol on top of
      %Qore's HTTP/2 stack. Provides @ref Qore::Grpc::GrpcClient, @ref Qore::Grpc::GrpcServer,
      @ref Qore::Grpc::GrpcChannel, and streaming classes.

    @section grpcquickstart Quick Start

    @subsection grpcunary Unary Call

    @code{.py}
#!/usr/bin/env qore

%modern
%requires grpc
%requires GrpcUtil

# Load a .proto schema
ProtobufSchema schema("./proto/", "service.proto");

# Create a channel and client
GrpcChannel channel("http://localhost:50051");
GrpcClient client(channel, schema, "MyService");

# Make a unary call
hash<GrpcCallResult> result = client.call("SayHello", {"name": "World"});
printf("Response: %y\n", result.body);
printf("Status: %d %s\n", result.status_code, result.status_message);

# Clean up
channel.shutdown();
    @endcode

    @subsection grpcserver Server

    @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
GrpcServer server(schema);

# Register a unary handler
server.registerHandler("MyService", "SayHello",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        return {"message": "Hello, " + request.name, "status": 0};
    });

int port = server.addInsecurePort("localhost:0");
server.start();
printf("Server listening on port %d\n", port);
server.wait();
    @endcode

    @section grpcstreaming Streaming

    The module supports all four gRPC streaming patterns.

    @subsection grpcserverstream Server Streaming

    The client sends a single request and reads a stream of responses.

    @code{.py}
# Client
GrpcClientStream stream = client.serverStream("ListItems", {"category": "books"});
while (*hash<auto> item = stream.read(5s)) {
    printf("Item: %y\n", item);
}
hash<GrpcCallResult> result = stream.finish();

# Server handler
server.registerHandler("MyService", "ListItems",
    sub(hash<auto> request, GrpcServerStream stream, hash<string, string> metadata) {
        list<hash<auto>> items = getItems(request.category);
        for (int i = 0; i < items.size(); ++i) {
            stream.write(items[i]);
        }
    });
    @endcode

    @subsection grpcclientstream Client Streaming

    The client sends a stream of messages and receives a single response.

    @code{.py}
# Client
GrpcClientStream stream = client.clientStream("UploadData");
stream.write({"chunk": "data1"});
stream.write({"chunk": "data2"});
hash<GrpcCallResult> result = stream.finish();

# Server handler
server.registerHandler("MyService", "UploadData",
    hash<auto> sub(GrpcServerStream stream, hash<string, string> metadata) {
        list<string> chunks = ();
        while (*hash<auto> msg = stream.read()) {
            chunks += msg.chunk;
        }
        return {"total_chunks": chunks.size()};
    });
    @endcode

    @subsection grpcbidi Bidirectional Streaming

    Both client and server send streams of messages.

    @code{.py}
# Client
GrpcClientStream stream = client.bidiStream("Chat");
stream.write({"text": "Hello"});
stream.write({"text": "How are you?"});
stream.writesDone();
while (*hash<auto> msg = stream.read(5s)) {
    printf("Reply: %s\n", msg.text);
}
hash<GrpcCallResult> result = stream.finish();

# Server handler
server.registerHandler("MyService", "Chat",
    sub(GrpcServerStream stream, hash<string, string> metadata) {
        while (*hash<auto> msg = stream.read()) {
            stream.write({"text": "Echo: " + msg.text});
        }
    });
    @endcode

    @section grpctls TLS/SSL

    @subsection grpctlsserver Server TLS

    @code{.py}
# Read certificate and key files
string cert = ReadOnlyFile::readTextFile("server.crt");
string key = ReadOnlyFile::readTextFile("server.key");

GrpcServer server(schema);
int port = server.addSecurePort("localhost:0", <GrpcSslOptions>{
    "server_cert": cert,
    "server_key": key,
});
server.start();
    @endcode

    @subsection grpctlsclient Client TLS

    @code{.py}
# Connect via HTTPS (accepts all certs by default)
GrpcChannel channel("https://localhost:50051");

# Or with strict certificate verification
GrpcChannel channel("https://localhost:50051", <GrpcChannelOptions>{
    "ssl": <GrpcSslOptions>{
        "root_certs": ReadOnlyFile::readTextFile("ca.crt"),
    },
});
    @endcode

    @section grpcmetadata Metadata

    Metadata (key-value pairs) can be passed between client and server via HTTP/2 headers
    and trailers.

    @subsection grpcreqmeta Request Metadata (Client to Server)

    @code{.py}
# Client sends metadata
hash<GrpcCallOptions> opts = <GrpcCallOptions>{
    "metadata": {
        "x-request-id": "abc-123",
        "authorization": "Bearer token",
    },
};
hash<GrpcCallResult> result = client.call("Method", request, opts);

# Server receives metadata
server.registerHandler("Service", "Method",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        string req_id = metadata."x-request-id";
        # ...
    });
    @endcode

    @subsection grpcrespmeta Response Metadata (Server to Client)

    @code{.py}
# Server sends initial metadata (streaming only)
server.registerHandler("Service", "ServerStream",
    sub(hash<auto> request, GrpcServerStream stream, hash<string, string> metadata) {
        stream.sendInitialMetadata({"x-server-version": "1.0"});
        # ...
    });

# Server sets trailing metadata (streaming only)
server.registerHandler("Service", "ServerStream",
    sub(hash<auto> request, GrpcServerStream stream, hash<string, string> metadata) {
        stream.setTrailingMetadata({"x-request-count": "42"});
        stream.write({"message": "data"});
    });

# Client receives metadata
hash<GrpcCallResult> result = client.call("Method", request);
hash<string, string> trailing = result.trailing_metadata;
    @endcode

    @section grpctimeouts Timeouts and Deadlines

    The client can set a timeout for gRPC calls. The server enforces the deadline — if the
    handler exceeds it, the server returns @ref Qore::Grpc::GRPC_STATUS_DEADLINE_EXCEEDED.

    @code{.py}
hash<GrpcCallOptions> opts = <GrpcCallOptions>{
    "timeout_ms": 5000,  # 5 second deadline
};
hash<GrpcCallResult> result = client.call("Method", request, opts);
if (result.status_code == GRPC_STATUS_DEADLINE_EXCEEDED) {
    printf("Call timed out\n");
}
    @endcode

    @section grpcerrors Error Handling

    gRPC uses status codes for error communication via HTTP/2 trailers. The standard status
    codes are defined as constants:

    |!Constant|!Value|!Description
    |@ref Qore::Grpc::GRPC_STATUS_OK|0|Success
    |@ref Qore::Grpc::GRPC_STATUS_CANCELLED|1|Operation cancelled
    |@ref Qore::Grpc::GRPC_STATUS_UNKNOWN|2|Unknown error
    |@ref Qore::Grpc::GRPC_STATUS_INVALID_ARGUMENT|3|Invalid argument
    |@ref Qore::Grpc::GRPC_STATUS_DEADLINE_EXCEEDED|4|Deadline expired
    |@ref Qore::Grpc::GRPC_STATUS_NOT_FOUND|5|Entity not found
    |@ref Qore::Grpc::GRPC_STATUS_ALREADY_EXISTS|6|Entity already exists
    |@ref Qore::Grpc::GRPC_STATUS_PERMISSION_DENIED|7|Permission denied
    |@ref Qore::Grpc::GRPC_STATUS_RESOURCE_EXHAUSTED|8|Resource exhausted
    |@ref Qore::Grpc::GRPC_STATUS_FAILED_PRECONDITION|9|Invalid state
    |@ref Qore::Grpc::GRPC_STATUS_ABORTED|10|Operation aborted
    |@ref Qore::Grpc::GRPC_STATUS_OUT_OF_RANGE|11|Out of range
    |@ref Qore::Grpc::GRPC_STATUS_UNIMPLEMENTED|12|Not implemented
    |@ref Qore::Grpc::GRPC_STATUS_INTERNAL|13|Internal error
    |@ref Qore::Grpc::GRPC_STATUS_UNAVAILABLE|14|Service unavailable
    |@ref Qore::Grpc::GRPC_STATUS_DATA_LOSS|15|Data loss
    |@ref Qore::Grpc::GRPC_STATUS_UNAUTHENTICATED|16|Unauthenticated

    Server handler exceptions are automatically caught and returned as
    @ref Qore::Grpc::GRPC_STATUS_INTERNAL with the exception message.

    @section grpcreflection Server Reflection

    The @ref Qore::Grpc::GrpcReflectionService class implements the standard gRPC server
    reflection protocol (\c grpc.reflection.v1), enabling clients to discover services
    exposed by a @ref Qore::Grpc::GrpcServer without needing local \c .proto files. This
    is the same protocol used by tools such as \c grpcurl and \c grpc_cli.

    @subsection grpcreflectionserver Enabling Server Reflection

    The simplest way to enable reflection is to pass \c enable_reflection in the server
    options. The server automatically sets up the reflection service:

    @code{.py}
%modern
%requires grpc
%requires GrpcUtil

ProtobufSchema schema("./proto/", "service.proto");
GrpcServer server(schema, <GrpcServerOptions>{"enable_reflection": True});

server.registerHandler("MyService", "MyMethod",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        return {"result": "ok"};
    });

int port = server.addInsecurePort("localhost:0");
server.start();
    @endcode

    For more control, you can use @ref Grpc::GrpcReflectionService "GrpcReflectionService"
    directly:

    @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
GrpcReflectionService reflection(schema);

GrpcServer server(reflection.getCombinedSchema());
server.registerHandler("MyService", "MyMethod",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        return {"result": "ok"};
    });
reflection.registerHandlers(server);

server.addInsecurePort("localhost:0");
server.start();
    @endcode

    @subsection grpcreflectionclient Client Discovery via Reflection

    The @ref GrpcDataProvider::GrpcReflectionClient class can discover services
    programmatically:

    @code{.py}
GrpcChannel channel("http://localhost:50051");
GrpcReflectionClient rc(channel);

# List all services
list<string> services = rc.listServices();

# Discover full schema for making calls
ProtobufSchema discovered = rc.discoverSchema();
GrpcClient client(channel, discovered, "MyService");
hash<GrpcCallResult> result = client.call("MyMethod", {"key": "value"});

channel.shutdown();
    @endcode

    Servers with reflection enabled also work with standard gRPC tools:
    @verbatim
# List services with grpcurl
grpcurl -plaintext localhost:50051 list

# Describe a service
grpcurl -plaintext localhost:50051 describe mypackage.MyService
    @endverbatim

    The reflection service supports the following request types:
    - \c list_services: enumerate all available services
    - \c file_containing_symbol: get the file descriptor for a service, message, or enum type
    - \c file_by_filename: get the file descriptor by \c .proto filename

    @note The @ref grpcdpreflection "GrpcDataProvider module" can also use reflection
    for zero-configuration service access via the \c use_reflection option.

    @section grpcprotobuf Standalone Protobuf

    The @ref Qore::Grpc::ProtobufSchema class can be used independently for protobuf
    encoding/decoding without gRPC:

    @code{.py}
%requires grpc

# Load from file
ProtobufSchema schema("./proto/", "messages.proto");

# Or from string
string proto_content = "syntax = \"proto3\";\n"
    + "message Event { string type = 1; int64 timestamp = 2; }";
ProtobufSchema schema(proto_content);

# Encode
binary data = schema.encode("Event", {"type": "click", "timestamp": 1234567890});

# Decode
hash<auto> event = schema.decode("Event", data);

# JSON conversion
string json = schema.toJson("Event", {"type": "click", "timestamp": 1234567890});
hash<auto> parsed = schema.fromJson("Event", json);

# Service and type introspection
list<hash<GrpcServiceInfo>> services = schema.services();
list<string> types = schema.messageTypes();
hash<auto> defaults = schema.defaultMessage("Event");
    @endcode

    @section grpctypemapping Protobuf Type Mapping

    |!Protobuf Type|!Qore Type|!Notes
    |double, float|\c float|
    |int32, sint32, sfixed32|\c int|
    |int64, sint64, sfixed64|\c int|
    |uint32, fixed32|\c int|
    |uint64, fixed64|\c int|Large values may overflow signed int64
    |bool|\c bool|
    |string|\c string|
    |bytes|\c binary|
    |enum|\c int|Numeric value
    |message|\c hash<auto>|Recursive
    |repeated T|\c list<auto>|
    |map<K,V>|\c hash<auto>|

    @section grpcdataprovider GrpcDataProvider Module

    The \c GrpcDataProvider module provides a data provider API for gRPC services, enabling
    low-code integration in Qorus. Use \c "%requires GrpcDataProvider" to load the module.

    @subsection grpcdparch Data Provider Architecture

    The provider hierarchy maps protobuf service definitions to the data provider API:
    - <b>GrpcDataProvider</b> (root): schema + connection; children are gRPC services
      - <b>GrpcServiceDataProvider</b>: container for methods in a service
        - <b>GrpcMethodDataProvider</b>: leaf provider supporting \c doRequest() for all
          4 RPC patterns

    @subsection grpcdpcreate Creating a Data Provider

    @code{.py}
%requires GrpcDataProvider

# From a proto file
GrpcDataProvider provider({
    "url": "http://localhost:50051",
    "proto_path": "./proto",
    "proto_file": "service.proto",
});

# From inline proto content
GrpcDataProvider provider({
    "url": "http://localhost:50051",
    "proto_content": proto_string,
});

# Via connection
GrpcConnection conn("my-grpc", "My gRPC service", "grpc://localhost:50051",
    {}, {"proto_content": proto_string});
AbstractDataProvider provider = conn.getDataProvider();
    @endcode

    @subsection grpcdpcall Making Calls

    @code{.py}
# Navigate to a method and make a unary call
auto result = provider
    .getChildProvider("MyService")
    .getChildProvider("SayHello")
    .doRequest({"name": "World"});
printf("Response: %y\n", result);

# Client streaming: send multiple messages
auto result = provider
    .getChildProvider("MyService")
    .getChildProvider("UploadData")
    .doRequest({"messages": ({"chunk": "data1"}, {"chunk": "data2"})});

# Server streaming: returns list of responses
list<auto> results = provider
    .getChildProvider("MyService")
    .getChildProvider("ListItems")
    .doRequest({"category": "books"});
    @endcode

    @subsection grpcdpstreaming Streaming Pattern Mapping

    |!gRPC Pattern|!Request Format|!Response Format
    |Unary|Message hash|Response hash
    |Server streaming|Message hash|List of response hashes
    |Client streaming|\c {"messages": list}|Response hash
    |Bidirectional|\c {"messages": list}|List of response hashes

    @subsection grpcdpconnection Connection Provider

    The module registers \c grpc:// and \c grpcs:// connection schemes:

    |!Scheme|!Transport|!Example URL
    |\c grpc://|Plaintext HTTP/2|\c grpc://localhost:50051
    |\c grpcs://|TLS HTTPS|\c grpcs://api.example.com:443

    Connection options:
    - \c proto_path: path to directory containing \c .proto files
    - \c proto_file: name of the \c .proto file to load
    - \c proto_content: inline protobuf schema definition
    - \c use_reflection: use gRPC server reflection for schema discovery
    - \c timeout_ms: default call timeout in milliseconds (default: 30000)

    @subsection grpcdptypes Protobuf to DataProvider Type Mapping

    |!Protobuf Type|!DataProvider Type
    |double, float|\c SoftFloatType
    |int32, sint32, sfixed32, int64, sint64, sfixed64, uint32, fixed32, uint64, fixed64|\c SoftIntType
    |bool|\c SoftBoolType
    |string|\c StringType
    |bytes|\c DataType (binary)
    |enum|\c SoftIntType
    |message|\c HashDataType (recursive)
    |repeated T|\c SoftListDataType wrapping element type
    |map<K,V>|\c HashDataType with \c setDefaultOtherFieldType()

    @subsection grpcdpreflection Server Reflection

    The module includes a gRPC server reflection client that can dynamically discover services
    and schemas from a running server. The server must have
    @ref grpcreflection "GrpcReflectionService" enabled for this to work.

    @code{.py}
# Auto-discover services via reflection (no .proto files needed)
GrpcDataProvider provider({
    "url": "http://localhost:50051",
    "use_reflection": True,
});

# Services are discovered automatically
auto result = provider.getChildProvider("MyService")
    .getChildProvider("MyMethod")
    .doRequest({"name": "World"});
    @endcode

    From the command line:
    @verbatim qdp 'grpc{url=http://localhost:50051,use_reflection=true}/MyService/MyMethod' dor name=World
    @endverbatim

    @section grpcarrow Arrow IPC Support

    When built with Apache Arrow (\c -DArrow_DIR=...), the module provides classes for
    creating, inspecting, and serializing Apache Arrow columnar data.  These are the
    building blocks for Arrow Flight integration — the high-performance columnar data
    transport protocol used in analytics, data lakehouse, and ETL pipelines.

    @subsection grpcarrowclasses Arrow Classes

    |!Class|!Description
    |@ref Qore::Grpc::ArrowSchema|Defines column names, types, nullability, and metadata
    |@ref Qore::Grpc::ArrowRecordBatch|Holds columnar data (rows × columns) in Arrow format
    |@ref Qore::Grpc::ArrowIpc|Static utility methods for IPC serialization / deserialization

    @subsection grpcarrowtypes Supported Arrow Type Strings

    These strings are used in the @ref Qore::Grpc::ArrowFieldInfo \c "type" field when
    defining schemas.

    <b>Integer types</b>:
    |!Type String|!Description|!Qore Type
    |\c "int8"|Signed 8-bit integer|\c int
    |\c "int16"|Signed 16-bit integer|\c int
    |\c "int32"|Signed 32-bit integer|\c int
    |\c "int64"|Signed 64-bit integer|\c int
    |\c "uint8"|Unsigned 8-bit integer|\c int
    |\c "uint16"|Unsigned 16-bit integer|\c int
    |\c "uint32"|Unsigned 32-bit integer|\c int
    |\c "uint64"|Unsigned 64-bit integer|\c int or \c number (values > 2^63)

    <b>Floating-point types</b>:
    |!Type String|!Description|!Qore Type
    |\c "float16" / \c "half_float"|IEEE 754 half-precision|\c float
    |\c "float32" / \c "float"|IEEE 754 single-precision|\c float
    |\c "float64" / \c "double"|IEEE 754 double-precision|\c float

    <b>Decimal types</b>:
    |!Type String|!Description|!Qore Type
    |\c "decimal128(P, S)"|128-bit decimal with precision P, scale S|\c number
    |\c "decimal256(P, S)"|256-bit decimal with precision P, scale S|\c number

    <b>String and binary types</b>:
    |!Type String|!Description|!Qore Type
    |\c "utf8"|UTF-8 string (up to 2 GB)|\c string
    |\c "large_utf8"|UTF-8 string (up to 2^63 bytes)|\c string
    |\c "binary"|Binary data (up to 2 GB)|\c binary
    |\c "large_binary"|Binary data (up to 2^63 bytes)|\c binary
    |\c "fixed_size_binary[N]"|Fixed-length binary of N bytes|\c binary

    <b>Boolean</b>:
    |!Type String|!Description|!Qore Type
    |\c "bool"|Boolean true/false|\c bool

    <b>Date and time types</b>:
    |!Type String|!Description|!Qore Type
    |\c "date32"|Days since epoch|\c date
    |\c "date64"|Milliseconds since epoch|\c date
    |\c "timestamp[s]", \c "timestamp[ms]", \c "timestamp[us]", \c "timestamp[ns]"|Timestamp with unit|\c date
    |\c "timestamp[us, tz=UTC]"|Timestamp with timezone|\c date
    |\c "time32[s]", \c "time32[ms]"|Time of day (second/millisecond)|\c date
    |\c "time64[us]", \c "time64[ns]"|Time of day (microsecond/nanosecond)|\c date
    |\c "duration[s]", \c "duration[ms]", \c "duration[us]", \c "duration[ns]"|Duration with unit|\c date

    <b>Nested types</b>:
    |!Type String|!Children|!Qore Type
    |\c "struct"|One child per struct field|\c hash
    |\c "list"|One child named \c "item"|\c list
    |\c "large_list"|One child named \c "item"|\c list
    |\c "map"|Two children: \c "key" and \c "value"|\c hash

    @subsection grpcarrowworkflow Arrow Flight Workflow

    A typical Arrow Flight data exchange follows this pattern:

    @par Sender: Schema + RecordBatch → IPC bytes
    @code{.py}
%requires grpc

# 1. Define the schema
ArrowSchema schema((
    {"name": "trade_id",  "type": "int64",             "nullable": False},
    {"name": "symbol",    "type": "utf8",              "nullable": False},
    {"name": "price",     "type": "decimal128(18, 4)", "nullable": False},
    {"name": "quantity",  "type": "int32",             "nullable": False},
    {"name": "exec_time", "type": "timestamp[us, tz=UTC]", "nullable": False},
));

# 2. Build a record batch from data
ArrowRecordBatch batch(schema, {
    "trade_id":  (10001, 10002, 10003),
    "symbol":    ("AAPL", "GOOG", "MSFT"),
    "price":     (182.5025n, 141.2500n, 378.9075n),
    "quantity":  (100, 50, 200),
    "exec_time": (2026-03-04T14:30:00.123456Z, 2026-03-04T14:30:01.234567Z,
                  2026-03-04T14:30:02.345678Z),
});

# 3. Serialize for transport
binary schema_ipc = schema.toIpc();
hash<ArrowIpcData> batch_ipc = batch.toIpc();
# Send schema_ipc, batch_ipc.data_header, batch_ipc.data_body via Flight
    @endcode

    @par Receiver: IPC bytes → Schema + RecordBatch → Qore data
    @code{.py}
# 1. Deserialize the schema
ArrowSchema schema(schema_ipc);

# 2. Deserialize the record batch
ArrowRecordBatch batch(schema, data_header, data_body);

# 3. Access data — columnar for analytics
hash<auto> cols = batch.toColumns();
number total_value = 0n;
for (int i = 0; i < batch.numRows(); ++i) {
    total_value += cols.price[i] * cols.quantity[i];
}
printf("Total notional: %n\n", total_value);

# 3b. Or row-oriented for per-record processing
list<hash<auto>> trades = batch.toRows();
for (hash<auto> trade in trades) {
    printf("Trade %d: %s %d @ %n at %y\n",
        trade.trade_id, trade.symbol, trade.quantity, trade.price, trade.exec_time);
}
    @endcode

    @subsection grpcarrowerrors Arrow Error Handling

    Arrow operations raise Qore exceptions with the following error codes:

    |!Exception|!Cause
    |\c ARROW-IPC-ERROR|IPC deserialization failed (corrupt or invalid binary data)
    |\c ARROW-SCHEMA-ERROR|Schema definition invalid, or column data does not match the schema
    |\c ARROW-BUILD-ERROR|Data cannot be converted to the declared Arrow type
    |\c ARROW-TYPE-ERROR|Unknown or unsupported Arrow type string
    |\c ARROW-COLUMN-ERROR|Column name not found or index out of range

    @section grpcflight Arrow Flight Protocol

    The Arrow Flight protocol is a high-performance data transport built on gRPC for
    exchanging columnar Arrow data.  When built with Apache Arrow, the \c GrpcUtil module
    provides Arrow Flight client and server classes, and the
    @ref ArrowFlightDataProvider::ArrowFlightDataProvider "ArrowFlightDataProvider" module
    integrates Flight services into the data provider framework.

    @subsection grpcflightarch Flight Architecture

    @verbatim
GrpcUtil Module                         ArrowFlightDataProvider Module
┌───────────────────────────────┐       ┌─────────────────────────────────────┐
│ ArrowFlightClient             │       │ ArrowFlightDataProvider (root)      │
│   listFlights(), doGet(),     │       │   └─ ArrowFlightDatasetDataProvider │
│   doPut(), doExchange()       │       │        ├─ get  (doGet)             │
│                               │       │        ├─ put  (doPut)             │
│ ArrowFlightServer             │       │        └─ exchange (doExchange)    │
│   registerDataset(),          │       │              └─ events (observable) │
│   registerAction()            │       │                                     │
│                               │       │ ArrowFlightConnection               │
│ ArrowFlightStreamReader       │       │   flight://, flights://             │
│ ArrowFlightStreamWriter       │       │                                     │
│ ArrowFlightExchangeStream     │       │ ArrowFlightDataProviderFactory      │
│ ArrowFlightDatasetHandler     │       │   name: "flight"                    │
│ ArrowFlightHelper             │       └─────────────────────────────────────┘
└───────────────────────────────┘
    @endverbatim

    @subsection grpcflightserver Flight Server

    @code{.py}
%modern
%requires grpc
%requires GrpcUtil

class SalesHandler inherits ArrowFlightDatasetHandler {
    ArrowSchema getSchema() {
        return new ArrowSchema((
            {"name": "id", "type": "int64"},
            {"name": "product", "type": "utf8"},
            {"name": "price", "type": "float64"},
        ));
    }

    hash<auto> getFlightInfo(hash<auto> descriptor) {
        return {
            "schema": ArrowIpc::writeSchema(getSchema()),
            "flight_descriptor": descriptor,
            "total_records": 3,
            "total_bytes": -1,
        };
    }

    nothing doGet(hash<auto> ticket, GrpcServerStream stream) {
        ArrowSchema sch = getSchema();
        stream.write(ArrowFlightHelper::schemaToFlightData(sch));

        ArrowRecordBatch batch(sch, (
            {"id": 1, "product": "Widget", "price": 9.99},
            {"id": 2, "product": "Gadget", "price": 24.99},
        ));
        stream.write(ArrowFlightHelper::batchToFlightData(batch));
    }
}

ArrowFlightServer server();
server.registerDataset("sales", new SalesHandler());

int port = server.addInsecurePort("localhost:0");
server.start();
printf("Flight server on port %d\n", port);
server.wait();
    @endcode

    @subsection grpcflightclient Flight Client

    @code{.py}
%modern
%requires grpc
%requires GrpcUtil

GrpcChannel channel("http://localhost:8815");
ArrowFlightClient client(channel);

# List available datasets
list<hash<auto>> flights = client.listFlights();
printf("Datasets: %y\n", flights);

# Read data via DoGet
hash<auto> ticket = {"ticket": binary("sales")};
ArrowFlightStreamReader reader = client.doGet(ticket);
ArrowSchema schema = reader.schema();
while (*ArrowRecordBatch batch = reader.read(5s)) {
    list<hash<auto>> rows = batch.toRows();
    printf("Received %d rows\n", rows.size());
}
reader.finish();

# Write data via DoPut
ArrowSchema write_schema((
    {"name": "key", "type": "utf8"},
    {"name": "value", "type": "int64"},
));
hash<auto> descriptor = ArrowFlightHelper::pathDescriptor("my-dataset");
ArrowFlightStreamWriter writer = client.doPut(descriptor, write_schema);
ArrowRecordBatch batch(write_schema, (
    {"key": "alpha", "value": 100},
    {"key": "beta", "value": 200},
));
writer.write(batch);
writer.finish();

channel.shutdown();
    @endcode

    @subsection grpcflightdataprovider Flight Data Provider

    The @ref ArrowFlightDataProvider::ArrowFlightDataProvider "ArrowFlightDataProvider"
    module integrates Arrow Flight into Qore's data provider framework.

    @par Navigate datasets and read data
    @code{.py}
%modern
%requires ArrowFlightDataProvider

ArrowFlightDataProvider provider({"url": "http://localhost:8815"});

# List datasets
map printf("Dataset: %s\n", $1), provider.getChildProviderNames();

# Read data via doRequest
auto rows = provider.getChildProvider("sales")
    .getChildProvider("get")
    .doRequest(NOTHING);
printf("Got %d rows\n", rows.size());
    @endcode

    @par Write data
    @code{.py}
list<hash<auto>> rows = (
    {"key": "alpha", "value": 100},
    {"key": "beta", "value": 200},
);
provider.getChildProvider("writable")
    .getChildProvider("put")
    .doRequest({"rows": rows});
    @endcode

    @par Observable streaming events
    @code{.py}
ArrowFlightStreamEventDataProvider events =
    cast<ArrowFlightStreamEventDataProvider>(
        provider.getChildProvider("sales")
            .getChildProvider("get")
            .getChildProvider("events"));
events.registerObserver(my_observer);
events.observersReady();
    @endcode

    @par Using named connections
    @verbatim qdp 'flight{url=http://localhost:8815}/sales/get' dor
    @endverbatim

    @par Connection schemes
    |!Scheme|!Transport|!Example URL
    |\c flight://|Plaintext HTTP/2|\c flight://localhost:8815
    |\c flights://|TLS HTTPS|\c flights://flight.example.com:443

    @section grpcrelnotes Release Notes

    @subsection grpc_v1_0 grpc Module Version 1.0

    <b>Dependencies</b>: \c libprotobuf (no \c libgrpc++ required)
    - Ubuntu/Debian: \c libprotobuf-dev
    - Fedora/RHEL: \c protobuf-devel
    - Alpine: \c protobuf-dev

    <b>Features</b>:
    - initial release
    - dynamic protobuf schema loading (file and string) and serialized descriptor loading
    - protobuf encoding/decoding for all field types
    - protobuf message schema introspection (\c messageSchema(), \c enumValues())
    - file descriptor lookup by symbol and filename (\c serializeFileDescriptorForSymbol(),
      \c serializeFileDescriptorByName())
    - JSON conversion via protobuf
    - gRPC client with unary, server streaming, client streaming, bidirectional streaming
    - gRPC server with handler registration and async I/O
    - TLS/SSL support on client and server
    - custom metadata (request, initial response, trailing)
    - timeout/deadline enforcement
    - connection pooling via HttpClientConnectionManager
    - gRPC status codes and error handling
    - \c GrpcDataProvider module for data provider API integration
    - \c GrpcConnection with \c grpc:// and \c grpcs:// connection schemes
    - \c GrpcDataProviderFactory for factory-based creation
    - \c GrpcTypeHelper for protobuf-to-DataProvider type mapping
    - \c GrpcReflectionClient for gRPC server reflection protocol (client)
    - @ref Grpc::GrpcReflectionService "GrpcReflectionService" for built-in gRPC server
      reflection (\c grpc.reflection.v1) — enables clients to discover services without
      local \c .proto files; also available via the \c enable_reflection
      @ref Qore::Grpc::GrpcServerOptions "GrpcServerOptions" flag
    - <b>Arrow IPC support</b> (optional, requires Apache Arrow):
      - @ref Qore::Grpc::ArrowSchema for schema definition, introspection, and IPC serialization
      - @ref Qore::Grpc::ArrowRecordBatch for columnar data with row/column construction and conversion
      - @ref Qore::Grpc::ArrowIpc static utility class for IPC serialization / deserialization
      - support for all Arrow primitive types, nested types (struct, list, large_list, map),
        decimal128/256, timestamps with timezones, durations, half-float, and field/schema metadata
      - when built with qore Arrow C Data interop, supported \c ColumnarResult
        conversions use libqore's zero-copy Arrow C Data bridge before falling
        back to Arrow builders for types not yet covered by the bridge
      - IPC data_header + data_body split compatible with Arrow Flight wire format
    - <b>Arrow Flight protocol</b> (optional, requires Apache Arrow):
      - @ref Grpc::ArrowFlightClient "ArrowFlightClient" for Flight RPCs (ListFlights,
        GetFlightInfo, DoGet, DoPut, DoExchange, DoAction)
      - @ref Grpc::ArrowFlightServer "ArrowFlightServer" with dataset and action registration
      - @ref Grpc::ArrowFlightStreamReader "ArrowFlightStreamReader",
        @ref Grpc::ArrowFlightStreamWriter "ArrowFlightStreamWriter", and
        @ref Grpc::ArrowFlightExchangeStream "ArrowFlightExchangeStream" for typed streaming
      - @ref Grpc::ArrowFlightDatasetHandler "ArrowFlightDatasetHandler" abstract base for
        user-implemented Flight datasets
      - @ref Grpc::ArrowFlightHelper "ArrowFlightHelper" for FlightData ↔ Arrow object conversion
      - @ref Grpc::FlightProto "FlightProto" embedded Flight protocol schema
    - <b>ArrowFlightDataProvider module</b> (optional, requires Apache Arrow):
      - @ref ArrowFlightDataProvider::ArrowFlightDataProvider "ArrowFlightDataProvider" root
        provider with dataset discovery via ListFlights
      - @ref ArrowFlightDataProvider::ArrowFlightDatasetDataProvider "ArrowFlightDatasetDataProvider"
        per-dataset container provider
      - @ref ArrowFlightDataProvider::ArrowFlightMethodDataProvider "ArrowFlightMethodDataProvider"
        method-level provider supporting DoGet, DoPut, and DoExchange
      - @ref ArrowFlightDataProvider::ArrowFlightStreamEventDataProvider "ArrowFlightStreamEventDataProvider"
        observable event provider for streaming methods
      - @ref ArrowFlightDataProvider::ArrowFlightConnection "ArrowFlightConnection" with
        \c flight:// and \c flights:// connection schemes
      - @ref ArrowFlightDataProvider::ArrowFlightTypeHelper "ArrowFlightTypeHelper" for
        Arrow-to-DataProvider type mapping

