#include "grpc-module.h"

/** @defgroup grpc_status_codes gRPC Status Codes
    These constants define the standard gRPC status codes.

    @see https://grpc.github.io/grpc/core/md_doc_statuscodes.html
*/
///@{
//! The operation completed successfully
const GRPC_STATUS_OK = 0;

//! The operation was cancelled (typically by the caller)
const GRPC_STATUS_CANCELLED = 1;

//! Unknown error
const GRPC_STATUS_UNKNOWN = 2;

//! The client specified an invalid argument
const GRPC_STATUS_INVALID_ARGUMENT = 3;

//! The deadline expired before the operation could complete
const GRPC_STATUS_DEADLINE_EXCEEDED = 4;

//! The requested entity was not found
const GRPC_STATUS_NOT_FOUND = 5;

//! The entity already exists
const GRPC_STATUS_ALREADY_EXISTS = 6;

//! The caller does not have permission to execute the operation
const GRPC_STATUS_PERMISSION_DENIED = 7;

//! Some resource has been exhausted
const GRPC_STATUS_RESOURCE_EXHAUSTED = 8;

//! The system is not in a state required for the operation
const GRPC_STATUS_FAILED_PRECONDITION = 9;

//! The operation was aborted
const GRPC_STATUS_ABORTED = 10;

//! The operation was attempted past the valid range
const GRPC_STATUS_OUT_OF_RANGE = 11;

//! The operation is not implemented or not supported
const GRPC_STATUS_UNIMPLEMENTED = 12;

//! Internal error
const GRPC_STATUS_INTERNAL = 13;

//! The service is currently unavailable
const GRPC_STATUS_UNAVAILABLE = 14;

//! Unrecoverable data loss or corruption
const GRPC_STATUS_DATA_LOSS = 15;

//! The request does not have valid authentication credentials
const GRPC_STATUS_UNAUTHENTICATED = 16;
///@}

//! Information about a gRPC method in a service
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcMethodInfo {
    //! The method name (e.g., "SayHello")
    string name;

    //! The full gRPC path (e.g., "/helloworld.Greeter/SayHello")
    string full_path;

    //! The fully-qualified input message type name
    string input_type;

    //! The fully-qualified output message type name
    string output_type;

    //! True if the client sends a stream of messages
    bool client_streaming;

    //! True if the server sends a stream of messages
    bool server_streaming;
}

//! Information about a gRPC service
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcServiceInfo {
    //! The service name (e.g., "Greeter")
    string name;

    //! The methods defined in this service
    list<hash<Qore::Grpc::GrpcMethodInfo>> methods;
}

//! Options for a gRPC call
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcCallOptions {
    //! Timeout in milliseconds
    *int timeout_ms;

    //! Metadata key-value pairs to send with the call
    *hash<string, string> metadata;

    //! Compression algorithm name (e.g., "gzip", "deflate")
    *string compression;
}

//! Result of a gRPC call
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcCallResult {
    //! The response body as a Qore hash
    hash<auto> body;

    //! The gRPC status code (one of @ref grpc_status_codes)
    int status_code;

    //! The gRPC status message
    string status_message;

    //! Trailing metadata from the server
    hash<string, string> trailing_metadata;

    //! Initial metadata from the server
    hash<string, string> initial_metadata;
}

//! SSL/TLS options for gRPC connections
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcSslOptions {
    //! PEM-encoded root CA certificates
    *string root_certs;

    //! PEM-encoded client certificate for mutual TLS
    *string client_cert;

    //! PEM-encoded client private key for mutual TLS
    *string client_key;

    //! PEM-encoded server certificate
    *string server_cert;

    //! PEM-encoded server private key
    *string server_key;

    //! If True, require client certificate for mutual TLS (server-side)
    *bool require_client_auth;

    //! Peer certificate verification mode for a client channel
    /** When set, this is applied to the channel's connection manager verbatim; use
        @ref Qore::SSL_VERIFY_PEER to require that the server's certificate validates against
        the system CA store, which is what a public endpoint needs.

        When not set, a client channel accepts all certificates including self-signed ones,
        which is convenient for a local test server but must not be used against a production
        service.

        @see @ref Qore::SSL_VERIFY_NONE, @ref Qore::SSL_VERIFY_PEER

        @since %grpc 1.0
    */
    *int verify_mode;
}

//! Options for a gRPC channel
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcChannelOptions {
    //! The maximum size in bytes of one response message received; missing or <= 0 means no limit
    /** The size is the length declared in the gRPC frame of the message, checked before the message is buffered.
        A unary call whose response message is larger returns \c RESOURCE_EXHAUSTED; a stream reading a larger
        message is cancelled and ends with \c RESOURCE_EXHAUSTED: @ref Grpc::GrpcClientStream::read()
        "GrpcClientStream::read()" raises \c GRPC-RESOURCE-EXHAUSTED and
        @ref Grpc::GrpcClientStream::finish() "GrpcClientStream::finish()" returns the status, and a
        @ref Grpc::GrpcAsyncClientStream "GrpcAsyncClientStream" delivers it as its result.

        @since %grpc 1.0
    */
    *int max_message_size;

    //! The maximum size in bytes of a unary response body received into memory; missing or <= 0 means no limit
    /** Sets the \c max_response_body_size of the channel's
        \c HttpClientConnectionManager: the body of a unary response,
        which is received completely before it is decoded, is limited as it is received.  A unary call whose response
        body is larger returns \c RESOURCE_EXHAUSTED.  The body of a streaming response is received one message at a
        time, so its total size is not limited; use \c max_message_size to limit the size of each message.

        @since %grpc 1.0
    */
    *int max_response_body_size;

    //! SSL/TLS options
    *hash<Qore::Grpc::GrpcSslOptions> ssl;

    //! Default compression algorithm
    *string default_compression;

    //! If True, enable keepalive pings
    *bool keepalive;

    //! Keepalive interval in milliseconds
    *int keepalive_time_ms;
}

//! Options for a gRPC server
/** @since %grpc 1.0
*/
hashdecl Qore::Grpc::GrpcServerOptions {
    //! The maximum size in bytes of one request message received; missing or <= 0 means no limit
    /** The size is the length declared in the gRPC frame of the message, checked before the message is buffered;
        a larger message fails the call with \c RESOURCE_EXHAUSTED.  For client-streaming and bidirectional calls,
        the error is raised by @ref Grpc::GrpcServerStream::read() "GrpcServerStream::read()" as a
        \c GRPC-RESOURCE-EXHAUSTED exception, which a handler that does not catch it returns to the client as
        \c RESOURCE_EXHAUSTED.

        @since %grpc 1.0
    */
    *int max_message_size;

    //! The maximum size in bytes of a request body held in memory; missing or <= 0 means no limit
    /** Limits the memory the server uses for the request data of one call:
        - the HTTP/2 listener limits the request data it buffers for a stream that has not yet been read (the
          \c max_request_body_size of the listener); data over the limit is discarded and the body read fails
          with \c HTTP-BODY-TOO-LARGE
        - the complete request body of a unary or server-streaming call, which the server reads into memory before
          calling the handler, is limited as it is read

        A call whose request body exceeds the limit fails with \c RESOURCE_EXHAUSTED.  The request body of a
        client-streaming or bidirectional call is read one message at a time, so its total size is not limited;
        use \c max_message_size to limit the size of each message.

        @since %grpc 1.0
    */
    *int max_request_body_size;

    //! Enable gRPC server reflection (grpc.reflection.v1) for client service discovery
    /** When True, the server automatically registers the standard gRPC server reflection
        service, allowing clients to discover services without local \c .proto files.

        @par Example:
        @code{.py}
ProtobufSchema schema("./proto/", "service.proto");
GrpcServer server(schema, <GrpcServerOptions>{"enable_reflection": True});
server.registerHandler("MyService", "SayHello",
    hash<auto> sub(hash<auto> request, hash<string, string> metadata) {
        return {"message": "Hello, " + request.name};
    });
server.addInsecurePort("localhost:50051");
server.start();
        @endcode

        @since %grpc 1.0
    */
    *bool enable_reflection;
}
