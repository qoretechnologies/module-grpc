%modern
%allow-weak-references

%requires(reexport) SalesforceRestDataProvider
%requires(reexport) DataProvider
%requires AvroUtil
%requires AsyncSocketIo
%requires protobuf
%requires grpc
%requires GrpcUtil

module SalesforcePubSubDataProvider {
    version = "1.0";
    desc = "User module providing a Salesforce Pub/Sub API event data provider";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-grpc";
    license = "MIT";
    init = sub () {
        # attach the events container to the Salesforce data provider; dynamic children are only
        # exposed when the parent provider was built from a connection, which is also the only
        # case in which the async REST client needed for the Pub/Sub call metadata is available
        SalesforceRestDataProvider::SalesforceRestDataProvider::registerChild(PubSubChildName,
            AbstractDataProvider sub (string name,
                    ConnectionProvider::AbstractConnection conn) {
                return new SalesforcePubSubEventsDataProvider(
                    cast<SalesforceRestClient::SalesforceRestConnection>(conn));
            });

        # Change Data Capture enablement is a sibling of the events container rather than a child
        # of it: the events container's children are the org's channels, and a fixed non-channel
        # child would be lost among them
        SalesforceRestDataProvider::SalesforceRestDataProvider::registerChild(
            SalesforcePubSubEnableCdcDataProvider::ProviderName,
            AbstractDataProvider sub (string name,
                    ConnectionProvider::AbstractConnection conn) {
                return new SalesforcePubSubEnableCdcDataProvider(
                    cast<SalesforceRestClient::SalesforceRestConnection>(conn));
            });

        # Enabling Change Data Capture is offered as an explicit action rather than done
        # implicitly by a subscription: it mutates org configuration and starts a 72-hour
        # retention stream, neither of which should happen as a side effect of listening
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SalesforceRestDataProvider::AppName,
            "path": "/" + SalesforcePubSubEnableCdcDataProvider::ProviderName,
            "action": "enable-change-data-capture",
            # grouped with the event actions: this exists to make those deliver, so it belongs
            # where someone configuring Salesforce events will look for it
            "groups": "Events",
            "display_name": "Enable Change Data Capture",
            "short_desc": "Enable Change Data Capture for a Salesforce object",
            "desc": "Enables **Change Data Capture** for a Salesforce object, so that its "
                "creates, updates, deletes and undeletes can be subscribed to through the "
                "**Pub/Sub API**.\n\n"
                "Change Data Capture must be switched on per object before a subscription "
                "delivers anything, and a subscription to an object that was never enabled "
                "succeeds and then stays silent -- so this is usually run **once**, when an "
                "integration is set up, rather than as part of a flow.\n\n"
                "Enabling an object that is already enabled is not an error.\n\n"
                "**This changes org configuration.** It starts a 72-hour retention stream for "
                "the object, and the number of objects an org may select depends on its edition "
                "and add-ons. The connection's user needs permission to modify metadata.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SalesforceEnableCdcRequestDataType::Fields),
            "output_type": SalesforceEnableCdcResponseType,
            "data_provider_info": SalesforcePubSubEnableCdcDataProvider::ProviderInfo,
        });

        # Actions are registered against the *Salesforce* app rather than a new one: Pub/Sub
        # events are Salesforce events, and a separate app would split one integration across two
        # entries in the UI.  This is the extender convention already used by the Qorus service
        # modules that extend open base modules.
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SalesforceRestDataProvider::AppName,
            "path": "/" + PubSubChildName + "/{channel}",
            "path_vars": {
                "channel": <DataProviderPathVarInfo>{
                    "display_name": "Channel",
                    "short_desc": "The Salesforce event channel",
                    "desc": "The Salesforce event channel to subscribe to: a Change Data Capture "
                        "entity such as `AccountChangeEvent` or a platform event such as "
                        "`Order_Shipped__e`",
                    "example_value": "AccountChangeEvent",
                },
            },
            "action": "pubsub-event",
            "groups": "Events",
            "display_name": "Salesforce Event",
            "short_desc": "React to a Salesforce platform or change data capture event",
            "desc": "Reacts to events published on a Salesforce **Pub/Sub API** channel: platform "
                "events, Change Data Capture events and custom channels all arrive through the "
                "same subscription.\n\n"
                "The subscription tracks its replay position, so a connection lost and "
                "re-established resumes after the last event delivered rather than skipping "
                "ahead. Salesforce retains replay IDs for **72 hours**.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SALESFORCE_PUBSUB_EVENT,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SalesforcePubSubEventDataProvider::LocalOptions),
            # the envelope is static; the payload is channel-specific and is described by the
            # per-channel provider's getEventTypesImpl() from that channel's own Avro schema
            "output_type": SalesforcePubSubEventType,
            "data_provider_info": SalesforcePubSubEventDataProvider::ProviderInfo,
        });

        # Named Change Data Capture actions.  Each resolves to a change type preset child of the
        # channel provider, so the provider path carries the filter and the action does not have
        # to preset an option that a caller could omit.  This follows the DropboxDataProvider
        # convention, where every named event action has its own path.
        hash<string, hash<ActionOptionInfo>> preset_options =
            DataProviderActionCatalog::getActionOptionFromFields(
                SalesforcePubSubEventDataProvider::LocalOptions - "change_type");

        hash<DataProviderPathVarInfo> cdc_channel_var = <DataProviderPathVarInfo>{
            "display_name": "Object",
            "short_desc": "The Salesforce object to watch",
            "desc": "The Change Data Capture channel to subscribe to, named after the object it "
                "reports on: `AccountChangeEvent` for `Account`, `OpportunityChangeEvent` for "
                "`Opportunity`, and so on.\n\n"
                "Change Data Capture must be enabled for the object in **Setup -> Integrations "
                "-> Change Data Capture**",
            "example_value": "AccountChangeEvent",
        };

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SalesforceRestDataProvider::AppName,
            "path": "/" + PubSubChildName + "/{channel}/created",
            "path_vars": {"channel": cdc_channel_var},
            "action": "new-record",
            "groups": "Events",
            "display_name": "New Salesforce Record",
            "short_desc": "React when a record of the given object is created",
            "desc": "Reacts when a record of the given Salesforce object is **created**, using "
                "the **Pub/Sub API** Change Data Capture stream.\n\n"
                "Delivery is real time rather than polled, and the subscription tracks its replay "
                "position, so a connection lost and re-established resumes after the last event "
                "delivered rather than skipping the records created while it was down. Salesforce "
                "retains replay IDs for **72 hours**.\n\n"
                "A `GAP_CREATE` event, which reports a create that Salesforce could not deliver "
                "in full, is delivered by this action as well, so a create is never silently "
                "lost.\n\n"
                "Change Data Capture must be enabled for the object in **Setup -> Integrations "
                "-> Change Data Capture**",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SALESFORCE_PUBSUB_EVENT,
            "options": preset_options,
            "output_type": SalesforcePubSubEventType,
            "data_provider_info": SalesforcePubSubEventDataProvider::PresetProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SalesforceRestDataProvider::AppName,
            "path": "/" + PubSubChildName + "/{channel}/updated",
            "path_vars": {"channel": cdc_channel_var},
            "action": "updated-record",
            "groups": "Events",
            "display_name": "Updated Salesforce Record",
            "short_desc": "React when a record of the given object is updated",
            "desc": "Reacts when a record of the given Salesforce object is **updated**, using "
                "the **Pub/Sub API** Change Data Capture stream.\n\n"
                "The event payload carries the `ChangeEventHeader.changedFields` list, so the "
                "fields that actually changed are known without re-reading the record.\n\n"
                "Delivery is real time rather than polled, and the subscription resumes from its "
                "last replay position after a reconnect; Salesforce retains replay IDs for "
                "**72 hours**.\n\n"
                "A `GAP_UPDATE` event, which reports an update that Salesforce could not deliver "
                "in full, is delivered by this action as well.\n\n"
                "Change Data Capture must be enabled for the object in **Setup -> Integrations "
                "-> Change Data Capture**",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SALESFORCE_PUBSUB_EVENT,
            "options": preset_options,
            "output_type": SalesforcePubSubEventType,
            "data_provider_info": SalesforcePubSubEventDataProvider::PresetProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SalesforceRestDataProvider::AppName,
            "path": "/" + PubSubChildName + "/ContactChangeEvent/created",
            "action": "new-contact",
            "groups": "Events",
            "display_name": "New Salesforce Contact",
            "short_desc": "React when a contact is created",
            "desc": "Reacts when a Salesforce **contact** is created, using the **Pub/Sub API** "
                "Change Data Capture stream.\n\n"
                "This is the `new-record` action fixed to the `Contact` object. Delivery is real "
                "time rather than polled, and the subscription resumes from its last replay "
                "position after a reconnect.\n\n"
                "Change Data Capture must be enabled for `Contact` in **Setup -> Integrations "
                "-> Change Data Capture**",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SALESFORCE_PUBSUB_EVENT,
            "options": preset_options,
            "output_type": SalesforcePubSubEventType,
            "data_provider_info": SalesforcePubSubEventDataProvider::PresetProviderInfo,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SalesforceRestDataProvider::AppName,
            "path": "/" + PubSubChildName + "/LeadChangeEvent/created",
            "action": "new-lead",
            "groups": "Events",
            "display_name": "New Salesforce Lead",
            "short_desc": "React when a lead is created",
            "desc": "Reacts when a Salesforce **lead** is created, using the **Pub/Sub API** "
                "Change Data Capture stream.\n\n"
                "This is the `new-record` action fixed to the `Lead` object. Delivery is real "
                "time rather than polled, and the subscription resumes from its last replay "
                "position after a reconnect.\n\n"
                "Change Data Capture must be enabled for `Lead` in **Setup -> Integrations "
                "-> Change Data Capture**",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SALESFORCE_PUBSUB_EVENT,
            "options": preset_options,
            "output_type": SalesforcePubSubEventType,
            "data_provider_info": SalesforcePubSubEventDataProvider::PresetProviderInfo,
        });
    };
}

/** @mainpage SalesforcePubSubDataProvider Module

    @tableofcontents

    @section salesforcepubsubdataproviderintro SalesforcePubSubDataProvider Module Introduction

    The %SalesforcePubSubDataProvider module adds a
    <a href="https://developer.salesforce.com/docs/platform/pub-sub-api/overview">Salesforce
    Pub/Sub API</a> event source to the Salesforce data provider, so that platform events, Change
    Data Capture events and custom channels can drive Qore and Qorus logic through the
    DataProvider observer API.

    The Pub/Sub API is gRPC over HTTP/2 with <a href="https://avro.apache.org/">Apache Avro</a>
    binary event payloads.  This module supplies the Salesforce-specific layer only: the transport
    comes from the \c GrpcUtil module in this repository, the Avro codec from the builtin \c avro
    module, and authentication from \c SalesforceRestClient in the Qore library, so an existing
    \c sfrest connection gains event support with no new connection type.

    Key characteristics:
    - <b>No thread per subscription</b>: the \c Subscribe bidirectional stream is driven by
      \c GrpcAsyncClientStream on the async socket I/O controller.
      An idle subscription costs no thread, and every deadline is armed on the controller's
      timeout heap rather than approximated with timed reads
    - <b>Replay position is preserved</b>: the replay ID of every delivered event is recorded, so a
      stream that fails is re-established from that position instead of restarting
    - <b>Delivery-driven flow control</b>: \c FetchRequest credit is replenished from the response
      handler as events are consumed; the API's 60 second replenishment window is a backstop
      deadline, not the mechanism
    - <b>Keepalives are understood</b>: an empty \c FetchResponse is liveness plus a replay-ID
      update, never end-of-stream
    - <b>Typed events</b>: the event type is derived from the channel's Avro schema, so a Qog shows
      real field names

    @section salesforcepubsubdataprovider_hierarchy Provider Hierarchy

    The module attaches to the Salesforce data provider as the \c pubsub child:

    @verbatim
<SalesforceRestConnection>
  └── pubsub                     (SalesforcePubSubEventsDataProvider)
        ├── AccountChangeEvent   (SalesforcePubSubEventDataProvider)
        │     ├── created        (CREATE, with GAP_CREATE)
        │     ├── updated        (UPDATE, with GAP_UPDATE)
        │     ├── deleted        (DELETE, with GAP_DELETE)
        │     └── undeleted      (UNDELETE, with GAP_UNDELETE)
        ├── ContactChangeEvent   (SalesforcePubSubEventDataProvider)
        └── Order_Shipped__e     (SalesforcePubSubEventDataProvider)
    @endverbatim

    Children only appear under a \c SalesforceRestConnection, because
    \c SalesforceRestDataProvider exposes dynamic children only when it was built from a
    connection.

    @subsection salesforcepubsubdataprovider_change_types Change Types

    A Change Data Capture channel exposes one child per change type, so that an action can express
    "a record was created" through the provider path rather than by presetting an option a caller
    could omit.  Subscribing to the channel itself delivers every change, and the \c change_type
    option filters it explicitly.

    Platform event channels have no such children: they carry no \c ChangeEventHeader, so there is
    nothing to filter on, and setting \c change_type on one is an error rather than a subscription
    that silently delivers nothing.

    Two rules keep a filter from hiding data loss:
    - a **gap event** — one that reports a change Salesforce could not deliver in full — satisfies
      the change type it stands in for, so \c GAP_CREATE reaches a subscriber that asked for
      \c CREATE
    - \c GAP_OVERFLOW, which reports that an unknown number of changes were lost, is delivered
      whatever the filter

    Filtering never affects the replay position: the subscription advances it for every event
    received, so a reconnect neither re-delivers nor skips the events a filter dropped.

    @subsection salesforcepubsubdataprovider_channels Channel Names

    The Pub/Sub API has no list-topics RPC, so the channel list comes from the REST side:
    \c describeGlobal lists Change Data Capture entities (ending in \c ChangeEvent) and platform
    events (ending in \c __e), which is exactly the set of subscribable channels.  Children are
    named by event entity name and the topic name is derived from it:

    |!Child name|!Topic name
    |\c AccountChangeEvent|<tt>/data/AccountChangeEvent</tt>
    |\c Order_Shipped__e|<tt>/event/Order_Shipped__e</tt>

    A custom channel is not listed by \c describeGlobal; subscribe to one by setting the
    \c topic_name option to its topic name.

    @subsection salesforcepubsubdataprovider_classes Provided Classes

    - @ref SalesforcePubSubDataProvider::SalesforcePubSubEventsDataProvider
      "SalesforcePubSubEventsDataProvider": the events container, with one child per channel
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubEventDataProvider
      "SalesforcePubSubEventDataProvider": the observable provider for a single channel
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubClient "SalesforcePubSubClient": the
      \c eventbus.v1.PubSub service client, with the call metadata and the Avro schema cache
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubSubscription
      "SalesforcePubSubSubscription": the subscription state machine — flow control, keepalive,
      replay position, token refresh and reconnection
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubProto "SalesforcePubSubProto": the
      vendored \c pubsub_api.proto as a cached \c ProtobufSchema

    @section salesforcepubsubdataprovider_event_data Event Data

    Each event is delivered as a hash mirroring the envelope the Salesforce streaming APIs use, so
    that mappers written against the older CometD API port with little change:

    @code{.py}
{
    "channel": "/data/AccountChangeEvent",
    "event": {
        "replayId": "AAAAAAAAAAEAAA==",   # base64; store to resume after this event
        "id": "f7a1b0c2-3d4e-4f56-8a90-1b2c3d4e5f60",
        "schemaId": "IeSFsaGYFkarQ8sMLLQrpg",
    },
    "payload": {                          # decoded Avro record
        "ChangeEventHeader": {"entityName": "Account", "changeType": "UPDATE", ...},
        "Name": "Acme Corporation",
    },
}
    @endcode

    @note The Pub/Sub API's replay ID is opaque binary, unlike the CometD API's monotonic integer;
    it is reported base64-encoded and must be treated as an opaque token.

    @section salesforcepubsubdataprovider_examples Examples

    @subsection salesforcepubsubdataprovider_examples_qdp Listening with qdp

    @par Example: list the channels in an org
    @verbatim qdp mysfrest/pubsub list
    @endverbatim

    @par Example: subscribe to account changes
    @verbatim qdp -s mysfrest mysfrest/pubsub/AccountChangeEvent listen
    @endverbatim

    @subsection salesforcepubsubdataprovider_examples_programmatic Programmatic Usage

    @code{.py}
%modern
%requires SalesforcePubSubDataProvider
%requires ConnectionProvider

AbstractConnection conn = get_connection("mysfrest");
AbstractDataProvider events = conn.getDataProvider()
    .getChildProviderEx("pubsub")
    .getChildProviderEx("AccountChangeEvent");

class MyObserver inherits Observer {
    update(string event_id, hash<auto> event) {
        printf("%s: %y\n", event_id, event);
    }
}

cast<Observable>(events).registerObserver(new MyObserver());
cast<DelayedObservable>(events).observersReady();
    @endcode

    Resuming after a restart uses the stored replay ID:

    @code{.py}
SalesforcePubSubClient client(conn);
SalesforcePubSubSubscription subscr = client.subscribe("/data/AccountChangeEvent", {
    "replay_id": stored_replay_id,     # implies the CUSTOM replay preset
    "on_event": sub (hash<auto> event) {
        handle(event);
        stored_replay_id = event.event.replayId;
    },
});
subscr.start();
    @endcode

    @section salesforcepubsubdataprovider_endpoint Endpoint and Authentication

    The Pub/Sub API endpoint is a single global host — @ref SalesforcePubSubDataProvider::PubSubUrl
    "api.pubsub.salesforce.com:7443" — for production orgs and sandboxes alike.  The org is
    identified by call metadata, not by the endpoint:

    |!Metadata header|!Source
    |@ref SalesforcePubSubDataProvider::MetadataAccessToken "accesstoken"|\c SalesforceRestClientIo::getToken()
    |@ref SalesforcePubSubDataProvider::MetadataInstanceUrl "instanceurl"|\c SalesforceRestClientBase::getInstanceUrl()
    |@ref SalesforcePubSubDataProvider::MetadataTenantId "tenantid"|\c SalesforceRestClientBase::getOrgId()

    Only the OAuth2 URLs are org-specific, and the Salesforce REST connection already handles
    those, so nothing here hardcodes a login host.

    The endpoint's TLS certificate is verified against the system CA store.

    @section salesforcepubsubdataprovider_relnotes Release Notes

    @subsection salesforcepubsubdataprovider_v1_0 SalesforcePubSubDataProvider v1.0
    - initial release
    - everything runs on the async socket I/O controller: the \c Subscribe stream, and the REST
      calls behind channel enumeration and Change Data Capture enablement, which are made on the
      \c SalesforceRestClientIo held by \c SalesforceRestDataProviderBase.  A provider built from a
      REST client rather than a connection can therefore subscribe like any other -- the async
      client carries the access token and the instance URL that the Pub/Sub call metadata needs
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubEventsDataProvider
      "SalesforcePubSubEventsDataProvider": events container attached to the Salesforce data
      provider as the \c pubsub child, with channel enumeration from \c describeGlobal
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubEventDataProvider
      "SalesforcePubSubEventDataProvider": observable provider per channel, with the event type
      derived from the channel's Avro schema
    - Change Data Capture change type filtering: the \c change_type option, and a child per change
      type (@ref ChangeTypeChildMap) so that the provider path can carry the filter; gap events
      satisfy the change type they stand in for and \c GAP_OVERFLOW is never filtered out
    - named Change Data Capture actions \c new-record, \c updated-record, \c new-contact and
      \c new-lead, registered against the Salesforce app alongside the generic \c pubsub-event
      action
    - subscriptions are rejected with an actionable error when the org reports that the channel
      cannot be subscribed to, rather than opening a subscription that delivers nothing because
      Change Data Capture was never enabled for the entity; the error names every way of fixing it
    - Change Data Capture can be enabled from here rather than only diagnosed: the
      \c enable-change-data-capture action enables an object once, and the \c enable_cdc
      subscription option enables it on demand.  Neither happens implicitly -- enabling starts a
      72-hour retention stream and changes org configuration, so it is never a side effect of
      listening
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubCdc "SalesforcePubSubCdc": Change Data
      Capture entity selection through the Tooling API's \c PlatformEventChannelMember, with the
      \c CM_ChangeEvents_<Object> developer name convention that Setup itself uses
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubClient "SalesforcePubSubClient": Pub/Sub
      service client with Salesforce call metadata and an Avro schema cache
    - @ref SalesforcePubSubDataProvider::SalesforcePubSubSubscription
      "SalesforcePubSubSubscription": subscription state machine with delivery-driven flow
      control, keepalive handling, replay-ID tracking, token refresh and reconnection with backoff
*/

#! Contains all public definitions in the SalesforcePubSubDataProvider module
public namespace SalesforcePubSubDataProvider {
}
